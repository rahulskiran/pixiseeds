{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

{% style %}
  #shopify-section-{{ section.id }} .m-tornedge {
    --torn-upper: {{ section.settings.upper_background }};
    --torn-paper: {{ section.settings.paper_background }};
    --torn-text: {{ section.settings.text_color }};
    --torn-edge-h: clamp(28px, {{ section.settings.edge_wave_height }}vw, {{ section.settings.edge_wave_height_max }}px);
    --torn-upper-min: {{ section.settings.upper_min_height }}px;
    --torn-paper-pad-y: {{ section.settings.paper_padding_y }}px;
    --torn-paper-pad-x: {{ section.settings.paper_padding_x }}px;
  }
  #shopify-section-{{ section.id }} .m-tornedge.m-tornedge--section-pad {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .m-tornedge.m-tornedge--section-pad {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
{% endstyle %}

<section
  class="m-tornedge m-tornedge--section-pad"
  data-section-id="{{ section.id }}"
  data-section-type="torn-paper-edge"
>
  <div class="m-tornedge__upper" aria-hidden="true"></div>

  <div class="m-tornedge__tear m-tornedge__tear--top" aria-hidden="true">
    {%- if section.settings.tear_image != blank -%}
      <div
        class="m-tornedge__tear-img"
        style="background-image: url('{{ section.settings.tear_image | image_url: width: 2400 }}');"
        role="presentation"
      ></div>
    {%- else -%}
      <svg
        class="m-tornedge__tear-svg"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1440 80"
        preserveAspectRatio="none"
        focusable="false"
        aria-hidden="true"
      >
        {%- comment -%} Organic deckle: jagged top of paper, flat bottom {%- endcomment -%}
        <path
          fill="{{ section.settings.paper_background }}"
          d="M0,80 L1440,80 L1440,42
          C1385,22 1335,58 1275,28 S1185,62 1110,34 S1020,58 945,30 S855,55 780,32 S690,58 600,28 S510,52 420,26 S330,56 240,30 S130,54 0,36 Z"
        />
      </svg>
    {%- endif -%}
  </div>

  <div class="m-tornedge__paper{% if section.settings.content_width == 'narrow' %} m-page-width m-page-width--narrow{% elsif section.settings.content_width == 'page' %} m-page-width{% endif %}">
    {% if section.settings.heading != blank %}
      <{{ heading_tag }} class="m-tornedge__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="m-tornedge__copy rte">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% if section.settings.show_bottom_tear %}
    <div class="m-tornedge__tear m-tornedge__tear--bottom" aria-hidden="true">
      {%- if section.settings.tear_image != blank -%}
        <div
          class="m-tornedge__tear-img m-tornedge__tear-img--flip"
          style="background-image: url('{{ section.settings.tear_image | image_url: width: 2400 }}');"
          role="presentation"
        ></div>
      {%- else -%}
        <svg
          class="m-tornedge__tear-svg"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1440 80"
          preserveAspectRatio="none"
          focusable="false"
          aria-hidden="true"
        >
          <g transform="translate(0,80) scale(1,-1)">
            <path
              fill="{{ section.settings.paper_background }}"
              d="M0,80 L1440,80 L1440,42
              C1385,22 1335,58 1275,28 S1185,62 1110,34 S1020,58 945,30 S855,55 780,32 S690,58 600,28 S510,52 420,26 S330,56 240,30 S130,54 0,36 Z"
            />
          </g>
        </svg>
      {%- endif -%}
    </div>
    <div class="m-tornedge__lower" aria-hidden="true"></div>
  {% endif %}
</section>

{% style %}
  .m-tornedge {
    position: relative;
    background: var(--torn-paper);
    color: var(--torn-text);
  }
  .m-tornedge__upper {
    min-height: var(--torn-upper-min);
    background: var(--torn-upper);
    width: 100%;
  }
  .m-tornedge__lower {
    min-height: var(--torn-upper-min);
    background: var(--torn-upper);
    width: 100%;
  }
  .m-tornedge__tear {
    width: 100%;
    line-height: 0;
    margin-top: -1px;
    position: relative;
    z-index: 1;
  }
  .m-tornedge__tear--bottom {
    margin-top: 0;
    margin-bottom: -1px;
  }
  .m-tornedge__tear-svg {
    display: block;
    width: 100%;
    height: var(--torn-edge-h);
    filter: drop-shadow(0 -1px 0 rgba(0, 0, 0, 0.04));
  }
  .m-tornedge__tear--bottom .m-tornedge__tear-svg {
    filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.04));
  }
  .m-tornedge__tear-img {
    display: block;
    width: 100%;
    height: var(--torn-edge-h);
    background-size: 100% 100%;
    background-position: center top;
    background-repeat: no-repeat;
    background-color: var(--torn-paper);
  }
  .m-tornedge__tear-img--flip {
    transform: scaleY(-1);
  }
  .m-tornedge__paper {
    position: relative;
    z-index: 0;
    padding: var(--torn-paper-pad-y) var(--torn-paper-pad-x);
    margin: 0 auto;
    max-width: 100%;
    background-image: radial-gradient(rgba(0, 0, 0, 0.03) 0.5px, transparent 1.2px);
    background-size: 4px 4px;
  }
  .m-tornedge__paper.m-page-width--narrow {
    max-width: 720px;
  }
  .m-tornedge__heading {
    font-family: var(--font-stack-header);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: var(--torn-text);
    text-align: {{ section.settings.text_alignment }};
  }
  .m-tornedge__copy {
    font-size: 1rem;
    line-height: 1.65;
    text-align: {{ section.settings.text_alignment }};
  }
  .m-tornedge__copy p:last-child {
    margin-bottom: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Torn paper edge",
  "tag": "section",
  "class": "m-section-torn-paper",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Dark band on top, fibrous torn edge, then paper-colored area (like a ripped sheet). Upload a custom tear image for a photo-real edge, or use the built-in SVG."
    },
    {
      "type": "color",
      "id": "upper_background",
      "label": "Upper band (above tear)",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "upper_min_height",
      "label": "Upper band minimum height",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "paper_background",
      "label": "Paper fill",
      "default": "#f7f5f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "image_picker",
      "id": "tear_image",
      "label": "Custom tear edge image (optional)",
      "info": "Wide PNG/SVG with transparent top and paper below the rip. Replaces SVG when set."
    },
    {
      "type": "range",
      "id": "edge_wave_height",
      "label": "Tear wave height (vw)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "info": "Responsive height of the edge strip; capped by max height."
    },
    {
      "type": "range",
      "id": "edge_wave_height_max",
      "label": "Tear max height",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "show_bottom_tear",
      "label": "Mirror tear on bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Content (on paper)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "page",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "range",
      "id": "paper_padding_x",
      "label": "Paper horizontal padding",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "paper_padding_y",
      "label": "Paper vertical padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Torn paper edge"
    }
  ]
}
{% endschema %}
