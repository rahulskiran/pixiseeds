{% liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif
%}

<style>
  .video-card-section {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .video-card-section__container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .video-card-section__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 32px;
  }

  .video-card-section__heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .video-card-section__subheading {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.5;
  }

  .video-card-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
  }

  .video-card {
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .video-card__media {
    position: relative;
    aspect-ratio: {{ section.settings.video_aspect_ratio }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .video-card__media img,
  .video-card__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-card__play-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    background-color: {{ section.settings.play_button_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease;
    border: none;
    padding: 0;
  }

  .video-card__play-btn:hover {
    transform: scale(1.1);
  }

  .video-card__play-btn svg {
    width: 20px;
    height: 20px;
    fill: {{ section.settings.play_button_icon_color }};
    margin-left: 3px;
  }

  .video-card__info {
    padding: 12px 16px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .video-card__details {
    flex: 1;
    min-width: 0;
  }

  .video-card__title {
    color: {{ section.settings.card_title_color }};
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .video-card__price {
    color: {{ section.settings.card_price_color }};
    font-size: 13px;
    font-weight: 600;
  }

  .video-card__quick-add {
    flex-shrink: 0;
  }

  .video-card__quick-add-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: {{ section.settings.quick_add_background }};
    color: {{ section.settings.quick_add_text_color }};
    font-size: 12px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 16px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .video-card__quick-add-btn:hover {
    opacity: 0.9;
  }

  .video-card__quick-add-btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .video-card-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media (max-width: 768px) {
    .video-card-section__container {
      padding: 0 16px;
    }

    .video-card-section__heading {
      font-size: {{ section.settings.heading_size | times: 0.85 }}px;
    }

    .video-card-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.card_gap | times: 0.8 }}px;
    }

    .video-card__info {
      padding: 10px 12px 12px;
    }

    .video-card__quick-add-btn {
      padding: 6px 10px;
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .video-card__title {
      font-size: 12px;
    }

    .video-card__price {
      font-size: 12px;
    }

    .video-card__play-btn {
      width: 40px;
      height: 40px;
    }

    .video-card__play-btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<section class="video-card-section" data-section-id="{{ section.id }}">
  <div class="video-card-section__container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="video-card-section__header{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        {% if section.settings.heading != blank %}
          <h2 class="video-card-section__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="video-card-section__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="video-card-grid{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      {% for block in section.blocks %}
        <div class="video-card" {{ block.shopify_attributes }}>
          <div class="video-card__media">
            {% if block.settings.video_url != blank %}
              {% if block.settings.cover_image != blank %}
                <img src="{{ block.settings.cover_image | img_url: '800x' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% endif %}
              <button class="video-card__play-btn" type="button" data-video-url="{{ block.settings.video_url }}" aria-label="Play video">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            {% elsif block.settings.cover_image != blank %}
              <img src="{{ block.settings.cover_image | img_url: '800x' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>

          <div class="video-card__info">
            <div class="video-card__details">
              {% if block.settings.title != blank %}
                <div class="video-card__title">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.price != blank %}
                <div class="video-card__price">{{ block.settings.price }}</div>
              {% endif %}
            </div>

            {% if block.settings.product != blank %}
              <div class="video-card__quick-add">
                <a href="{{ block.settings.product.url }}" class="video-card__quick-add-btn">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 7V5C8 3.34315 9.34315 2 11 2H13C14.6569 2 16 3.34315 16 5V7M3 7H21V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 12V16M10 14H14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {{ block.settings.quick_add_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const playButtons = document.querySelectorAll('.video-card__play-btn');
  playButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      const videoUrl = this.getAttribute('data-video-url');
      if (videoUrl) {
        window.open(videoUrl, '_blank');
      }
    });
  });
});
</script>

