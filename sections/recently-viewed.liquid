{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign heading = section.settings.heading
  assign limit = section.settings.products_to_show | default: 8

  assign cols_desktop = section.settings.products_per_row | default: 4
  assign cols_laptop = cols_desktop | at_most: 4
  assign cols_tablet = cols_desktop | at_most: 3

  assign show_vendor = section.settings.show_vendor
  assign card_style = settings.pcard_layout
  assign image_ratio = settings.pcard_image_ratio

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif
-%}
<section
  class="m-section m-section--padding m-color-{{ section.settings.color_scheme }} m-viewed{% if request.design_mode %} m:hidden{% endif %}"
  data-product-card-style="{{ card_style }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --viewed-gap: {{ section.settings.column_gap }}px;
    --viewed-gap-mobile: {{ section.settings.column_gap_mobile }}px;
  "
>
  <div class="m-page-width">
    <recently-viewed-products
      class="m-viewed__body m:block"
      data-url="{{ routes.search_url }}?section_id={{ section.id }}&type=product&q="
      data-product-to-show="{{ limit }}"
      data-enable-slider="true"
      data-items="{{ cols_desktop }}"
      data-laptop-items="{{ cols_laptop }}"
      data-tablet-items="{{ cols_tablet }}"
      data-mobile-items="2"
      data-show-pagination="false"
      data-show-navigation="true"
      data-pagination-type="fraction"
      data-mobile-layout="slider"
      {% if request.page_type == 'product' %}data-product-id="{{ product.id }}"{% endif %}
    >
      {%- if request.page_type == 'search' and search.performed and search.results_count > 0 -%}
        {%- if heading != blank -%}
          <div class="m-viewed__head m:flex m:items-center m:justify-between">
            <h2 class="m-viewed__title h3{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">{{ heading }}</h2>
          </div>
        {%- endif -%}
        <div class="m-mixed-layout m-mixed-layout--mobile-grid m-mixed-layout--mobile-scroll">
          <div class="m-mixed-layout__wrapper swiper swiper--equal-height">
            <div class="m-mixed-layout__inner m:grid md:m:grid-{{ cols_tablet }}-cols lg:m:grid-{{ cols_laptop }}-cols xl:m:grid-{{ cols_desktop }}-cols swiper-wrapper">
              {%- liquid
                assign parsed_terms = search.terms | split: ' OR '
              -%}
              {%- for parsed_term in parsed_terms -%}
                {%- assign wanted_id = parsed_term | split: 'id:' | last | times: 1 -%}
                {%- for found_product in search.results -%}
                  {%- if found_product.id == wanted_id -%}
                    <div class="m:column swiper-slide">
                      {% liquid
                        case card_style
                          when '1'
                            render 'product-card-1', product: found_product, image_ratio: image_ratio, show_vendor: show_vendor, index: forloop.index, animated: animated, animation_effect: animation_effect
                          when '2'
                            render 'product-card-2', product: found_product, image_ratio: image_ratio, show_vendor: show_vendor, index: forloop.index, animated: animated, animation_effect: animation_effect
                          when '3'
                            render 'product-card-3', product: found_product, image_ratio: image_ratio, show_vendor: show_vendor, index: forloop.index, animated: animated, animation_effect: animation_effect
                          else
                            render 'product-card-1', product: found_product, image_ratio: image_ratio, show_vendor: show_vendor, index: forloop.index, animated: animated, animation_effect: animation_effect
                        endcase
                      %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
          {% render 'slider-controls',
            container: 'm-page-width',
            show_nav: true,
            show_pagination: false,
            navigation_position: 'outside',
            pagination_type: 'fraction',
            nav_class: 'm:opacity-0'
          %}
        </div>
      {%- endif -%}
    </recently-viewed-products>
  </div>
</section>

<style>
  .m-viewed__head {
    margin-bottom: 24px;
  }
  .m-viewed__title {
    margin: 0;
  }
  @media screen and (max-width: 767px) {
    .m-viewed__head {
      margin-bottom: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Recently viewed (new)",
  "disabled_on": {
    "groups": ["header", "aside"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap (desktop)",
      "min": 0,
      "max": 50,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "Gap (mobile)",
      "min": 0,
      "max": 50,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit global setting" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-in-up", "label": "Fade in up" },
        { "value": "fade-in-left", "label": "Fade in left" },
        { "value": "fade-in-right", "label": "Fade in right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recently viewed (new)"
    }
  ]
}
{% endschema %}
