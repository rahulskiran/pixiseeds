{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign tab_count = tab_blocks.size
-%}

{% style %}
  #shopify-section-{{ section.id }} .m-growtips {
    --grow-bg: {{ section.settings.soil_background }};
    --grow-accent: {{ section.settings.accent_script_color }};
    --grow-title: {{ section.settings.main_title_color }};
    --grow-tab-active-bg: {{ section.settings.tab_active_background }};
    --grow-tab-active-text: {{ section.settings.tab_active_text }};
    --grow-tab-inactive-desktop: {{ section.settings.tab_inactive_desktop }};
    --grow-tab-inactive-mobile: {{ section.settings.tab_inactive_mobile }};
    --grow-card-bg: {{ section.settings.card_background }};
    --grow-card-radius: {{ section.settings.card_radius }}px;
    --grow-panel-bar: {{ section.settings.panel_bar_background }};
    --grow-card-pad: {{ section.settings.card_padding }}px;
    --grow-grid-gap: {{ section.settings.grid_gap }}px;
    --grow-img-radius: {{ section.settings.image_radius }}px;
    --grow-text: {{ section.settings.body_text_color }};
    --grow-subtext: {{ section.settings.subtext_color }};
    --grow-mobile-rule: {{ section.settings.mobile_divider_color }};
    --grow-mobile-content: {{ section.settings.mobile_answer_text }};
    --grow-mobile-sub: {{ section.settings.mobile_answer_muted }};
  }
  #shopify-section-{{ section.id }} .m-growtips.m-growtips--padding {
    padding-top: 0;
    padding-bottom: 0;
  }
  #shopify-section-{{ section.id }} .m-growtips__inner {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .m-growtips__inner {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
  #shopify-section-{{ section.id }} .m-growtips__panel {
    display: none;
  }
  {% for block in tab_blocks %}
  #shopify-section-{{ section.id }} #growtab-{{ section.id }}-{{ block.id }}:checked ~ .m-growtabs__shell .m-growtabs__panels .m-growtabs__panel:nth-child({{ forloop.index }}) {
    display: grid;
  }
  #shopify-section-{{ section.id }} #growtab-{{ section.id }}-{{ block.id }}:checked ~ .m-growtabs__shell .m-growtabs__nav label[for="growtab-{{ section.id }}-{{ block.id }}"] {
    background: var(--grow-tab-active-bg);
    color: var(--grow-tab-active-text);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
  }
  {% endfor %}
{% endstyle %}

<section
  class="m-growtips m-growtips--padding"
  id="GrowingTips-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="growing-tips-guides"
>
  <div class="m-page-width m-growtips__inner">
    <header class="m-growtips__head">
      {% if section.settings.eyebrow != blank %}
        <p class="m-growtips__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <{{ heading_tag }} class="m-growtips__title">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {% endif %}
    </header>

    {%- if tab_count > 0 -%}
      <div class="m-growtabs m-growtabs--desktop">
        {% for block in tab_blocks %}
          <input
            type="radio"
            name="growtabs-{{ section.id }}"
            id="growtab-{{ section.id }}-{{ block.id }}"
            class="m-growtabs__state visually-hidden"
            tabindex="-1"
            {% if forloop.first %}
              checked
            {% endif %}
          >
        {% endfor %}

        <div class="m-growtabs__shell m-growtips__card">
          <div class="m-growtabs__nav" role="tablist">
            {% for block in tab_blocks %}
              <label
                class="m-growtabs__navlabel"
                for="growtab-{{ section.id }}-{{ block.id }}"
                role="tab"
              >
                {{- block.settings.tab_title | escape -}}
              </label>
            {% endfor %}
          </div>

          <div class="m-growtabs__panels">
            {% for block in tab_blocks %}
              <div
                class="m-growtabs__panel m-growtips__panel"
                role="tabpanel"
                {{ block.shopify_attributes }}
              >
                <div class="m-growtips__panel-grid">
                  {% if block.settings.image != blank and block.settings.show_image %}
                    <div class="m-growtips__panel-media">
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          class: 'm-growtips__panel-img',
                          widths: '375, 550, 720, 900',
                          sizes: '(min-width: 990px) 42vw, 100vw'
                      }}
                    </div>
                  {% endif %}
                  <div class="m-growtips__panel-copy{% unless block.settings.image != blank and block.settings.show_image %} m-growtips__panel-copy--solo{% endunless %}">
                    {% assign bar_title = block.settings.panel_heading | default: block.settings.tab_title %}
                    {% if bar_title != blank %}
                      <div class="m-growtips__panel-bar">
                        <span class="m-growtips__panel-bar-text">{{ bar_title | escape }}</span>
                      </div>
                    {% endif %}
                    {% if block.settings.scientific_name != blank %}
                      <p class="m-growtips__sci">{{ block.settings.scientific_name | escape }}</p>
                    {% endif %}
                    {% if block.settings.content != blank %}
                      <div class="m-growtips__rte rte">{{ block.settings.content }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="m-growtips__mobile-acc">
        {% for block in tab_blocks %}
          <collapsible-tab
            class="m-collapsible m-growtips__acc-item no-js-hidden"
            data-block-id="grow-collapsible-{{ block.id }}"
            {% if forloop.first and section.settings.open_first_mobile %}
              open="true"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <h3 class="m-collapsible--button m-growtips__acc-trigger" data-trigger>
              <span class="m-growtips__acc-icon" aria-hidden="true">+</span>
              <span class="m-growtips__acc-title">{{ block.settings.tab_title | escape }}</span>
            </h3>
            <div class="m-collapsible--content" data-content hidden>
              <div class="m-collapsible--content__inner m-growtips__acc-inner">
                <div class="m-growtips__panel-grid m-growtips__panel-grid--stack">
                  {% if block.settings.image != blank and block.settings.show_image %}
                    <div class="m-growtips__panel-media">
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          class: 'm-growtips__panel-img',
                          widths: '375, 550, 800',
                          sizes: '100vw'
                      }}
                    </div>
                  {% endif %}
                  <div class="m-growtips__panel-copy{% unless block.settings.image != blank and block.settings.show_image %} m-growtips__panel-copy--solo{% endunless %}">
                    {% assign bar_title = block.settings.panel_heading | default: block.settings.tab_title %}
                    {% if bar_title != blank %}
                      <div class="m-growtips__panel-bar m-growtips__panel-bar--mobile">
                        <span class="m-growtips__panel-bar-text">{{ bar_title | escape }}</span>
                      </div>
                    {% endif %}
                    {% if block.settings.scientific_name != blank %}
                      <p class="m-growtips__sci">{{ block.settings.scientific_name | escape }}</p>
                    {% endif %}
                    {% if block.settings.content != blank %}
                      <div class="m-growtips__rte rte">{{ block.settings.content }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </collapsible-tab>
        {% endfor %}
      </div>
    {%- else -%}
      {% if request.design_mode %}
        <div class="m-growtips__card m-growtips__empty">
          <p>Add Tab blocks to build this section.</p>
        </div>
      {% endif %}
    {%- endif -%}
  </div>
</section>

{% style %}
  .m-growtips {
    position: relative;
    background: var(--grow-bg);
    color: var(--grow-title);
  }
  .m-growtips__inner {
    position: relative;
    z-index: 1;
  }
  .m-growtips__head {
    text-align: center;
    padding: 0 1rem 1rem;
    max-width: 52rem;
    margin: 0 auto;
  }
  @media screen and (min-width: 750px) {
    .m-growtips__head {
      padding-bottom: 1.25rem;
    }
  }
  .m-growtips__eyebrow {
    font-family: var(--font-stack-header);
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.02em;
    color: var(--grow-accent);
    margin: 0 0 0.5rem;
  }
  .m-growtips__title {
    font-family: var(--font-stack-header);
    font-size: clamp(1.65rem, 4vw, 2.35rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--grow-title);
    margin: 0;
  }
  .m-growtips__card {
    background: var(--grow-card-bg);
    border-radius: var(--grow-card-radius);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.18);
    padding: var(--grow-card-pad);
    max-width: 1200px;
    margin: 0 auto;
  }
  .m-growtabs {
    position: relative;
  }
  .m-growtabs__state {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }
  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }
  .m-growtabs__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 0.75rem;
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }
  .m-growtabs__navlabel {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--grow-tab-inactive-desktop);
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .m-growtabs__navlabel:hover {
    color: var(--grow-text);
    border-color: rgba(0, 0, 0, 0.06);
  }
  .m-growtabs__panel {
    grid-template-columns: 1fr 1.1fr;
    gap: var(--grow-grid-gap);
    align-items: start;
    animation: m-growtips-fade 0.35s ease;
  }
  @keyframes m-growtips-fade {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }
  @media screen and (max-width: 989px) {
    .m-growtabs__panel {
      grid-template-columns: 1fr;
    }
  }
  .m-growtips__panel-grid {
    display: contents;
  }
  .m-growtips__panel-media {
    min-width: 0;
  }
  .m-growtips__panel-img {
    width: 100%;
    height: auto;
    border-radius: var(--grow-img-radius);
    vertical-align: middle;
    object-fit: cover;
  }
  .m-growtips__panel-copy {
    min-width: 0;
    color: var(--grow-text);
  }
  .m-growtips__panel-copy--solo {
    grid-column: 1 / -1;
  }
  .m-growtips__panel-bar {
    background: var(--grow-panel-bar);
    padding: 0.65rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }
  .m-growtips__panel-bar-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--grow-text);
  }
  .m-growtips__sci {
    font-size: 0.95rem;
    font-weight: 700;
    font-style: italic;
    margin: 0 0 1rem;
    color: var(--grow-subtext);
  }
  .m-growtips__rte {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--grow-text);
  }
  .m-growtips__rte p {
    margin: 0 0 0.85em;
  }
  .m-growtips__rte p:last-child {
    margin-bottom: 0;
  }
  .m-growtips__rte ul,
  .m-growtips__rte ol {
    margin: 0.5em 0 0.85em;
    padding-left: 1.15em;
  }
  .m-growtips__rte li + li {
    margin-top: 0.35em;
  }
  .m-growtips__rte strong {
    font-weight: 700;
  }
  .m-growtips__empty {
    text-align: center;
    padding: 2rem;
    color: #333;
  }
  .m-growtabs--desktop {
    display: none;
  }
  .m-growtips__mobile-acc {
    display: block;
    margin-top: 0.5rem;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
    padding: 0 0.5rem;
  }
  .m-growtips__acc-item {
    display: block;
    border-top: 1px solid var(--grow-mobile-rule);
    margin: 0;
  }
  .m-growtips__acc-item:last-child {
    border-bottom: 1px solid var(--grow-mobile-rule);
  }
  .m-growtips__acc-trigger {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    margin: 0;
    padding: 1rem 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--grow-tab-inactive-mobile) !important;
    background: transparent !important;
    border: none !important;
    border-bottom: none !important;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-stack-body);
    box-shadow: none !important;
  }
  .m-growtips__acc-icon {
    flex-shrink: 0;
    width: 1.35rem;
    text-align: center;
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .m-growtips__acc-item.m-collapsible[open='true'] .m-growtips__acc-icon {
    transform: rotate(45deg);
  }
  .m-growtips__acc-title {
    flex: 1;
  }
  .m-growtips__acc-inner {
    padding-bottom: 1.25rem;
    padding-top: 0.15rem;
  }
  .m-growtips__panel-grid--stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .m-growtips__panel-bar--mobile {
    margin-top: 0;
  }
  .m-growtips__mobile-acc .m-growtips__panel-bar-text {
    color: var(--grow-text);
  }
  .m-growtips__mobile-acc .m-growtips__sci {
    color: var(--grow-mobile-sub);
  }
  .m-growtips__mobile-acc .m-growtips__rte {
    color: var(--grow-mobile-content);
  }
  .m-growtips__mobile-acc .m-growtips__rte strong {
    color: var(--grow-mobile-content);
  }
  @media screen and (min-width: 990px) {
    .m-growtabs--desktop {
      display: block;
    }
    .m-growtips__mobile-acc {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Growing tips & guides",
  "tag": "section",
  "class": "m-section-growing-tips",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "color",
      "id": "soil_background",
      "label": "Soil / charcoal background",
      "default": "#3b3631"
    },
    {
      "type": "color",
      "id": "accent_script_color",
      "label": "Eyebrow / script accent",
      "default": "#e5c05b"
    },
    {
      "type": "color",
      "id": "main_title_color",
      "label": "Main heading color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "color",
      "id": "tab_active_background",
      "label": "Active tab (pill) background",
      "default": "#2d4a2d"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Active tab text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_inactive_desktop",
      "label": "Inactive tab text (on white card)",
      "default": "#3d3d3d"
    },
    {
      "type": "color",
      "id": "tab_inactive_mobile",
      "label": "Mobile accordion text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "open_first_mobile",
      "label": "Open first tab on mobile",
      "default": true
    },
    {
      "type": "color",
      "id": "mobile_divider_color",
      "label": "Mobile accordion dividers",
      "default": "#8a847c"
    },
    {
      "type": "color",
      "id": "mobile_answer_text",
      "label": "Mobile answer body text",
      "default": "#f0ebe3"
    },
    {
      "type": "color",
      "id": "mobile_answer_muted",
      "label": "Mobile scientific name",
      "default": "#d4cfc4"
    },
    {
      "type": "header",
      "content": "Content card (desktop)"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Image & text gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "panel_bar_background",
      "label": "Panel title bar",
      "default": "#f0ebe3"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body text",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Scientific name",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get the Most From This Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Growing Tips & Guides"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab label",
          "default": "Get Started"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "Show image",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "panel_heading",
          "label": "Panel title bar (optional)",
          "info": "Defaults to tab label if empty."
        },
        {
          "type": "text",
          "id": "scientific_name",
          "label": "Scientific name",
          "default": "Daucus carota var. sativus"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add growing instructions, culture notes, harvesting tips, or FAQs.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Growing tips & guides",
      "blocks": [
        { "type": "tab", "settings": { "tab_title": "Get Started" } },
        { "type": "tab", "settings": { "tab_title": "Quick Culture" } },
        { "type": "tab", "settings": { "tab_title": "Growing Info" } },
        { "type": "tab", "settings": { "tab_title": "Harvesting" } },
        { "type": "tab", "settings": { "tab_title": "Shipping Info" } },
        { "type": "tab", "settings": { "tab_title": "FAQs" } }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
