          "max": 280,
          "step": 4,
          "default": 220,
          "unit": "px",
          "label": "Max card width (desktop)",
          "info": "Caps how wide each card can grow in a row. Lower this to shrink the whole block."
        },
        {
          "type": "range",
          "id": "variant_card_desktop_media_height",
          "min": 56,
          "max": 280,
          "step": 4,
          "default": 280,
          "unit": "px",
          "label": "Max image height (768px+)",
          "info": "At the maximum value, height is not limited. Lower for shorter cards on tablet and desktop."
        },
        {
          "type": "range",
          "id": "variant_card_inner_padding",
          "min": 4,
          "max": 20,
          "step": 2,
          "default": 12,
          "unit": "px",
          "label": "Padding inside each card",
          "info": "Reduces inner padding for a tighter look."
        },
        {
          "type": "range",
          "id": "variant_card_radius",
          "min": 0,
          "max": 28,
          "step": 2,
          "default": 14,
          "unit": "px",
          "label": "Card corner radius"
        },
        {
          "type": "range",
          "id": "variant_card_border_width",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1,
          "unit": "px",
          "label": "Default border thickness"
        },
        {
          "type": "range",
          "id": "variant_card_selected_border_width",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3,
          "unit": "px",
          "label": "Selected card border thickness"
        },
        {
          "type": "color",
          "id": "variant_card_border_color",
          "label": "Default border color",
          "default": "#d1d5db"
        },
        {
          "type": "color",
          "id": "variant_card_selected_border_color",
          "label": "Selected border color",
          "default": "#1f5f3f"
        },
        {
          "type": "color",
          "id": "variant_card_price_color",
          "label": "Price color",
          "default": "#1f5f3f"
        },
        {
