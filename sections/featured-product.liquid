        },
        {
          "type": "range",
          "id": "variant_card_min_width",
          "min": 72,
          "max": 200,
          "step": 4,
          "default": 132,
          "unit": "px",
          "label": "Minimum card width"
        },
        {
          "type": "range",
          "id": "variant_card_gap",
          "min": 4,
          "max": 28,
          "step": 2,
          "default": 12,
          "unit": "px",
          "label": "Gap between cards"
        },
        {
          "type": "header",
          "content": "Desktop & tablet size"
        },
        {
          "type": "paragraph",
          "content": "These settings mainly affect layout from the tablet breakpoint up (768px+). Lower values make the variant card row more compact on wide screens."
        },
        {
          "type": "range",
