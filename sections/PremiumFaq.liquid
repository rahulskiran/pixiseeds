{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom

  assign section_animation = section.settings.animations | default: 'inherit'
  assign animation_effect = settings.animations
  if section_animation != 'inherit'
    assign animation_effect = section_animation
  endif
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif
  if request.design_mode
    assign animated = false
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h2'

  if section.settings.enable_gradient
    assign section_bg = 'linear-gradient(180deg, ' | append: section.settings.gradient_color_1 | append: ' 0%, ' | append: section.settings.gradient_color_2 | append: ' 100%)'
  else
    assign section_bg = section.settings.background_color
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .m-faq {
    --faq-radius: {{ section.settings.card_radius }}px;
    --faq-pad-y: {{ section.settings.card_padding_y }}px;
    --faq-pad-x: {{ section.settings.card_padding_x }}px;
    --faq-gap: {{ section.settings.item_gap }}px;
    --faq-title-m: {{ section.settings.title_size_mobile }}px;
    --faq-title-d: {{ section.settings.title_size_desktop }}px;
    --faq-sub: {{ section.settings.intro_size }}px;
    --faq-q: {{ section.settings.question_size }}px;
    --faq-a: {{ section.settings.answer_size }}px;
    --faq-header-max: {{ section.settings.header_max_width }}px;
    --faq-tabs-max: {{ section.settings.content_max_width }}px;
    --faq-tab-bg: {{ section.settings.tab_background }};
    --faq-tab-border: {{ section.settings.tab_border_color }};
    --faq-tab-border-hover: {{ section.settings.tab_border_hover_color }};
    --faq-tab-hover: {{ section.settings.tab_hover_background }};
    --faq-tab-open: {{ section.settings.tab_open_background }};
    --faq-q-color: {{ section.settings.tab_question_color }};
    --faq-a-color: {{ section.settings.tab_answer_color }};
    --faq-answer-bg: {{ section.settings.answer_panel_background }};
    --faq-icon-bg: {{ section.settings.icon_background }};
    --faq-icon-color: {{ section.settings.icon_color }};
    --faq-num-color: {{ section.settings.number_color }};
    background: {{ section_bg }};
  }
  #shopify-section-{{ section.id }} .m-faq.m-section--padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .m-faq.m-section--padding {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
{% endstyle %}

<section
  class="m-section m-faq m-section--padding m-color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="faq"
  style="--section-padding-top: {{ pt }}px; --section-padding-bottom: {{ pb }}px;"
>
  <div class="m-page-width">
    <div class="m-faq__wrap{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-faq__header m:text-center">
        {% if section.settings.eyebrow != blank %}
          <p class="m-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <{{ heading_tag }} class="m-faq__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="m-faq__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <p class="m-faq__cta-wrap">
            <a class="m-faq__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
          </p>
        {% endif %}
      </div>

      <div class="m-faq__list">
        {% assign faq_num = 0 %}
        {% for block in section.blocks %}
          {% if block.type != 'item' %}
            {% continue %}
          {% endif %}
          {% if block.settings.question == blank or block.settings.answer == blank %}
            {% continue %}
          {% endif %}
          {% assign faq_num = faq_num | plus: 1 %}

          <collapsible-tab
            class="m-collapsible m-faq__item no-js-hidden"
            data-block-id="collapsible-tab-{{ block.id }}"
            {% if block.settings.default_open %}
              open="true"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <h3 class="m-collapsible--button m-faq__trigger" data-trigger>
              <span class="m-faq__trigger-main">
                {% if section.settings.show_numbers %}
                  <span class="m-faq__index" aria-hidden="true">{% if faq_num < 10 %}0{% endif %}{{ faq_num }}</span>
                {% endif %}
                <span class="m-faq__question">{{ block.settings.question | escape }}</span>
              </span>
              <span class="m-collapsible--icon m-faq__chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M13.5306 6.53073L8.5306 11.5307C8.46092 11.6007 8.37813 11.6561 8.28696 11.694C8.1958 11.7318 8.09806 11.7513 7.99935 11.7513C7.90064 11.7513 7.8029 11.7318 7.71173 11.694C7.62057 11.6561 7.53778 11.6007 7.4681 11.5307L2.4681 6.53073C2.3272 6.38984 2.24805 6.19874 2.24805 5.99948C2.24805 5.80023 2.3272 5.60913 2.4681 5.46823C2.60899 5.32734 2.80009 5.24818 2.99935 5.24818C3.19861 5.24818 3.3897 5.32734 3.5306 5.46823L7.99997 9.93761L12.4693 5.46761C12.6102 5.32671 12.8013 5.24756 13.0006 5.24756C13.1999 5.24756 13.391 5.32671 13.5318 5.46761C13.6727 5.60851 13.7519 5.7996 13.7519 5.99886C13.7519 6.19812 13.6727 6.38921 13.5318 6.53011L13.5306 6.53073Z" fill="currentColor"/>
                </svg>
              </span>
            </h3>
            <div class="m-collapsible--content" data-content hidden>
              <div class="m-collapsible--content__inner m-faq__answer rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </collapsible-tab>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  .m-faq__wrap {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
  .m-faq__header {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    max-width: var(--faq-header-max);
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
  .m-faq__eyebrow {
    font-family: var(--font-stack-body);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.55);
    margin: 0 0 0.5rem;
  }
  @media screen and (min-width: 750px) {
    .m-faq__eyebrow {
      font-size: 0.75rem;
    }
  }
  .m-faq__heading {
    font-family: var(--font-stack-header);
    font-size: var(--faq-title-m);
    line-height: 1.2;
    font-weight: var(--font-weight-header);
    margin: 0 0 0.75rem;
    color: rgb(var(--color-foreground));
  }
  @media screen and (min-width: 750px) {
    .m-faq__heading {
      font-size: var(--faq-title-d);
    }
  }
  .m-faq__intro {
    font-size: var(--faq-sub);
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.72);
    margin: 0;
  }
  .m-faq__cta-wrap {
    margin: 1rem 0 0;
  }
  .m-faq__cta {
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .m-faq__cta:hover {
    opacity: 0.8;
  }
  .m-faq__list {
    width: 100%;
    max-width: var(--faq-tabs-max);
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: var(--faq-gap);
  }
  .m-faq__item {
    margin: 0;
    border-radius: var(--faq-radius);
    background: var(--faq-tab-bg);
    border: 1px solid var(--faq-tab-border);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    overflow: hidden;
  }
  .m-faq__item:hover {
    background: var(--faq-tab-hover);
    border-color: var(--faq-tab-border-hover);
  }
  .m-faq__item.m-collapsible[open='true'] {
    background: var(--faq-tab-open);
    border-color: var(--faq-tab-border-hover);
    box-shadow: 0 4px 24px rgba(var(--color-foreground), 0.06);
  }
  .m-faq__item .m-faq__trigger {
    padding: var(--faq-pad-y) var(--faq-pad-x);
    margin: 0;
    border-bottom: none;
    align-items: flex-start;
    gap: 0.75rem;
    text-align: left;
    font-size: var(--faq-q);
    line-height: 1.4;
    font-weight: 600;
    color: var(--faq-q-color);
    background: transparent;
  }
  .m-faq__item.m-collapsible[open='true'] .m-faq__trigger {
    padding-bottom: calc(var(--faq-pad-y) * 0.55);
  }
  .m-faq__trigger-main {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    flex: 1;
    min-width: 0;
  }
  .m-faq__index {
    flex: 0 0 auto;
    font-family: var(--font-stack-body);
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--faq-num-color);
    padding-top: 0.15em;
  }
  .m-faq__question {
    flex: 1;
    min-width: 0;
    word-break: break-word;
  }
  .m-faq__chevron {
    flex-shrink: 0;
    margin-top: 0.1em;
    width: 2.25rem;
    height: 2.25rem;
    min-width: 2.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--faq-icon-bg);
    color: var(--faq-icon-color);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .m-faq__item:hover .m-faq__chevron,
  .m-faq__item.m-collapsible[open='true'] .m-faq__chevron {
    background: var(--faq-icon-bg);
    color: var(--faq-icon-color);
    opacity: 1;
  }
  .m-faq__item .m-faq__answer {
    font-size: var(--faq-a);
    line-height: 1.65;
    color: var(--faq-a-color);
    padding: 0 var(--faq-pad-x) var(--faq-pad-y);
    margin: 0;
    background: var(--faq-answer-bg);
    border-top: 1px solid var(--faq-tab-border);
  }
  .m-faq__item .m-collapsible--content__inner {
    padding: 0;
  }
  .m-faq__item .m-faq__answer > *:first-child {
    margin-top: calc(var(--faq-pad-y) * 0.85);
  }
  .m-faq__item .m-faq__answer > *:last-child {
    margin-bottom: 0;
  }
  @media screen and (max-width: 749px) {
    .m-faq__item .m-faq__trigger {
      padding: calc(var(--faq-pad-y) * 0.85) calc(var(--faq-pad-x) * 0.8);
      font-size: calc(var(--faq-q) * 0.96);
      gap: 0.5rem;
    }
    .m-faq__item .m-faq__answer {
      padding-left: calc(var(--faq-pad-x) * 0.8);
      padding-right: calc(var(--faq-pad-x) * 0.8);
      padding-bottom: calc(var(--faq-pad-y) * 0.85);
    }
    .m-faq__chevron {
      width: 2rem;
      height: 2rem;
      min-width: 2rem;
    }
  }
  @media screen and (max-width: 389px) {
    .m-faq__item .m-faq__trigger {
      flex-wrap: wrap;
    }
    .m-faq__chevron {
      margin-left: auto;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "m-section-faq",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f7f5f0"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Use gradient background",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient top",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient bottom",
      "default": "#ebe6dc"
    },
    {
      "type": "header",
      "content": "FAQ tab colors"
    },
    {
      "type": "paragraph",
      "content": "Customize each accordion row: background, borders, text, answer panel, and icon."
    },
    {
      "type": "color",
      "id": "tab_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Border",
      "default": "#e8e4dc"
    },
    {
      "type": "color",
      "id": "tab_border_hover_color",
      "label": "Border (hover & open)",
      "default": "#d4cfc4"
    },
    {
      "type": "color",
      "id": "tab_hover_background",
      "label": "Background (hover)",
      "default": "#faf9f7"
    },
    {
      "type": "color",
      "id": "tab_open_background",
      "label": "Background (open)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_question_color",
      "label": "Question text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "tab_answer_color",
      "label": "Answer text",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "answer_panel_background",
      "label": "Answer panel background",
      "default": "#fbfaf8"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Index numbers",
      "default": "#6b7c6b"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Chevron circle background",
      "default": "#f0ede6"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Chevron icon",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers",
      "default": false
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Heading size (mobile)",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Heading size (desktop)",
      "min": 28,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "intro_size",
      "label": "Intro text size",
      "min": 14,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Question size",
      "min": 14,
      "max": 19,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "answer_size",
      "label": "Answer size",
      "min": 13,
      "max": 17,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Heading & intro width",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "FAQ tabs width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1000,
      "info": "Tabs can be wider than the heading. Use your theme page width as a guide."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_padding_x",
      "label": "Horizontal padding",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_padding_y",
      "label": "Vertical padding",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between tabs",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Scroll reveal"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Animation",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit global" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-in-up", "label": "Fade in up" },
        { "value": "fade-in-left", "label": "Fade in left" },
        { "value": "fade-in-right", "label": "Fade in right" }
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long until my order ships?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Most orders ship within 1–2 business days. You will receive tracking by email.</p>"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "How do I choose the right seeds for my climate?",
            "answer": "<p>Every product page lists ideal growing zones and seasons. Contact us if you need a recommendation.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>We ship to the regions shown at checkout. Join our list if yours is not listed yet.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Unopened items may be returned within 30 days. Open seed packets are final sale.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How should I store seeds?",
            "answer": "<p>Keep them cool, dry, and away from light. A sealed jar in the refrigerator works well.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
