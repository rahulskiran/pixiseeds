{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom

  assign section_animation = section.settings.animations | default: 'inherit'
  assign animation_effect = settings.animations
  if section_animation != 'inherit'
    assign animation_effect = section_animation
  endif
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif
  if request.design_mode
    assign animated = false
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign grad_a = section.settings.gradient_color_1 | default: 'rgba(0,0,0,0)'
  assign grad_b = section.settings.gradient_color_2 | default: 'rgba(0,0,0,0)'
  if section.settings.enable_gradient
    assign section_bg = 'linear-gradient(165deg, ' | append: grad_a | append: ' 0%, ' | append: grad_b | append: ' 100%)'
  else
    assign section_bg = section.settings.background_color
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .m-premium-faq {
    --pf-radius: {{ section.settings.card_radius }}px;
    --pf-pad-y: {{ section.settings.card_padding_y }}px;
    --pf-pad-x: {{ section.settings.card_padding_x }}px;
    --pf-gap: {{ section.settings.item_gap }}px;
    --pf-title-m: {{ section.settings.title_size_mobile }}px;
    --pf-title-d: {{ section.settings.title_size_desktop }}px;
    --pf-eyebrow: {{ section.settings.eyebrow_size }}px;
    --pf-sub: {{ section.settings.intro_size }}px;
    --pf-q: {{ section.settings.question_size }}px;
    --pf-a: {{ section.settings.answer_size }}px;
    --pf-accent: {{ section.settings.accent_color }};
    --pf-accent-rgb: {{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }};
    --pf-max: {{ section.settings.content_max_width }}px;
    background: {{ section_bg }};
  }
  #shopify-section-{{ section.id }} .m-premium-faq.m-section--padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .m-premium-faq.m-section--padding {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
{% endstyle %}

<section
  class="m-section m-premium-faq m-section--padding m-color-{{ section.settings.color_scheme }}{% if section.settings.layout == 'split' %} m-premium-faq--split{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="premium-faq"
  style="--section-padding-top: {{ pt }}px; --section-padding-bottom: {{ pb }}px;"
>
  <div class="m-page-width">
    <div class="m-premium-faq__grid{% if section.settings.layout != 'split' %} m-premium-faq__grid--single{% endif %}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-premium-faq__intro{% if section.settings.intro_align == 'center' %} m:text-center m-premium-faq__intro--center{% endif %}">
        {% if section.settings.eyebrow != blank %}
          <p class="m-premium-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <{{ heading_tag }} class="m-premium-faq__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="m-premium-faq__intro-text rte">{{ section.settings.intro }}</div>
        {% endif %}
        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <p class="m-premium-faq__cta-wrap">
            <a class="m-premium-faq__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
          </p>
        {% endif %}
      </div>

      <div class="m-premium-faq__list" style="max-width: var(--pf-max);">
        {% assign faq_num = 0 %}
        {% for block in section.blocks %}
          {% if block.type != 'item' %}
            {% continue %}
          {% endif %}
          {% if block.settings.question == blank or block.settings.answer == blank %}
            {% continue %}
          {% endif %}
          {% assign faq_num = faq_num | plus: 1 %}

          <collapsible-tab
            class="m-collapsible m-premium-faq__item no-js-hidden"
            data-block-id="collapsible-tab-{{ block.id }}"
            {% if block.settings.default_open %}
              open="true"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <h3 class="m-collapsible--button m-premium-faq__trigger" data-trigger>
              <span class="m-premium-faq__trigger-main">
                {% if section.settings.show_numbers %}
                  <span class="m-premium-faq__index" aria-hidden="true">{% if faq_num < 10 %}0{% endif %}{{ faq_num }}</span>
                {% endif %}
                <span class="m-premium-faq__question">{{ block.settings.question | escape }}</span>
              </span>
              <span class="m-collapsible--icon m-premium-faq__chevron" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M13.5306 6.53073L8.5306 11.5307C8.46092 11.6007 8.37813 11.6561 8.28696 11.694C8.1958 11.7318 8.09806 11.7513 7.99935 11.7513C7.90064 11.7513 7.8029 11.7318 7.71173 11.694C7.62057 11.6561 7.53778 11.6007 7.4681 11.5307L2.4681 6.53073C2.3272 6.38984 2.24805 6.19874 2.24805 5.99948C2.24805 5.80023 2.3272 5.60913 2.4681 5.46823C2.60899 5.32734 2.80009 5.24818 2.99935 5.24818C3.19861 5.24818 3.3897 5.32734 3.5306 5.46823L7.99997 9.93761L12.4693 5.46761C12.6102 5.32671 12.8013 5.24756 13.0006 5.24756C13.1999 5.24756 13.391 5.32671 13.5318 5.46761C13.6727 5.60851 13.7519 5.7996 13.7519 5.99886C13.7519 6.19812 13.6727 6.38921 13.5318 6.53011L13.5306 6.53073Z" fill="currentColor"/>
                </svg>
              </span>
            </h3>
            <div class="m-collapsible--content" data-content hidden>
              <div class="m-collapsible--content__inner m-premium-faq__answer rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </collapsible-tab>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  .m-premium-faq__grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 4vw, 3rem);
  }
  @media screen and (min-width: 990px) {
    .m-premium-faq--split .m-premium-faq__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }
    .m-premium-faq--split .m-premium-faq__intro--center {
      text-align: left;
    }
  }
  .m-premium-faq__intro {
    position: relative;
  }
  .m-page-width .m-premium-faq__intro {
    padding-bottom: 0.25rem;
  }
  .m-premium-faq__intro::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 3px;
    height: 2.75rem;
    border-radius: 2px;
    background: rgb(var(--pf-accent-rgb));
    opacity: 0.85;
  }
  .m-premium-faq__intro--center::before {
    left: 50%;
    transform: translateX(-50%);
  }
  @media screen and (min-width: 990px) {
    .m-premium-faq__intro--center::before {
      left: 0;
      transform: none;
    }
  }
  .m-premium-faq__eyebrow {
    font-family: var(--font-stack-body);
    font-size: var(--pf-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(var(--pf-accent-rgb), 0.9);
    margin: 0 0 0.65rem;
    padding-left: 1rem;
  }
  .m-premium-faq__intro--center .m-premium-faq__eyebrow {
    padding-left: 0;
  }
  @media screen and (min-width: 990px) {
    .m-premium-faq__intro--center .m-premium-faq__eyebrow {
      padding-left: 1rem;
    }
  }
  .m-premium-faq__heading {
    font-family: var(--font-stack-header);
    font-size: var(--pf-title-m);
    line-height: 1.12;
    font-weight: var(--font-weight-header);
    margin: 0 0 1rem;
    padding-left: 1rem;
    color: rgb(var(--color-foreground));
    max-width: 20ch;
  }
  .m-premium-faq__intro--center .m-premium-faq__heading {
    margin-left: auto;
    margin-right: auto;
    padding-left: 0;
    max-width: none;
  }
  @media screen and (min-width: 990px) {
    .m-premium-faq__intro--center .m-premium-faq__heading {
      margin-left: 0;
      padding-left: 1rem;
      max-width: 18ch;
    }
  }
  @media screen and (min-width: 750px) {
    .m-premium-faq__heading {
      font-size: var(--pf-title-d);
    }
  }
  .m-premium-faq__intro-text {
    font-size: var(--pf-sub);
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.75);
    padding-left: 1rem;
    max-width: 36rem;
  }
  .m-premium-faq__intro--center .m-premium-faq__intro-text {
    margin-left: auto;
    margin-right: auto;
    padding-left: 0;
  }
  @media screen and (min-width: 990px) {
    .m-premium-faq__intro--center .m-premium-faq__intro-text {
      margin-left: 0;
      padding-left: 1rem;
    }
  }
  .m-premium-faq__cta-wrap {
    margin: 1.25rem 0 0;
    padding-left: 1rem;
  }
  .m-premium-faq__intro--center .m-premium-faq__cta-wrap {
    padding-left: 0;
  }
  @media screen and (min-width: 990px) {
    .m-premium-faq__intro--center .m-premium-faq__cta-wrap {
      padding-left: 1rem;
    }
  }
  .m-premium-faq__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--pf-accent-rgb));
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--pf-accent-rgb), 0.35);
    padding-bottom: 2px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .m-premium-faq__cta:hover {
    border-bottom-color: rgb(var(--pf-accent-rgb));
    color: rgb(var(--color-foreground));
  }
  .m-premium-faq__list {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: var(--pf-gap);
  }
  .m-premium-faq__grid--single .m-premium-faq__list {
    margin-left: 0;
    max-width: var(--pf-max) !important;
  }
  .m-premium-faq__item {
    margin: 0;
    border-radius: var(--pf-radius);
    background: rgba(var(--color-background), 0.65);
    box-shadow: 0 1px 0 rgba(var(--color-foreground), 0.06);
    border: 1px solid rgba(var(--color-border), 0.55);
    transition:
      box-shadow 0.28s ease,
      border-color 0.28s ease,
      transform 0.28s ease;
    overflow: hidden;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .m-premium-faq__item:hover {
    border-color: rgba(var(--pf-accent-rgb), 0.25);
    box-shadow:
      0 12px 36px rgba(var(--color-foreground), 0.06),
      0 0 0 1px rgba(var(--pf-accent-rgb), 0.08);
  }
  .m-premium-faq__item.m-collapsible[open='true'] {
    border-color: rgba(var(--pf-accent-rgb), 0.35);
    box-shadow: 0 16px 44px rgba(var(--color-foreground), 0.08);
  }
  .m-premium-faq__item .m-premium-faq__trigger {
    padding: var(--pf-pad-y) var(--pf-pad-x);
    margin: 0;
    border-bottom: none;
    align-items: flex-start;
    gap: 1rem;
    text-align: left;
    font-size: var(--pf-q);
    line-height: 1.35;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    background: transparent;
  }
  .m-premium-faq__item.m-collapsible[open='true'] .m-premium-faq__trigger {
    padding-bottom: calc(var(--pf-pad-y) * 0.65);
  }
  .m-premium-faq__trigger-main {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex: 1;
    min-width: 0;
  }
  .m-premium-faq__index {
    flex: 0 0 auto;
    font-family: var(--font-stack-body);
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(var(--pf-accent-rgb), 0.85);
    opacity: 0.9;
  }
  .m-premium-faq__question {
    flex: 1;
    min-width: 0;
  }
  .m-premium-faq__chevron {
    flex-shrink: 0;
    margin-top: 0.2em;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--color-foreground), 0.06);
    color: rgb(var(--color-foreground));
    transition: background 0.2s ease, color 0.2s ease;
  }
  .m-premium-faq__item:hover .m-premium-faq__chevron {
    background: rgba(var(--pf-accent-rgb), 0.12);
    color: rgb(var(--pf-accent-rgb));
  }
  .m-premium-faq__item .m-premium-faq__answer {
    font-size: var(--pf-a);
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.78);
    padding: 0 var(--pf-pad-x) var(--pf-pad-y);
    margin: 0;
    border-top: 1px solid rgba(var(--color-border), 0.4);
  }
  .m-premium-faq__item .m-collapsible--content__inner {
    padding: 0;
  }
  .m-premium-faq__item .m-premium-faq__answer > *:first-child {
    margin-top: var(--pf-pad-y);
  }
  .m-premium-faq__item .m-premium-faq__answer > *:last-child {
    margin-bottom: 0;
  }
  @media screen and (max-width: 749px) {
    .m-premium-faq__item .m-premium-faq__trigger {
      padding-top: calc(var(--pf-pad-y) * 0.9);
      padding-bottom: calc(var(--pf-pad-y) * 0.9);
      padding-left: calc(var(--pf-pad-x) * 0.85);
      padding-right: calc(var(--pf-pad-x) * 0.85);
      font-size: calc(var(--pf-q) * 0.95);
    }
    .m-premium-faq__item .m-premium-faq__answer {
      padding-left: calc(var(--pf-pad-x) * 0.85);
      padding-right: calc(var(--pf-pad-x) * 0.85);
      padding-bottom: calc(var(--pf-pad-y) * 0.9);
    }
    .m-premium-faq__chevron {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium FAQ",
  "tag": "section",
  "class": "m-section-premium-faq",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background (solid)",
      "default": "#f6f4ef"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Use gradient background",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient start",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient end",
      "default": "#ebe6dc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5c7a5e"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        { "value": "split", "label": "Split (intro + FAQs on desktop)" },
        { "value": "stacked", "label": "Stacked (single column)" }
      ]
    },
    {
      "type": "select",
      "id": "intro_align",
      "label": "Intro alignment (mobile)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Answers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions we hear often"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show item numbers",
      "default": true
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Heading size (mobile)",
      "min": 26,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Heading size (desktop)",
      "min": 32,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "intro_size",
      "label": "Intro text size",
      "min": 14,
      "max": 19,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Question size",
      "min": 15,
      "max": 21,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "answer_size",
      "label": "Answer size",
      "min": 14,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_padding_x",
      "label": "Horizontal padding",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_padding_y",
      "label": "Vertical padding",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between cards",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "FAQ column max width",
      "min": 480,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "header",
      "content": "Scroll reveal"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Animation",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit global" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-in-up", "label": "Fade in up" },
        { "value": "fade-in-left", "label": "Fade in left" },
        { "value": "fade-in-right", "label": "Fade in right" }
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long until my order ships?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Most orders ship within 1–2 business days. You will receive tracking by email.</p>"
        },
