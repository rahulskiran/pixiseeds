{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign mobile_cols = section.settings.mobile_columns | default: '2' | plus: 0
  if mobile_cols < 1
    assign mobile_cols = 1
  endif
  if mobile_cols > 2
    assign mobile_cols = 2
  endif
  assign desktop_cols = section.settings.products_per_row | default: 4
  if desktop_cols < 2
    assign desktop_cols = 2
  endif
  if desktop_cols > 6
    assign desktop_cols = 6
  endif
  assign products_limit = section.settings.products_to_show | default: 8
  assign badge_trigger = section.settings.badge_tag | default: 'bestseller' | downcase | strip
  assign atc_text = 'products.product.add_to_cart' | t
  if section.settings.button_label != blank
    assign atc_text = section.settings.button_label
  endif
  assign preview_count = desktop_cols | at_most: 4
  if preview_count < 2
    assign preview_count = 2
  endif
  assign show_editor_placeholders = false
  if request.design_mode and section.settings.show_editor_preview
    assign show_editor_placeholders = true
  endif
-%}

{% style %}
  #m-newproductsec-{{ section.id }} {
    --np-accent: {{ section.settings.accent_color }};
    --np-accent-contrast: {{ section.settings.accent_text_color }};
    --np-tab-inactive: {{ section.settings.tab_inactive_color }};
    --np-star: {{ section.settings.star_color }};
    --np-card-radius: {{ section.settings.card_border_radius }}px;
    --np-grid-gap: {{ section.settings.grid_gap }}px;
    --np-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;
  }
{% endstyle %}

<section
  id="m-newproductsec-{{ section.id }}"
  class="m-section m-newproductsec m-section--padding m-color-{{ section.settings.color_scheme }} m-gradient"
  style="--section-padding-top: {{ pt }}px; --section-padding-bottom: {{ pb }}px;"
  data-newproductsec-tabs
>
  <div class="m-page-width">
    {% if section.settings.heading != blank %}
      <h2 class="m-newproductsec__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="m-newproductsec__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Products' | escape }}">
        {% for block in section.blocks %}
          <button
            type="button"
            class="m-newproductsec__tab"
            role="tab"
            id="m-newproductsec-tab-{{ section.id }}-{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="m-newproductsec-panel-{{ section.id }}-{{ forloop.index0 }}"
            data-tab
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title | escape }}
          </button>
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        {%- assign tab_collection = block.settings.collection -%}
        <div
          id="m-newproductsec-panel-{{ section.id }}-{{ forloop.index0 }}"
          class="m-newproductsec__panel"
          role="tabpanel"
          aria-labelledby="m-newproductsec-tab-{{ section.id }}-{{ forloop.index0 }}"
          data-panel
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if tab_collection != blank and tab_collection.products.size > 0 %}
            <div
              class="m-newproductsec__grid"
              style="--np-m: {{ mobile_cols }}; --np-d: {{ desktop_cols }};"
            >
              {% for product in tab_collection.products limit: products_limit %}
                <article class="m-newproductsec__card">
                  <div class="m-newproductsec__card-media">
                    <a href="{{ product.url }}" class="m-newproductsec__card-link-img" aria-label="{{ product.title | escape }}">
                      {% if product.featured_image != blank %}
                        {%- assign feat_alt = product.featured_image.alt | default: product.title | escape -%}
                        {{
                          product.featured_image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            class: 'm-newproductsec__img',
                            widths: '200, 350, 450, 600, 800',
                            sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw',
                            alt: feat_alt
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'm-newproductsec__img m-placeholder-svg' }}
                      {% endif %}
                    </a>
                    {%- liquid
                      assign show_badge = false
                      assign badge_label = section.settings.badge_text | default: 'BEST SELLER'
                      if section.settings.show_badge
                        for tag in product.tags
                          assign t = tag | downcase | strip
                          if t == badge_trigger
                            assign show_badge = true
                            break
                          endif
                        endfor
                      endif
                    -%}
                    {% if show_badge %}
                      <span class="m-newproductsec__badge">{{ badge_label | escape }}</span>
                    {% endif %}
                  </div>
                  <div class="m-newproductsec__card-body">
                    <h3 class="m-newproductsec__title">
                      <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    </h3>
                    {% if section.settings.show_reviews %}
                      <div class="m-newproductsec__reviews">
                        {% render 'product-reviews-app__badge', product: product %}
                      </div>
                    {% endif %}
                    <div class="m-newproductsec__price">
                      {% render 'product-prices', product: product, is_product_card: true %}
                    </div>
                    <div class="m-newproductsec__atc">
                      {% liquid
                        assign product_form_id = 'NewProductSec-' | append: section.id | append: '-' | append: product.id
                      %}
                      {% if product.has_only_default_variant %}
                        <product-form class="m-product-form m:w-full m:block" data-product-id="{{ product.id }}">
                          {%- form 'product', product, id: product_form_id, class: 'product-card-form', novalidate: 'novalidate' -%}
                            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                            <button
                              type="submit"
                              name="add"
                              class="m-newproductsec__btn-add m-spinner-button m:w-full m-button"
                              {% unless product.available %}disabled{% endunless %}
                              aria-label="{% if product.available %}{{ atc_text }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}"
                            >
                              <span class="m-spinner-icon">
                                <svg class="animate-spin m-svg-icon--medium" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                  <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                              </span>
                              <svg class="m-newproductsec__btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path
                                  d="M6 6h15l-1.5 9h-12L6 6zm0 0L5 3H2M9 20a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                              <span>
                                {% if product.available %}
                                  {{ atc_text }}
                                {% else %}
                                  {{ 'products.product.sold_out' | t }}
                                {% endif %}
                              </span>
                            </button>
                          {%- endform -%}
                        </product-form>
                      {% else %}
                        <a
                          href="{{ product.url }}"
                          class="m-newproductsec__btn-add m-button m:w-full m:text-center"
                        >
                          <svg class="m-newproductsec__btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path
                              d="M6 6h15l-1.5 9h-12L6 6zm0 0L5 3H2M9 20a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                          <span>{{ 'products.product.select_options' | t }}</span>
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </article>
              {% endfor %}
            </div>
          {% elsif show_editor_placeholders %}
            <div class="m-newproductsec__preview-callout" role="note">
              <strong>{{ section.settings.preview_callout_title | escape }}</strong>
              {{ section.settings.preview_callout_body | strip_html | newline_to_br }}
            </div>
            <div
              class="m-newproductsec__grid m-newproductsec__grid--placeholder"
              style="--np-m: {{ mobile_cols }}; --np-d: {{ desktop_cols }};"
            >
              {% for i in (1..preview_count) %}
                <article class="m-newproductsec__card m-newproductsec__card--placeholder">
                  <div class="m-newproductsec__card-media">
                    <div class="m-newproductsec__card-link-img" tabindex="-1">
                      {% capture ph_svg %}product-{% cycle 1, 2, 3, 4 %}{% endcapture %}
                      {{
                        ph_svg
                        | strip
                        | placeholder_svg_tag: 'm-newproductsec__img m-placeholder-svg'
                      }}
                      {% if forloop.first %}
                        <span class="m-newproductsec__badge m-newproductsec__badge--sample">
                          {{- section.settings.preview_badge_text | default: 'SAMPLE' | escape -}}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                  <div class="m-newproductsec__card-body">
                    <h3 class="m-newproductsec__title">
                      <span>{{ 'homepage.onboarding.product_title' | t | default: 'Example product title' }}</span>
                    </h3>
                    {% if section.settings.show_reviews %}
                      <div class="m-newproductsec__reviews m-newproductsec__reviews--fake" aria-hidden="true">
                        <span class="m-newproductsec__stars" style="color: var(--np-star, #d4a017)">★★★★★</span>
                        <span class="m-newproductsec__review-count">(1,204)</span>
                      </div>
                    {% endif %}
                    <div class="m-newproductsec__price">
                      <div class="m-price m-price--fake">
                        {% if settings.currency_code_enabled %}{{ 1999 | money_with_currency }}{% else %}{{ 1999 | money }}{% endif %}
                      </div>
                    </div>
                    <div class="m-newproductsec__atc">
                      <span class="m-newproductsec__btn-add m-newproductsec__btn-add--fake">
                        <svg class="m-newproductsec__btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <path
                            d="M6 6h15l-1.5 9h-12L6 6zm0 0L5 3H2M9 20a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <span>{{ atc_text }}</span>
                      </span>
                    </div>
                  </div>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="m-newproductsec__empty-wrap">
              <p class="m-newproductsec__empty">
                {% if tab_collection == blank %}
                  {{ section.settings.empty_no_collection | escape }}
                {% elsif tab_collection.products.size == 0 %}
                  {{ section.settings.empty_no_products | escape }}
                {% else %}
                  {{ section.settings.empty_state | escape }}
                {% endif %}
              </p>
              {% if tab_collection == blank %}
                <p class="m-newproductsec__empty-hint">{{ section.settings.empty_hint_assign_collection | escape }}</p>
              {% elsif tab_collection.products.size == 0 %}
                <p class="m-newproductsec__empty-hint">{{ section.settings.empty_hint_add_products | escape }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% style %}
  .m-newproductsec__heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.2;
    text-align: {{ section.settings.heading_alignment }};
  }
  .m-newproductsec__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid rgba(var(--color-border), 0.35);
    padding-bottom: 0.5rem;
  }
  .m-newproductsec__tab {
    position: relative;
    padding: 0.35rem 0;
    margin: 0;
    border: none;
    background: none;
    cursor: pointer;
    font: inherit;
    font-weight: 500;
    color: var(--np-tab-inactive, rgb(var(--color-foreground-secondary)));
    transition: color 0.2s ease;
  }
  .m-newproductsec__tab:hover {
    color: rgb(var(--color-foreground));
  }
  .m-newproductsec__tab[aria-selected='true'] {
    color: rgb(var(--color-foreground));
    font-weight: 700;
  }
  .m-newproductsec__tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.55rem;
    height: 3px;
    border-radius: 2px;
    background: var(--np-accent, rgb(var(--color-primary)));
  }
  .m-newproductsec__grid {
    display: grid;
    gap: var(--np-grid-gap-mobile, 16px);
    grid-template-columns: repeat(var(--np-m, 2), minmax(0, 1fr));
  }
  @media screen and (min-width: 1024px) {
    .m-newproductsec__grid {
      gap: var(--np-grid-gap, 24px);
      grid-template-columns: repeat(var(--np-d, 4), minmax(0, 1fr));
    }
  }
  .m-newproductsec__card {
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-border), 0.4);
    border-radius: var(--np-card-radius, 12px);
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(var(--color-foreground), 0.05);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .m-newproductsec__card-media {
    position: relative;
    background: rgba(var(--color-foreground), 0.03);
  }
  .m-newproductsec__card-link-img {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--np-card-radius) var(--np-card-radius) 0 0;
  }
  .m-newproductsec__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    vertical-align: middle;
  }
  .m-newproductsec__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 0.28rem 0.65rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    line-height: 1.2;
    max-width: calc(100% - 20px);
  }
  .m-newproductsec__card-body {
    padding: 1rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    text-align: left;
  }
  .m-newproductsec__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .m-newproductsec__title a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }
  .m-newproductsec__title a:hover {
    text-decoration: underline;
  }
  .m-newproductsec__reviews {
    min-height: 1.25rem;
    font-size: 0.875rem;
  }
  .m-newproductsec__reviews .loox-rating,
  .m-newproductsec__reviews .jdgm-prev-badge {
    color: var(--np-star, #d4a017);
  }
  .m-newproductsec__price {
    margin-top: auto;
    padding-top: 0.25rem;
  }
  .m-newproductsec__price .m-price {
    font-size: 1.125rem;
    font-weight: 700;
  }
  .m-newproductsec__atc {
    margin-top: 0.65rem;
  }
  .m-newproductsec__btn-add {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem 1rem !important;
    border-radius: 999px !important;
    border: none;
    background: var(--np-accent, rgb(var(--color-button))) !important;
    color: var(--np-accent-contrast, rgb(var(--color-button-text))) !important;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }
  .m-newproductsec__btn-add:hover:not(:disabled) {
    opacity: 0.92;
  }
  .m-newproductsec__btn-add:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .m-newproductsec__btn-icon {
    flex-shrink: 0;
  }
  .m-newproductsec__empty {
    margin: 1rem 0 0;
    color: rgb(var(--color-foreground-secondary));
  }
  .m-newproductsec__empty-hint {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-secondary));
    max-width: 42rem;
  }
  .m-newproductsec__preview-callout {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground));
    background: rgba(var(--color-foreground), 0.06);
    border: 1px dashed rgba(var(--color-border), 0.85);
    border-radius: var(--np-card-radius, 12px);
  }
  .m-newproductsec__preview-callout strong {
    display: block;
    margin-bottom: 0.35rem;
  }
  .m-newproductsec__card--placeholder {
    opacity: 1;
  }
  .m-newproductsec__badge--sample {
    background: rgba(var(--color-foreground), 0.12);
    color: rgb(var(--color-foreground));
    font-size: 0.58rem;
  }
  .m-newproductsec__reviews--fake {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
  }
  .m-newproductsec__review-count {
    color: rgb(var(--color-foreground-secondary));
  }
  .m-newproductsec__price .m-price--fake {
    font-size: 1.125rem;
    font-weight: 700;
  }
  .m-newproductsec__btn-add--fake {
    pointer-events: none;
    cursor: default;
    opacity: 0.95;
  }
  .m-newproductsec__card--placeholder .m-newproductsec__card-link-img {
    cursor: default;
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('m-newproductsec-{{ section.id }}');
    if (!root || root.dataset.newproductsecReady) return;
    root.dataset.newproductsecReady = 'true';
    var tabs = root.querySelectorAll('[data-tab]');
    var panels = root.querySelectorAll('[data-panel]');
    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          t.setAttribute('aria-selected', 'false');
        });
        tab.setAttribute('aria-selected', 'true');
        panels.forEach(function (p, j) {
          p.hidden = j !== i;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Community favorites",
  "tag": "section",
  "class": "m-newproductsec-section",
  "disabled_on": { "groups": ["header", "aside", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Community Favorites" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "How to add products"
    },
    {
      "type": "paragraph",
      "content": "Products appear from Shopify collections, not from this section directly. Step 1: Admin → Products → Collections → Create collections (e.g. Vegetables, Flowers). Step 2: Open each product → Organization → Collections → add it to the right collection. Step 3: In each Category tab block, pick that collection. In the theme editor, turn on “Sample cards” below to preview the layout before collections are set."
    },
    {
      "type": "header",
      "content": "Tabs & accent"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (tab underline & buttons)",
      "default": "#D97748"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tab_inactive_color",
      "label": "Inactive tab text",
      "default": "#8B7355"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star highlight (where supported)",
      "default": "#D4A017"
    },
    {
      "type": "header",
      "content": "Product badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge when product has matching tag",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_tag",
      "label": "Tag to match (lowercase)",
      "default": "bestseller",
      "info": "Assign this tag to products that should show the badge."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "BEST SELLER"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#E8C547"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products per tab",
      "default": 8
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Products per row (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Grid gap (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Grid gap (desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review badges",
      "default": true,
