{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
{% liquid
  assign first_block = section.blocks[0]
  assign first_image_desktop = first_block.settings.image
  assign first_image_mobile = first_block.settings.image_mobile
  if section.settings.slide_height == 'adapt'
    assign aspect_ratio = first_image_desktop.aspect_ratio | default: 2.333
    assign aspect_ratio_mobile = first_image_mobile.aspect_ratio | default: aspect_ratio
  endif

  assign show_pagination = section.settings.show_pagination
  assign show_navigation = section.settings.show_navigation
  assign slide_effect = section.settings.slide_effect

  assign show_controls = false
  if show_pagination or show_navigation
    assign show_controls = true
  endif

  assign enable_split_promo = section.settings.enable_split_promo
  if enable_split_promo
    case section.settings.split_content_alignment
      when 'left'
        assign split_items = 'm:items-start'
        assign split_btn_self = 'm:self-start'
      when 'right'
        assign split_items = 'm:items-end'
        assign split_btn_self = 'm:self-end'
      else
        assign split_items = 'm:items-center'
        assign split_btn_self = 'm:self-center'
    endcase
    case section.settings.split_vertical_alignment
      when 'top'
        assign split_justify = 'm:justify-start'
      when 'bottom'
        assign split_justify = 'm:justify-end'
      else
        assign split_justify = 'm:justify-center'
    endcase
    assign split_sub_ff = 'var(--font-stack-body)'
    if section.settings.split_subheading_font == 'heading'
      assign split_sub_ff = 'var(--font-stack-header)'
    endif
    assign split_head_ff = 'var(--font-stack-header)'
    if section.settings.split_heading_font == 'body'
      assign split_head_ff = 'var(--font-stack-body)'
    endif
    assign split_text_ff = 'var(--font-stack-body)'
    if section.settings.split_text_font == 'heading'
      assign split_text_ff = 'var(--font-stack-header)'
    endif
    assign split_badge_top = section.settings.split_badge_offset | default: 16
    assign split_badge_side = section.settings.split_badge_offset | default: 16
  endif
%}
<style>
  @media (max-width: {{ settings.page_width }}px) {
    .m-slide__wrapper.m-page-width {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
<section
  class="m-slide m-slide--{{ section.id }} m-slider--{{ section.settings.slide_height }}{% if enable_split_promo %} m-slide--split{% endif %} {{ section.settings.custom_class }}"
  data-section-type="slider"
  data-section-id="{{ section.id }}"
  style="--data-autoplay-speed: {{ section.settings.autorotate_speed }}s;"
>
  <div class="m-slide__wrapper{% if section.settings.layout == 'grid' %} m-page-width{% else %} m:w-full{% endif %}{% if enable_split_promo and section.settings.split_mobile_full_width and section.settings.layout == 'grid' %} m-slide-split--wrapper-mobile-full{% endif %}">
    <div
      class="m-slide-split{% if enable_split_promo %} m-slide-split--with-panel{% endif %}"
      {% if enable_split_promo %}
        style="--split-panel-width: {{ section.settings.split_panel_width | default: 38 }}%;"
      {% endif %}
    >
      <div class="m-slide-split__slider">
    <m-slideshow
      class="m:block"
      data-id="{{ section.id }}"
      data-autoplay="{{ section.settings.autorotate }}"
      data-autoplay-speed="{{ section.settings.autorotate_speed }}"
      data-pagination="{{ show_pagination }}"
      data-navigation="{{ show_navigation }}"
      data-show-controls="{{ show_controls }}"
      data-effect="{{ slide_effect }}"
      data-show-content-below="{{ section.settings.show_content_below_image }}"
    >
      <div class="swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign image_desktop = block.settings.image
              assign image_mobile = block.settings.image_mobile
              assign heading_size = block.settings.heading_size
              assign alt_default = 'Slide ' | append: forloop.index

              assign loading = 'lazy'
              assign fetchpriority = 'auto'
              if forloop.index == 1 and section.index == 1
                assign loading = 'eager'
                assign fetchpriority = 'high'
              endif

              assign content_position = ''
              case block.settings.content_position
                when 'top_left'
                  assign content_position = ' m:items-start m:justify-start'
                when 'top_right'
                  assign content_position = ' m:justify-end m:items-start'
                when 'top_center'
                  assign content_position = ' m:items-start m:justify-center'
                when 'middle_left'
                  assign content_position = ' m:items-center m:justify-left'
                when 'middle_right'
                  assign content_position = ' m:justify-end m:items-center'
                when 'middle_center'
                  assign content_position = ' m:items-center m:justify-center'
                when 'bottom_left'
                  assign content_position = ' m:items-end m:justify-start'
                when 'bottom_right'
                  assign content_position = ' m:items-end m:justify-end'
                when 'bottom_center'
                  assign content_position = ' m:justify-center m:items-end'
                else
                  assign content_position = ' m:items-center m:justify-center'
              endcase

              assign image_link = block.settings.image_link

              assign no_image = false
              if image_desktop == blank or image_mobile != blank and image_desktop == blank or image_mobile == blank and image_desktop == blank
                assign no_image = true
              endif

              assign color_scheme = block.settings.color_scheme
            %}

            {% capture adapt_style %}
              {% if section.settings.slide_height == 'adapt' %}
                style="--aspect-ratio: {{ aspect_ratio }}; --aspect-ratio-mobile: {{ aspect_ratio_mobile }}"
              {% endif %}
            {% endcapture %}

            <div
              {{ block.shopify_attributes }}
              data-index="{{ forloop.index0 }}"
              class="swiper-slide m-color-{{ color_scheme }} m-gradient"
              data-slide-type="{{ block.type }}"
            >
              <div class="m-slide {% if image_link != blank %} m-slide--has-link{% endif %}">
                <div class="m-slide__media">
                  {% if no_image %}
                    <{% if image_link != blank %}a href="{{ image_link }}"{% else %}div{% endif %} 
                      class="m-slide__bg m-slide__placeholder m-slide__bg--{{ section.settings.slide_height }} m:w-full m:h-full m:block {% if image_mobile != blank %}m:hidden md:m:block{% endif %}"
                      {{ adapt_style }}
                      aria-label="{{ block.settings.heading }}"
                    >
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full' }}
                    </{% if image_link != blank %}a{% else %}div{% endif %}>
                  {% endif %}
                  {%- liquid
                    assign both_images = false
                    if image_desktop != blank and image_mobile != blank
                      assign both_images = true
                    endif
                  -%}
                  {% if both_images %}
                    {%- comment -%}
                      Both a desktop and mobile image are set: use <picture> with a
                      media-matched <source> so the browser fetches only the image it
                      will actually render, instead of downloading both art-directed
                      variants at high priority on every device.
                    {%- endcomment -%}
                    <{% if image_link != blank %}a href="{{ image_link }}"{% else %}div{% endif %}
                      {{ adapt_style }}
                      class="m-slide__bg m:w-full m:h-full m-slide__bg--{{ section.settings.slide_height }} m:block"
                      aria-label="{{ block.settings.heading }}"
                    >
                      {%- liquid
                        assign image_height = image_desktop.width | divided_by: image_desktop.aspect_ratio | round
                        assign atl = image_desktop.alt | default: alt_default
                      -%}
                      {%- capture atl -%}{% render 'scrub-lormur', text: atl %}{%- endcapture -%}
                      {%- liquid
                        assign atl = atl | strip
                      -%}
                      {%- capture mobile_srcset -%}
                        {%- for w in '375,550,750,1100' | split: ',' -%}
                          {{- image_mobile | image_url: width: w -}} {{ w }}w{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      {%- endcapture -%}
                      <picture>
                        <source media="(max-width: 767px)" sizes="100vw" srcset="{{ mobile_srcset | strip_newlines | strip }}">
                        {{
                          image_desktop
                          | image_url: width: 3840
                          | image_tag:
                            loading: loading,
                            fetchpriority: fetchpriority,
                            width: image_desktop.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                            alt: atl
                          | escape
                        }}
                      </picture>
                    </{% if image_link != blank %}a{% else %}div{% endif %}>
                  {% else %}
                    {% if image_desktop != blank %}
                      <{% if image_link != blank %}a href="{{ image_link }}"{% else %}div{% endif %}
                        {{ adapt_style }}
                        class="m-slide__bg m:w-full m:h-full m-slide__bg--{{ section.settings.slide_height }} m:block"
                        aria-label="{{ block.settings.heading }}"
                      >
                        {%- liquid
                          assign image_height = image_desktop.width | divided_by: image_desktop.aspect_ratio | round
                          assign atl = image_desktop.alt | default: alt_default
                        -%}
                        {%- capture atl -%}{% render 'scrub-lormur', text: atl %}{%- endcapture -%}
                        {%- liquid
                          assign atl = atl | strip
                        -%}

                        {{
                          image_desktop
                          | image_url: width: 3840
                          | image_tag:
                            loading: loading,
                            fetchpriority: fetchpriority,
                            width: image_desktop.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                            alt: atl
                          | escape
                        }}
                      </{% if image_link != blank %}a{% else %}div{% endif %}>
                    {% endif %}
                    {% if image_mobile != blank %}
                      <{% if image_link != blank %}a href="{{ image_link }}"{% else %}div{% endif %}
                        {{ adapt_style }}
                        class="m-slide__bg m:w-full m:h-full m-slide__bg--{{ section.settings.slide_height }} m:block"
                        aria-label="{{ block.settings.heading }}"
                      >
                        {%- liquid
                          assign image_height = image_mobile.width | divided_by: image_mobile.aspect_ratio | round
                          assign atl = image_mobile.alt | default: alt_default
                        -%}
                        {%- capture atl -%}{% render 'scrub-lormur', text: atl %}{%- endcapture -%}
                        {%- liquid
                          assign atl = atl | strip
                        -%}

                        {{
                          image_mobile
                          | image_url: width: 1100
                          | image_tag:
                            loading: loading,
                            fetchpriority: fetchpriority,
                            width: image_mobile.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '375, 550, 750, 1100',
                            alt: atl
                          | escape
                        }}
                      </{% if image_link != blank %}a{% else %}div{% endif %}>
                    {% endif %}
                  {% endif %}
                </div>
                <div 
                  class="m-slide__content m-slide__content--{{ heading_size }}{% if section.settings.show_content_below_image %} m-slide__content--below-image{% endif %}{% if show_controls %} m-slide__has-controls{% endif %}"
                  data-color-scheme="m-color-{{ color_scheme }}"
                >
                  <div class="m-slide__content--wrapper m:display-flex m:h-full{% if block.settings.enable_container_box %} m-page-width{% endif %}{{ content_position }}">
                    <div class="m-slide__content--inner{% if section.settings.show_content_below_image %} m:text-{{ section.settings.content_alignment_mobile }} md:m:text-{{ block.settings.content_alignment }}{% else %} m:text-{{ block.settings.content_alignment }}{% endif %}">
                      {%- assign animate_delay = 1 -%}
                      {% if block.settings.sub_heading != blank %}
                        <p class="m-slide__content-subheading" data-animate data-animate-delay-{{ animate_delay }}>
                          {{ block.settings.sub_heading }}
                        </p>
                        {%- assign animate_delay = animate_delay | plus: 1 -%}
                      {% endif %}
                      {% if block.settings.heading != blank %}
                        <h2
                          class="m-slide__content-heading {{ heading_size }}"
                          data-animate
                          data-animate-delay-{{ animate_delay }}
                        >
                          {{ block.settings.heading }}
                        </h2>
                        {%- assign animate_delay = animate_delay | plus: 1 -%}
                      {% endif %}
                      {% if block.settings.description != blank %}
                        <div class="m-slide__content-description" data-animate data-animate-delay-{{ animate_delay }}>
                          {{ block.settings.description }}
                        </div>
                        {%- assign animate_delay = animate_delay | plus: 1 -%}
                      {% endif %}
                      {% if block.settings.button_label != blank %}
                        <div 
                          class="m-slide__content-button"
                          data-animate
                          data-animate-delay-{{ animate_delay }}
                        >
                          {% capture arrow  %}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="CurrentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>{% endcapture %}
                          {% capture triangle %}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.51531 5.73474L4.76531 1.98474C4.71287 1.93223 4.64602 1.89647 4.57324 1.88198C4.50046 1.86748 4.42501 1.87491 4.35645 1.90332C4.28789 1.93172 4.22931 1.97984 4.1881 2.04156C4.1469 2.10328 4.12494 2.17584 4.125 2.25005V9.75005C4.12494 9.82426 4.1469 9.89682 4.1881 9.95855C4.22931 10.0203 4.28789 10.0684 4.35645 10.0968C4.42501 10.1252 4.50046 10.1326 4.57324 10.1181C4.64602 10.1036 4.71287 10.0679 4.76531 10.0154L8.51531 6.26536C8.55018 6.23054 8.57784 6.18918 8.59671 6.14365C8.61558 6.09813 8.62529 6.04933 8.62529 6.00005C8.62529 5.95077 8.61558 5.90197 8.59671 5.85645C8.57784 5.81092 8.55018 5.76957 8.51531 5.73474Z" fill="currentColor"/></svg>{% endcapture %}
                          {% liquid 
                            assign is_button_icon = false
                            if block.settings.button_label contains '[arrow]' or block.settings.button_label contains '[triangle]'
                              assign is_button_icon = true
                            endif
                          %}
                          <a
                            href="{{ image_link | default: '#' }}"
                            class="m-button {{ block.settings.button_style }}{% if is_button_icon %} m-button--with-icon{% endif %}"
                          >
                            {{- block.settings.button_label | replace: '[arrow]', arrow | replace: '[triangle]', triangle -}}
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        {% if show_controls %}
          {%- liquid
            assign classes = ''
            if section.settings.show_content_below_image 
              assign classes = 'm-slide__content--below-image'
            endif
          -%}
          {% render 'slider-controls',
            container: section.settings.layout,
            show_nav: show_navigation,
            show_pagination: show_pagination,
            extra_classes: classes
          %}
        {% endif %}
      </div>
    </m-slideshow>
      </div>
      {% if enable_split_promo %}
        <aside
          class="m-slide-split__panel m:relative{% if section.settings.split_hide_panel_on_mobile %} m-slide-split__panel--hide-mobile{% endif %}"
          style="background-color: {{ section.settings.split_panel_bg | default: '#3d4f34' }}; padding: {{ section.settings.split_padding_vertical | default: 40 }}px {{ section.settings.split_padding_horizontal | default: 32 }}px;"
        >
          {% if section.settings.split_badge_image != blank %}
            <div
              class="m-slide-split__badge m:absolute m:z-10"
              style="width: {{ section.settings.split_badge_width | default: 72 }}px; {% if section.settings.split_badge_position == 'top_left' %}top: {{ split_badge_top }}px; left: {{ split_badge_side }}px;{% else %}top: {{ split_badge_top }}px; right: {{ split_badge_side }}px;{% endif %}"
            >
              {{
                section.settings.split_badge_image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  class: 'm:w-full',
                  widths: '80, 120, 160, 200, 240, 320, 400',
                  alt: section.settings.split_badge_image.alt
              }}
            </div>
          {% endif %}
          <div
            class="m-slide-split__panel-inner m:flex m:flex-col m:w-full md:m:min-h-full {{ split_justify }} {{ split_items }} m:text-{{ section.settings.split_content_alignment | default: 'center' }} m:relative m:z-1"
            style="gap: {{ section.settings.split_text_gap | default: 16 }}px;"
          >
            {% if section.settings.split_promo_image != blank %}
              <div class="m-slide-split__promo-image {{ split_btn_self }}" style="max-width: {{ section.settings.split_promo_image_width | default: 220 }}px; border-radius: {{ section.settings.split_promo_image_radius | default: 0 }}px;">
                {{
                  section.settings.split_promo_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'm:w-full m:h-auto m:block',
                    widths: '200, 360, 480, 600, 800',
                    alt: section.settings.split_promo_image.alt
                }}
              </div>
            {% endif %}
            {% if section.settings.split_subheading != blank %}
              <p
                class="m-slide-split__subheading{% if section.settings.split_subheading_uppercase %} m:uppercase{% endif %}"
                style="font-family: {{ split_sub_ff }}; color: {{ section.settings.split_subheading_color | default: '#c8f542' }}; font-size: {{ section.settings.split_subheading_size | default: 14 }}px; font-weight: {{ section.settings.split_subheading_weight | default: 600 }};{% if section.settings.split_subheading_uppercase %} letter-spacing: 0.06em;{% endif %}"
              >
                {{ section.settings.split_subheading }}
              </p>
            {% endif %}
            {% if section.settings.split_heading != blank %}
              <h2
                class="m-slide-split__heading {{ section.settings.split_heading_size | default: 'h2' }}"
                style="font-family: {{ split_head_ff }}; color: {{ section.settings.split_heading_color | default: '#ffffff' }}; font-weight: {{ section.settings.split_heading_weight | default: 600 }};"
              >
                {{ section.settings.split_heading | newline_to_br }}
              </h2>
            {% endif %}
            {% if section.settings.split_text != blank %}
              <div
                class="m-slide-split__text rte"
                style="font-family: {{ split_text_ff }}; color: {{ section.settings.split_text_color | default: '#ffffff' }}; font-size: {{ section.settings.split_text_size | default: 16 }}px;"
              >
                {{ section.settings.split_text }}
              </div>
            {% endif %}
            {% if section.settings.split_button_label != blank %}
              {% capture arrow %}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="CurrentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>{% endcapture %}
              {% capture triangle %}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.51531 5.73474L4.76531 1.98474C4.71287 1.93223 4.64602 1.89647 4.57324 1.88198C4.50046 1.86748 4.42501 1.87491 4.35645 1.90332C4.28789 1.93172 4.22931 1.97984 4.1881 2.04156C4.1469 2.10328 4.12494 2.17584 4.125 2.25005V9.75005C4.12494 9.82426 4.1469 9.89682 4.1881 9.95855C4.22931 10.0203 4.28789 10.0684 4.35645 10.0968C4.42501 10.1252 4.50046 10.1326 4.57324 10.1181C4.64602 10.1036 4.71287 10.0679 4.76531 10.0154L8.51531 6.26536C8.55018 6.23054 8.57784 6.18918 8.59671 6.14365C8.61558 6.09813 8.62529 6.04933 8.62529 6.00005C8.62529 5.95077 8.61558 5.90197 8.59671 5.85645C8.57784 5.81092 8.55018 5.76957 8.51531 5.73474Z" fill="currentColor"/></svg>{% endcapture %}
              {% liquid
                assign split_btn_icon = false
                if section.settings.split_button_label contains '[arrow]' or section.settings.split_button_label contains '[triangle]'
                  assign split_btn_icon = true
                endif
              %}
              <div class="m-slide-split__button {{ split_btn_self }}">
                <a
                  href="{{ section.settings.split_button_link | default: '#' }}"
                  class="m-button m-slide-split__btn {{ section.settings.split_button_style }}{% if split_btn_icon %} m-button--with-icon{% endif %}"
                >
                  {{- section.settings.split_button_label | replace: '[arrow]', arrow | replace: '[triangle]', triangle -}}
                </a>
              </div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
    </div>
  </div>
</section>
{% if enable_split_promo %}
  {% style %}
    #shopify-section-{{ section.id }} .m-slide-split__btn {
      background-color: {{ section.settings.split_button_bg | default: '#c8f542' }} !important;
      color: {{ section.settings.split_button_text_color | default: '#ffffff' }} !important;
      border-color: {{ section.settings.split_button_bg | default: '#c8f542' }} !important;
    }
    #shopify-section-{{ section.id }} .m-slide-split__btn:hover {
      background-color: {{ section.settings.split_button_hover_bg | default: '#b0dc38' }} !important;
      color: {{ section.settings.split_button_hover_text | default: '#ffffff' }} !important;
      border-color: {{ section.settings.split_button_hover_bg | default: '#b0dc38' }} !important;
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "Slideshow",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Split promo panel (image left, content right)"
    },
    {
      "type": "checkbox",
      "id": "enable_split_promo",
      "label": "Enable right-side promo panel",
      "default": false,
      "info": "Shows a customizable column next to the slideshow. Slide overlay text is hidden—use slides for images only, and this panel for headline, copy, and CTA. On screens under 1024px the panel stacks below the slider unless you hide it in mobile settings."
    },
    {
      "type": "checkbox",
      "id": "split_hide_panel_on_mobile",
      "label": "Hide promo panel on mobile",
      "default": false,
      "info": "Below 1024px width, only the slideshow shows. Use when the promo is desktop-only."
    },
    {
      "type": "checkbox",
      "id": "split_mobile_full_width",
      "label": "Full width on mobile (no grid side padding)",
      "default": false,
      "info": "Only applies when Layout is set to Grid. Makes the slideshow + split row span the full viewport width on screens under 1024px (removes page gutters)."
    },
    {
      "type": "range",
      "id": "split_panel_width",
      "min": 28,
      "max": 48,
      "step": 1,
      "unit": "%",
      "label": "Right column width (desktop)",
      "default": 38
    },
    {
      "type": "color",
      "id": "split_panel_bg",
      "label": "Panel background color",
      "default": "#3d4f34"
    },
    {
      "type": "range",
      "id": "split_padding_vertical",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Panel vertical padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "split_padding_horizontal",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Panel horizontal padding",
      "default": 32
    },
    {
      "type": "select",
      "id": "split_content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
