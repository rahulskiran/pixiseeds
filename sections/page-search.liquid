{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign psrch_sid = section.id | replace: '-', '' | truncate: 8, ''

  assign columns = section.settings.grid_columns
  assign tablet_columns = columns | at_most: 3
  assign laptop_columns = columns | at_most: 4

  assign boxed_layout = settings.enable_boxed_layout
  assign boxed_color_scheme = settings.boxed_color_scheme

  assign card_bordered = false
  if boxed_layout and section.settings.grid_bordered
    assign card_bordered = true
  endif

  assign sidebar_title = section.settings.sidebar_title
  assign filter_title_divider = section.settings.filter_title_divider

  assign sidebar_position = 'left'
%}
{% paginate search.results by section.settings.results_per_page %}
  <section
    id="psrch-{{ psrch_sid }}"
    class="psrch m-section m-section--padding{% if boxed_layout %} m-section--boxed{% if section.settings.grid_bordered %} m-section--grid-bordered{% endif %}{% endif %}{% if section.settings.psrch_chip_outline %} psrch--chip-outline{% endif %} facest-filters-section m-search-template m-search m-main-collection"
    data-section-type="page-search"
    data-enable-filters="{{ section.settings.show_filter }}"
    data-enable-sorting="{{ section.settings.show_sorting }}"
    data-section-id="{{ section.id }}"
    data-view="{{ template.name }}"
    style="
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="m-page-width">
      <div class="psrch__hero m-search-template__header m:flex m:flex-col{% if section.settings.psrch_title_align == 'left' %} m:items-start psrch__hero--left{% else %} m:items-center{% endif %}">
        {% if search.performed %}
          <h1 class="psrch__title m-search-template__title h3">
            {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
          </h1>
        {% else %}
          <h1 class="psrch__title m-search-template__title h3">{{ 'general.search.search' | t }}</h1>
        {% endif %}
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="m:display-flex m:justify-center m:w-full" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        <main-search class="psrch__search-wrap m:display-flex m:justify-center m:w-full">
          <form action="{{ routes.search_url }}" method="get" role="search" class="psrch__form m-search-form">
            <div class="m-search-form__wrapper{% if search.terms != blank %} m-search-form--has-value{% endif %}">
              <input
                class="search__input field__input form-field form-field--input m-search__input"
                id="Search-In-Template-{{ section.id }}"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search_field_placeholder' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <input name="options[prefix]" type="hidden" value="last">
              <div class="m-search-form__buttons">
                <button
                  type="reset"
                  class="reset__button m-search-form__reset--button{% if search.terms == blank %} m:hidden{% endif %}"
                  aria-label="{{ 'general.search.reset' | t }}"
                >
                  <svg class="m-svg-icon--large" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.75 5.25L5.25 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M18.75 18.75L5.25 5.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button type="submit" class="search__button m-search-form__search--button m-spinner-button" aria-label="{{ 'general.search.search' | t }}">
                  <svg class="m-svg-icon--large" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M15.8032 15.8035L20.9998 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="m-spinner-icon">
                    <svg
                      class="animate-spin m-svg-icon--medium"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                    >
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
                      <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </span>
                </button>
              </div>
            </div>
            {%- if settings.predictive_search_enabled -%}
              <div
                class="m-predictive-search m-gradient m-color-{{ settings.popups_drawer_color_scheme }}"
                tabindex="-1"
                data-predictive-search
              ></div>
              <span class="m-predictive-search-status m:visually-hidden" role="status" aria-hidden="true"></span>
            {%- endif -%}
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>
    </div>
    {% if search.performed %}
      <div class="m-page-width">
        <div class="m-main-collection__wrapper m:display-flex m:items-start m-sidebar--{{ sidebar_position }}">
          {%- if search.filters != empty and section.settings.show_filter -%}
            <div class="m-sidebar{% if filter_title_divider %} m-sidebar--header-separated{% endif %}{% if sidebar_title == blank %} m-sidebar--blank-title{% endif %}{% unless section.settings.show_filter %} m:hidden{% endunless %}">
              <div class="m-sidebar__content{% if boxed_layout %} m-gradient m-color-{{ boxed_color_scheme }}{% endif %}">
                {%- if sidebar_title != blank -%}
                  <h2 class="m-sidebar__title h4">{{ sidebar_title }}</h2>
                {%- endif -%}
                <div class="m-sidebar__close xl:m:hidden">
                  <svg
                    class="m-svg-icon--large"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </div>
                <div class="m-sidebar__filter">
                  {% render 'storefront-filters', section: section, results: search, color_scheme: boxed_color_scheme %}
                </div>
              </div>
            </div>
          {%- endif -%}
          <div
            id="CollectionProductGrid"
            class="m-section__wrapper m:flex-1{% if boxed_layout %} m-gradient m-color-{{ boxed_color_scheme }}{% endif %}"
          >
            {%- if section.settings.show_sorting and search.filters != empty -%}
              <div class="m-section__content m-main-collection__top">
                {%- render 'collection-page-toolbar', section: section, results: search, paginate: paginate, is_search_page: true, color_scheme: boxed_color_scheme -%}
                {%- render 'collection-filters-facets', results: search -%}
              </div>
            {%- endif -%}
            {% if search.results_count == 0 %}
              <div class="psrch__empty m-section__content m-search--empty m:text-center">
                {{ 'templates.search.no_results' | t: terms: search.terms }}
              </div>
            {% else %}
              <div
                class="psrch__grid m-section__content m-search-result{% if section.settings.show_filter or section.settings.show_sorting %} m-search-show-filter{% endif %} m:grid m:grid-2-cols md:m:grid-{{ tablet_columns }}-cols lg:m:grid-{{ laptop_columns }}-cols xl:m:grid-{{ columns }}-cols"
                style="
                  --column-gap: {{ section.settings.column_gap }}px; 
                  --column-gap-mobile: {{ section.settings.column_gap_mobile }}px; 
                  --row-gap: {{ section.settings.row_gap }}px; 
                  --row-gap-mobile: {{ section.settings.row_gap_mobile }}px; 
                "
              >
                {% for item in search.results limit: section.settings.results_per_page %}
                  {% if item.object_type == 'product' %}
                    <div class="m-search-item m:column">
                      {% liquid
                        case settings.pcard_layout
                          when '1'
                            render 'product-card-1', product: item, section: section, card_bordered: card_bordered
                          when '2'
                            render 'product-card-2', product: item, section: section, card_bordered: card_bordered
                          when '3'
                            render 'product-card-3', product: item, section: section, card_bordered: card_bordered
                        endcase
                      %}
                    </div>
                  {% endif %}
                  {% if item.object_type == 'article' %}
                    <div class="m-search-item m:column">
                      {% render 'article-card', article: item, card_bordered: card_bordered %}
                    </div>
                  {% endif %}
                  {% if item.object_type == 'page' %}
                    <div class="m-search-item m:column">
                      <a
                        href="{{ item.url }}"
                        class="psrch__page-card m-search-item-page m:display-flex m:flex-col m:justify-center m:h-full"
                      >
                        <span class="m-search-item-page--badge">Page</span>
                        <h3 class="m-search-item-page--title h5">{{ item.title | escape }}</h3>
                      </a>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            {% if paginate.pages > 1 %}
              {% render 'pagination', paginate: paginate, extra_classes: 'm-section__content m-search-pagination' %}
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
    {% if section.settings.show_sorting %}
      {%- render 'sort-by-mobile', results: search -%}
    {% endif %}
  </section>
{% endpaginate %}
<script>
  window.addEventListener('load', () => {
    if (typeof Collection !== 'undefined') {
      MinimogTheme.Collection = new Collection();
      MinimogTheme.Collection.init();
    }
  });
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      MinimogTheme.Collection.init();
    });
  }
</script>
{% style %}
  #psrch-{{ psrch_sid }} {
    --psrch-bg: {{ section.settings.psrch_bg_color }};
    --psrch-title: {{ section.settings.psrch_title_color }};
    --psrch-title-m: {{ section.settings.psrch_title_size_mobile }}px;
    --psrch-title-d: {{ section.settings.psrch_title_size_desktop }}px;
    --psrch-muted: {{ section.settings.psrch_muted_color }};
    --psrch-search-max: {{ section.settings.psrch_search_max_width }}px;
    --psrch-search-bg: {{ section.settings.psrch_search_bg }};
    --psrch-search-border: {{ section.settings.psrch_search_border }};
    --psrch-search-fg: {{ section.settings.psrch_search_fg }};
    --psrch-search-radius: {{ section.settings.psrch_search_radius }}px;
    --psrch-search-icon: {{ section.settings.psrch_search_icon_color }};
    --psrch-bar-bg: {{ section.settings.psrch_bar_bg }};
    --psrch-bar-border: {{ section.settings.psrch_bar_border }};
    --psrch-tb-count: {{ section.settings.psrch_toolbar_count_color }};
    --psrch-tb-muted: {{ section.settings.psrch_toolbar_muted_color }};
    --psrch-sort-bg: {{ section.settings.psrch_sort_bg }};
    --psrch-sort-fg: {{ section.settings.psrch_sort_fg }};
    --psrch-sort-border: {{ section.settings.psrch_sort_border }};
    --psrch-sort-radius: {{ section.settings.psrch_sort_radius }}px;
    --psrch-sort-focus: {{ section.settings.psrch_sort_focus_color }};
    --psrch-card-bg: {{ section.settings.psrch_card_bg }};
    --psrch-card-border: {{ section.settings.psrch_card_border }};
    --psrch-card-border-hover: {{ section.settings.psrch_card_border_hover }};
    --psrch-card-shadow: {{ section.settings.psrch_card_shadow }};
    --psrch-card-radius: {{ section.settings.psrch_card_radius }}px;
    --psrch-sidebar-bg: {{ section.settings.psrch_sidebar_bg }};
    --psrch-page-badge-bg: {{ section.settings.psrch_page_badge_bg }};
    --psrch-page-badge-fg: {{ section.settings.psrch_page_badge_fg }};
    --psrch-empty-link: {{ section.settings.psrch_empty_link_color }};
    --psrch-pg-fg: {{ section.settings.psrch_pagination_fg }};
    --psrch-pg-cur-bg: {{ section.settings.psrch_pagination_current_bg }};
    --psrch-pg-cur-fg: {{ section.settings.psrch_pagination_current_fg }};
    --psrch-pg-disabled: {{ section.settings.psrch_pagination_disabled }};
    --psrch-pt-m: {{ section.settings.padding_top_mobile }}px;
    --psrch-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --psrch-pt-d: {{ section.settings.padding_top }}px;
    --psrch-pb-d: {{ section.settings.padding_bottom }}px;
    --psrch-content-max: {{ section.settings.psrch_content_max_width }}px;
    --psrch-hero-pad-b: {{ section.settings.psrch_hero_padding_bottom }}px;
    --psrch-search-mt: {{ section.settings.psrch_search_margin_top }}px;
    --psrch-search-border-w: {{ section.settings.psrch_search_border_width }}px;
    --psrch-search-min-h: {{ section.settings.psrch_search_min_height }}px;
    --psrch-search-fs: {{ section.settings.psrch_search_font_size }}px;
    --psrch-search-ph: {{ section.settings.psrch_search_placeholder_color }};
    --psrch-search-pad-r: {{ section.settings.psrch_search_padding_right }}px;
    --psrch-title-fw: {{ section.settings.psrch_title_font_weight }};
    --psrch-title-align: {{ section.settings.psrch_title_align }};
    --psrch-title-max: {{ section.settings.psrch_title_max_width }}rem;
    --psrch-bar-py: {{ section.settings.psrch_toolbar_padding_y }}px;
    --psrch-bar-mb: {{ section.settings.psrch_toolbar_margin_bottom }}px;
    --psrch-bar-border-w: {{ section.settings.psrch_toolbar_border_width }}px;
    --psrch-pg-mt: {{ section.settings.psrch_pagination_margin_top }}px;
    --psrch-pg-pt: {{ section.settings.psrch_pagination_padding_top }}px;
    --psrch-pg-radius: {{ section.settings.psrch_pagination_item_radius }}px;
    --psrch-empty-fs: {{ section.settings.psrch_empty_font_size }}px;
    --psrch-page-card-pad: {{ section.settings.psrch_page_card_padding }}px;
    --psrch-icon-size: {{ section.settings.psrch_search_icon_size }}px;
    background: var(--psrch-bg);
    color: var(--psrch-title);
    font-feature-settings: 'ss01', 'cv01';
  }

  #psrch-{{ psrch_sid }}.m-section--padding {
    padding-top: var(--psrch-pt-m);
    padding-bottom: var(--psrch-pb-m);
  }

  @media screen and (min-width: 750px) {
    #psrch-{{ psrch_sid }}.m-section--padding {
      padding-top: var(--psrch-pt-d);
      padding-bottom: var(--psrch-pb-d);
    }
  }

  #psrch-{{ psrch_sid }} .m-page-width {
    width: 100%;
    max-width: var(--psrch-content-max);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 40px);
    box-sizing: border-box;
  }

  #psrch-{{ psrch_sid }} .psrch__title {
    margin: 0;
    color: var(--psrch-title);
    font-size: var(--psrch-title-m);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: var(--psrch-title-fw);
    text-align: var(--psrch-title-align);
    max-width: var(--psrch-title-max);
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    #psrch-{{ psrch_sid }} .psrch__title {
      font-size: var(--psrch-title-d);
    }
  }

  #psrch-{{ psrch_sid }} .psrch__hero {
    padding-bottom: var(--psrch-hero-pad-b);
  }

  #psrch-{{ psrch_sid }} .psrch__hero--left .psrch__title {
    margin-inline: 0;
  }

  #psrch-{{ psrch_sid }} .psrch__hero--left .psrch__search-wrap,
  #psrch-{{ psrch_sid }} .psrch__hero--left predictive-search {
    justify-content: flex-start;
    width: 100%;
  }

  #psrch-{{ psrch_sid }} .psrch__form {
    width: min(var(--psrch-search-max), 100%);
    margin-top: var(--psrch-search-mt);
  }

  #psrch-{{ psrch_sid }} .psrch__form .m-search-form__wrapper {
    border-radius: var(--psrch-search-radius);
    border: var(--psrch-search-border-w) solid var(--psrch-search-border);
    background: var(--psrch-search-bg);
    min-height: var(--psrch-search-min-h);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #psrch-{{ psrch_sid }} .psrch__form .m-search-form__wrapper:focus-within {
    border-color: var(--psrch-sort-focus);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--psrch-sort-focus) 35%, transparent);
  }

  #psrch-{{ psrch_sid }} .psrch__form .search__input,
  #psrch-{{ psrch_sid }} .psrch__form .m-search__input {
    background: transparent !important;
    color: var(--psrch-search-fg) !important;
    border: 0 !important;
    border-radius: 0 !important;
    font-size: var(--psrch-search-fs) !important;
    min-height: var(--psrch-search-min-h);
    padding-right: var(--psrch-search-pad-r) !important;
  }

  #psrch-{{ psrch_sid }} .psrch__form .search__input::placeholder {
    color: var(--psrch-search-ph);
  }

  #psrch-{{ psrch_sid }} .psrch__form .m-search-form__search--button,
  #psrch-{{ psrch_sid }} .psrch__form .m-search-form__reset--button {
    color: var(--psrch-search-icon);
  }

  #psrch-{{ psrch_sid }} .psrch__form .m-search-form__search--button svg,
  #psrch-{{ psrch_sid }} .psrch__form .m-search-form__reset--button svg {
    width: var(--psrch-icon-size);
    height: var(--psrch-icon-size);
  }

  #psrch-{{ psrch_sid }} .m-collection-toolbar {
    background: var(--psrch-bar-bg);
    border-top: var(--psrch-bar-border-w) solid var(--psrch-bar-border);
    border-bottom: var(--psrch-bar-border-w) solid var(--psrch-bar-border);
    border-radius: 0;
    padding: var(--psrch-bar-py) 0;
    margin-bottom: var(--psrch-bar-mb);
  }

  #psrch-{{ psrch_sid }} .m-collection-toolbar__total {
    color: var(--psrch-tb-muted);
    font-size: 0.8125rem;
  }

  #psrch-{{ psrch_sid }} .m-collection-toolbar__total strong {
    color: var(--psrch-tb-count);
    font-weight: 600;
  }

  #psrch-{{ psrch_sid }} .m-filter-button {
    border: 1px solid var(--psrch-sort-border);
    background: var(--psrch-sort-bg);
    color: var(--psrch-sort-fg);
    border-radius: var(--psrch-sort-radius);
    padding: 9px 16px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  #psrch-{{ psrch_sid }} .m-filter-button:hover {
    background: color-mix(in srgb, var(--psrch-sort-fg) 8%, var(--psrch-sort-bg));
  }

  #psrch-{{ psrch_sid }} .m-select-custom--trigger {
    border: 1px solid var(--psrch-sort-border) !important;
    background: var(--psrch-sort-bg) !important;
    color: var(--psrch-sort-fg) !important;
    border-radius: var(--psrch-sort-radius) !important;
    min-height: 40px;
    padding-inline: 14px;
    font-size: 0.8125rem;
  }

  #psrch-{{ psrch_sid }} .m-select-custom--trigger-icon {
    color: var(--psrch-tb-muted);
  }

  #psrch-{{ psrch_sid }} .m-sortby-button {
    border: 1px solid var(--psrch-sort-border);
    background: var(--psrch-sort-bg);
    color: var(--psrch-sort-fg);
    border-radius: var(--psrch-sort-radius);
    font-size: 0.8125rem;
  }

  #psrch-{{ psrch_sid }} .m-active-facets {
    gap: 6px;
    margin-bottom: 4px;
  }

  #psrch-{{ psrch_sid }} .m-active-facets__item a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: var(--psrch-sort-fg);
    color: var(--psrch-sort-bg);
    border: 1px solid var(--psrch-sort-fg);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #psrch-{{ psrch_sid }} .m-active-facets__item a:hover {
    opacity: 0.88;
  }

  #psrch-{{ psrch_sid }}.psrch--chip-outline .m-active-facets__item a {
    background: transparent;
    color: var(--psrch-sort-fg);
    border: 1px solid var(--psrch-sort-border);
  }

  #psrch-{{ psrch_sid }}.psrch--chip-outline .m-active-facets__item a:hover {
    background: color-mix(in srgb, var(--psrch-sort-fg) 6%, transparent);
    opacity: 1;
  }

  #psrch-{{ psrch_sid }} .m-sidebar__content.m-gradient {
    background: var(--psrch-sidebar-bg) !important;
    border-radius: var(--psrch-card-radius);
    border: 1px solid var(--psrch-card-border);
  }

  #psrch-{{ psrch_sid }} .m-sidebar__title {
    color: var(--psrch-title);
  }

  #psrch-{{ psrch_sid }} .m-section__wrapper.m-gradient {
    background: transparent !important;
  }

  #psrch-{{ psrch_sid }} .psrch__grid {
    row-gap: calc(var(--row-gap-mobile) * {{ section.settings.psrch_grid_row_gap_percent }} / 100);
  }

  @media screen and (min-width: 750px) {
    #psrch-{{ psrch_sid }} .psrch__grid {
      row-gap: calc(var(--row-gap) * {{ section.settings.psrch_grid_row_gap_percent }} / 100);
    }
  }

  #psrch-{{ psrch_sid }} .m-product-card {
    background: var(--psrch-card-bg) !important;
    border: 1px solid var(--psrch-card-border) !important;
    border-radius: var(--psrch-card-radius) !important;
    overflow: hidden;
    transition: border-color 0.24s ease, box-shadow 0.24s ease, transform 0.24s ease;
  }

  #psrch-{{ psrch_sid }} .m-product-card:hover {
    border-color: var(--psrch-card-border-hover) !important;
    box-shadow: 0 16px 40px -24px color-mix(in srgb, var(--psrch-card-shadow) 22%, transparent);
  }

  #psrch-{{ psrch_sid }} .m-product-card .m-product-card__media {
    border-radius: calc(var(--psrch-card-radius) - 2px) calc(var(--psrch-card-radius) - 2px) 0 0;
  }

  #psrch-{{ psrch_sid }} .m-article-card {
    background: var(--psrch-card-bg);
    border: 1px solid var(--psrch-card-border);
    border-radius: var(--psrch-card-radius);
    overflow: hidden;
    transition: border-color 0.24s ease, box-shadow 0.24s ease;
    height: 100%;
  }

  #psrch-{{ psrch_sid }} .m-article-card:hover {
    border-color: var(--psrch-card-border-hover);
    box-shadow: 0 16px 40px -24px color-mix(in srgb, var(--psrch-card-shadow) 22%, transparent);
  }

  #psrch-{{ psrch_sid }} .psrch__page-card {
    background: var(--psrch-card-bg);
    border: 1px solid var(--psrch-card-border);
    border-radius: var(--psrch-card-radius);
    padding: var(--psrch-page-card-pad);
    text-decoration: none;
    color: var(--psrch-title);
    transition: border-color 0.24s ease, box-shadow 0.24s ease;
    min-height: 140px;
  }

  #psrch-{{ psrch_sid }} .psrch__page-card:hover {
    border-color: var(--psrch-card-border-hover);
    box-shadow: 0 16px 40px -24px color-mix(in srgb, var(--psrch-card-shadow) 22%, transparent);
  }

  #psrch-{{ psrch_sid }} .m-search-item-page--badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--psrch-page-badge-bg);
    color: var(--psrch-page-badge-fg);
    margin-bottom: 0.5rem;
  }

  #psrch-{{ psrch_sid }} .m-search-item-page--title {
    color: var(--psrch-title);
    margin: 0;
  }

  #psrch-{{ psrch_sid }} .psrch__empty {
    color: var(--psrch-muted);
    font-size: var(--psrch-empty-fs);
    padding: 3rem 1rem;
  }

  #psrch-{{ psrch_sid }} .psrch__empty a {
    color: var(--psrch-empty-link);
    text-underline-offset: 0.18em;
  }

  #psrch-{{ psrch_sid }} .m-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: var(--psrch-pg-pt);
    margin-top: var(--psrch-pg-mt);
    border-top: var(--psrch-bar-border-w) solid var(--psrch-bar-border);
  }

  #psrch-{{ psrch_sid }} .m-pagination a,
  #psrch-{{ psrch_sid }} .m-pagination span {
    font-size: 0.8125rem;
    color: var(--psrch-pg-fg);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--psrch-pg-radius);
  }

  #psrch-{{ psrch_sid }} .m-pagination .current,
  #psrch-{{ psrch_sid }} .m-pagination .active,
  #psrch-{{ psrch_sid }} .m-pagination .page.current {
    background: var(--psrch-pg-cur-bg);
    color: var(--psrch-pg-cur-fg);
  }

  #psrch-{{ psrch_sid }} .m-pagination .disabled,
  #psrch-{{ psrch_sid }} .m-pagination .deco {
    color: var(--psrch-pg-disabled);
  }
{% endstyle %}
