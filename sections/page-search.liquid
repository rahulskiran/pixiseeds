<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sid = section.id | replace: '-', '' | truncate: 8, ''
  assign per_page = section.settings.products_per_page
  assign size_option_names = section.settings.size_option_names | default: 'Size,Pack,Pack Size,Weight,Volume'
  assign size_option_names_lower = size_option_names | downcase
  assign size_keys = size_option_names_lower | split: ','

  assign currency_code = cart.currency.iso_code
  assign threshold_amount_cents = section.settings.free_shipping_threshold | times: 100
-%}

<section
  class="pcol"
  id="pcol-{{ sid }}"
  data-section-id="{{ section.id }}"
  data-section-type="page-search"
  style="
    --pcol-bg: {{ section.settings.bg_color }};
    --pcol-cols-d: {{ section.settings.desktop_columns }};
    --pcol-cols-t: {{ section.settings.tablet_columns }};
    --pcol-cols-m: {{ section.settings.mobile_columns }};
    --pcol-gap-x: {{ section.settings.gap_x }}px;
    --pcol-gap-y: {{ section.settings.gap_y }}px;
    --pcol-pt-d: {{ section.settings.padding_top_desktop }}px;
    --pcol-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --pcol-pt-m: {{ section.settings.padding_top_mobile }}px;
    --pcol-pb-m: {{ section.settings.padding_bottom_mobile }}px;

    --pcol-card-bg: {{ section.settings.card_bg }};
    --pcol-card-border: {{ section.settings.card_border }};
    --pcol-card-border-hover: {{ section.settings.card_border_hover }};
    --pcol-card-shadow: {{ section.settings.card_shadow_color }};
    --pcol-card-radius: {{ section.settings.card_radius }}px;
    --pcol-card-image-radius: {{ section.settings.card_image_radius }}px;
    --pcol-card-image-ratio: {{ section.settings.card_image_ratio }};
    --pcol-card-pad-x: {{ section.settings.card_padding_x }}px;
    --pcol-card-pad-y: {{ section.settings.card_padding_y }}px;
    --pcol-card-gap: {{ section.settings.card_gap }}px;

    --pcol-title-fg: {{ section.settings.title_color }};
    --pcol-title-fs: {{ section.settings.title_font_size }}px;
    --pcol-title-fw: {{ section.settings.title_font_weight }};
    --pcol-vendor-fg: {{ section.settings.vendor_color }};

    --pcol-price-fg: {{ section.settings.price_color }};
    --pcol-price-sale-fg: {{ section.settings.price_sale_color }};
    --pcol-price-was-fg: {{ section.settings.price_was_color }};
    --pcol-price-save-bg: {{ section.settings.price_save_bg }};
    --pcol-price-save-fg: {{ section.settings.price_save_fg }};
    --pcol-price-fs: {{ section.settings.price_font_size }}px;

    --pcol-star-on: {{ section.settings.star_filled_color }};
    --pcol-star-off: {{ section.settings.star_empty_color }};
    --pcol-rcount-fg: {{ section.settings.rating_count_color }};

    --pcol-badge-radius: {{ section.settings.badge_radius }}px;
    --pcol-badge-fs: {{ section.settings.badge_font_size }}px;
    --pcol-badge-pv: {{ section.settings.badge_padding_y }}px;
    --pcol-badge-ph: {{ section.settings.badge_padding_x }}px;
    --pcol-badge-sale-bg: {{ section.settings.badge_sale_bg }};
    --pcol-badge-sale-fg: {{ section.settings.badge_sale_fg }};
    --pcol-badge-best-bg: {{ section.settings.badge_best_bg }};
    --pcol-badge-best-fg: {{ section.settings.badge_best_fg }};
    --pcol-badge-new-bg: {{ section.settings.badge_new_bg }};
    --pcol-badge-new-fg: {{ section.settings.badge_new_fg }};
    --pcol-badge-out-bg: {{ section.settings.badge_out_bg }};
    --pcol-badge-out-fg: {{ section.settings.badge_out_fg }};

    --pcol-wish-bg: {{ section.settings.wish_bg }};
    --pcol-wish-fg: {{ section.settings.wish_icon_color }};
    --pcol-wish-border: {{ section.settings.wish_border }};
    --pcol-wish-active-bg: {{ section.settings.wish_active_bg }};
    --pcol-wish-active-fg: {{ section.settings.wish_active_icon_color }};
    --pcol-wish-size: {{ section.settings.wish_size }}px;

    --pcol-qv-bg: {{ section.settings.qv_bg }};
    --pcol-qv-fg: {{ section.settings.qv_fg }};

    --pcol-atc-bg: {{ section.settings.atc_bg }};
    --pcol-atc-fg: {{ section.settings.atc_fg }};
    --pcol-atc-border: {{ section.settings.atc_border }};
    --pcol-atc-hover-bg: {{ section.settings.atc_hover_bg }};
    --pcol-atc-hover-fg: {{ section.settings.atc_hover_fg }};
    --pcol-atc-success-bg: {{ section.settings.atc_success_bg }};
    --pcol-atc-success-fg: {{ section.settings.atc_success_fg }};
    --pcol-atc-radius: {{ section.settings.atc_radius }}px;
    --pcol-atc-pv: {{ section.settings.atc_padding_y }}px;
    --pcol-atc-ph: {{ section.settings.atc_padding_x }}px;
    --pcol-atc-fs: {{ section.settings.atc_font_size }}px;

    --pcol-size-bg: {{ section.settings.size_bg }};
    --pcol-size-fg: {{ section.settings.size_fg }};
    --pcol-size-border: {{ section.settings.size_border }};
    --pcol-size-out-fg: {{ section.settings.size_out_color }};
    --pcol-size-radius: {{ section.settings.size_radius }}px;
    --pcol-size-fs: {{ section.settings.size_font_size }}px;
    --pcol-size-pv: {{ section.settings.size_padding_y }}px;
    --pcol-size-ph: {{ section.settings.size_padding_x }}px;

    --pcol-swatch-size: {{ section.settings.swatch_size }}px;
    --pcol-swatch-border: {{ section.settings.swatch_border }};

    --pcol-urgency-fg: {{ section.settings.urgency_text_color }};
    --pcol-urgency-dot: {{ section.settings.urgency_dot_color }};

    --pcol-chip-fg: {{ section.settings.chip_text_color }};

    --pcol-pg-fg: {{ section.settings.pagination_text_color }};
    --pcol-pg-cur-bg: {{ section.settings.pagination_current_bg }};
    --pcol-pg-cur-fg: {{ section.settings.pagination_current_fg }};
    --pcol-pg-disabled: {{ section.settings.pagination_disabled_color }};

    --pcol-sb-bg: {{ section.settings.shipping_bar_bg }};
    --pcol-sb-fg: {{ section.settings.shipping_bar_fg }};

    --pcol-tb-count-fg: {{ section.settings.toolbar_count_color }};
    --pcol-tb-muted-fg: {{ section.settings.toolbar_muted_color }};
    --pcol-tb-border: {{ section.settings.toolbar_border_color }};
    --pcol-tb-sort-bg: {{ section.settings.toolbar_sort_bg }};
    --pcol-tb-sort-fg: {{ section.settings.toolbar_sort_fg }};
    --pcol-tb-sort-border: {{ section.settings.toolbar_sort_border }};
    --pcol-tb-sort-radius: {{ section.settings.toolbar_sort_radius }}px;
    --pcol-tb-sort-focus: {{ section.settings.toolbar_sort_focus_color }};

    --pcol-empty-link: {{ section.settings.empty_link_color }};

    --pcol-bar-bg: {{ section.settings.bar_bg }};
    --pcol-bar-border: {{ section.settings.bar_border }};
    --pcol-bar-filter-bg: {{ section.settings.bar_filter_bg }};
    --pcol-bar-filter-fg: {{ section.settings.bar_filter_fg }};
    --pcol-bar-filter-border: {{ section.settings.bar_filter_border }};
    --pcol-bar-filter-active-bg: {{ section.settings.bar_filter_active_bg }};
    --pcol-bar-filter-active-fg: {{ section.settings.bar_filter_active_fg }};
    --pcol-bar-chip-bg: {{ section.settings.bar_chip_bg }};
    --pcol-bar-chip-fg: {{ section.settings.bar_chip_fg }};
    --pcol-bar-chip-border: {{ section.settings.bar_chip_border }};
    --pcol-drawer-bg: {{ section.settings.drawer_bg }};
    --pcol-drawer-border: {{ section.settings.drawer_border }};
    --pcol-drawer-label-fg: {{ section.settings.drawer_label_fg }};
    --pcol-drawer-check-accent: {{ section.settings.drawer_check_accent }};
    --pcol-drawer-apply-bg: {{ section.settings.drawer_apply_bg }};
    --pcol-drawer-apply-fg: {{ section.settings.drawer_apply_fg }};
    --pcol-drawer-clear-fg: {{ section.settings.drawer_clear_fg }};
    --pcol-view-active-bg: {{ section.settings.view_toggle_active_bg }};
    --pcol-view-active-fg: {{ section.settings.view_toggle_active_fg }};

    --pcol-inner-max: {% if section.settings.content_width == 'full' %}none{% else %}{{ section.settings.inner_max_width }}px{% endif %};
    --pcol-pl: {{ section.settings.padding_left }}px;
    --pcol-pr: {{ section.settings.padding_right }}px;
    --pcol-pl-m: {{ section.settings.padding_left_mobile }}px;
    --pcol-pr-m: {{ section.settings.padding_right_mobile }}px;
  "
>
  {%- if section.settings.show_shipping_bar and section.settings.free_shipping_threshold > 0 -%}
    <div class="pcol__ship-bar" role="status" aria-live="polite">
      <span class="pcol__ship-icon" aria-hidden="true">✦</span>
      <span class="pcol__ship-text">
        {{- section.settings.shipping_bar_text | replace: '[amount]', section.settings.free_shipping_threshold | append: ' ' | append: currency_code -}}
      </span>
    </div>
  {%- endif -%}

  <div class="pcol__inner">
    <div class="pcol__search-hero">
      {%- if search.performed -%}
        <h1 class="pcol__search-title">{{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}</h1>
      {%- else -%}
        <h1 class="pcol__search-title">{{ 'general.search.search' | t }}</h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by per_page -%}
        {%- render 'premium-search-toolbar', search: search, section: section, sid: sid -%}
        <ul class="pcol__grid" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'premium-collection-product-card',
                product: item,
                section: section,
                size_keys: size_keys,
                threshold_amount_cents: threshold_amount_cents
              -%}
            {%- endif -%}
          {%- else -%}
            <li class="pcol__empty">
              <p>{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
              {%- assign search_q_enc = search.terms | url_encode -%}
              {%- assign search_clear = routes.search_url | append: '?q=' | append: search_q_enc | append: '&options%5Bprefix%5D=last' -%}
              <a class="pcol__empty-link" href="{{ search_clear }}">{{ 'general.search.search' | t }}</a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pcol__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="pcol__pg pcol__pg--prev" href="{{ paginate.previous.url }}" rel="prev">← Prev</a>
            {%- else -%}
              <span class="pcol__pg pcol__pg--prev is-disabled">← Prev</span>
            {%- endif -%}

            <div class="pcol__pg-nums">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="pcol__pg-num" href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="pcol__pg-num is-current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="pcol__pg-num is-ellipsis">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.next -%}
              <a class="pcol__pg pcol__pg--next" href="{{ paginate.next.url }}" rel="next">Next →</a>
            {%- else -%}
              <span class="pcol__pg pcol__pg--next is-disabled">Next →</span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

<style>
  {% render 'premium-collection-styles', sid: sid %}
</style>

{% render 'premium-collection-interactive', sid: sid %}


{% schema %}
{
  "name": "Page search (Premium)",
  "tag": "section",
  "class": "section-premium-search",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Columns (tablet)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap_x",
      "label": "Horizontal gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_y",
      "label": "Vertical gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "default": "contained",
      "options": [
        { "value": "contained", "label": "Contained (max inner width)" },
        { "value": "full", "label": "Full width (grid uses full viewport)" }
      ],
      "info": "Full width removes the inner max-width so content can span edge to edge. Use horizontal padding to keep gutters."
    },
    {
      "type": "range",
      "id": "inner_max_width",
      "label": "Inner max width",
      "min": 1000,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1440,
      "info": "Only used when Section width is Contained."
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Horizontal padding — left (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Horizontal padding — right (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Horizontal padding — left (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Horizontal padding — right (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Card design"
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Tall (3:4)" },
        { "value": "5 / 4", "label": "Landscape (5:4)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_padding_x",
