    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#fdfaf7"
    },
    {
      "type": "header",
      "content": "Card colours"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border",
