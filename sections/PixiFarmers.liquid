{%- liquid
  assign section_animation = section.settings.animations | default: 'inherit'
  assign animation_effect = settings.animations
  if section_animation != 'inherit'
    assign animation_effect = section_animation
  endif
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign bg_image = section.settings.background_image
  assign has_bg = false
  if bg_image != blank
    assign has_bg = true
  endif

  assign column_count = section.blocks.size
  if column_count < 1
    assign column_count = 1
  endif
  if column_count > 4
    assign column_count = 4
  endif

  assign style = section.settings.layout_style | default: 'minimal'
-%}

{% style %}
  .m-pixi-farmers--{{ section.id }} {
    --pf-heading-color: {{ section.settings.heading_color }};
    --pf-text-color: {{ section.settings.text_color }};
    --pf-accent: {{ section.settings.accent_color }};
    --pf-icon-bg: {{ section.settings.icon_background }};
    --pf-icon-border: {{ section.settings.icon_border_color }};
    --pf-divider: {{ section.settings.divider_color }};
    --pf-card-bg: {{ section.settings.card_background }};
    --pf-rule: color-mix(in srgb, {{ section.settings.divider_color }} 16%, transparent);
    --pf-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --pf-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --pf-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --pf-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --pf-icon-size: {{ section.settings.icon_size }}px;
    --pf-gap: {{ section.settings.column_gap_mobile }}px;
    --pf-columns: {{ column_count }};
    --pf-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', section.settings.overlay_opacity | divided_by: 100.0 }};
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 990px) {
    .m-pixi-farmers--{{ section.id }} {
      --pf-gap: {{ section.settings.column_gap_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} .m-pixi-farmers {
    position: relative;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .m-pixi-farmers {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position }};
    display: block;
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--pf-overlay);
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__inner {
    position: relative;
    z-index: 1;
  }

  /* ---- Header ---- */

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__header {
    text-align: center;
    margin: 0 auto {{ section.settings.heading_spacing }}px;
    max-width: 46ch;
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__eyebrow {
    display: block;
    margin: 0 0 14px;
    font-family: var(--font-stack-body);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pf-accent);
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__heading {
    margin: 0;
    font-family: var(--font-stack-header);
    font-weight: {{ section.settings.heading_weight }};
    font-size: var(--pf-heading-size-mobile);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: var(--pf-heading-color);
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__subheading {
    margin: 14px 0 0;
    font-family: var(--font-stack-body);
    font-size: var(--pf-body-size-mobile);
    line-height: 1.6;
    font-weight: 400;
    color: var(--pf-text-color);
    opacity: 0.85;
  }

  @media screen and (min-width: 990px) {
    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__heading {
      font-size: var(--pf-heading-size-desktop);
    }

    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__subheading {
      font-size: var(--pf-body-size-desktop);
    }
  }

  /* ---- Grid ---- */

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pf-gap);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    max-width: 1080px;
  }

  @media screen and (min-width: 750px) {
    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__grid {
      grid-template-columns: repeat(min(var(--pf-columns), 2), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__grid {
      grid-template-columns: repeat(var(--pf-columns), minmax(0, 1fr));
    }
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }

  /* Minimal: hairline rules instead of card chrome */

  .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__grid {
    gap: 0;
  }

  .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item {
    padding: 34px 24px;
  }

  .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item + .m-pixi-farmers__item::before {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    top: 0;
    height: 1px;
    background: var(--pf-rule);
  }

  @media screen and (min-width: 750px) {
    .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item {
      padding: 8px calc(var(--pf-gap) / 2);
    }

    .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item + .m-pixi-farmers__item::before {
      left: 0;
      right: auto;
      top: 6%;
      bottom: 6%;
      width: 1px;
      height: auto;
    }
  }

  {%- comment -%}
    Two-column range: only even items sit in the second column, so the vertical
    rule must skip anything that wraps to the start of a row.
  {%- endcomment -%}
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item:nth-child(odd)::before {
      display: none;
    }

    .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item:nth-child(n + 3)::after {
      content: "";
      position: absolute;
      left: 12%;
      right: 12%;
      top: 0;
      height: 1px;
      background: var(--pf-rule);
    }

    .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--minimal .m-pixi-farmers__item {
      padding-top: 32px;
      padding-bottom: 32px;
    }
  }

  /* Cards */

  .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--card .m-pixi-farmers__item {
    padding: 40px 28px;
    background: var(--pf-card-bg);
    border: 1px solid var(--pf-rule);
    border-radius: {{ section.settings.card_radius }}px;
    transition: border-color 0.4s ease;
  }

  .m-pixi-farmers--{{ section.id }}.m-pixi-farmers--card .m-pixi-farmers__item:hover {
    border-color: color-mix(in srgb, var(--pf-accent) 45%, transparent);
  }

  /* ---- Icon ---- */

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__icon-wrap {
    width: var(--pf-icon-size);
    height: var(--pf-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--pf-accent);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__item:hover .m-pixi-farmers__icon-wrap {
    transform: translateY(-3px);
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__icon-img,
  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__icon-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ---- Copy ---- */

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__title {
    margin: 0;
    font-family: var(--font-stack-body);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pf-heading-color);
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__title + .m-pixi-farmers__text {
    margin-top: -8px;
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__text {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-stack-body);
    font-size: var(--pf-body-size-mobile);
    line-height: 1.65;
    font-weight: {{ section.settings.body_weight }};
    color: var(--pf-text-color);
  }

  @media screen and (min-width: 990px) {
    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__text {
      font-size: var(--pf-body-size-desktop);
      max-width: 26ch;
    }
  }

  .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__divider {
    width: 100%;
    max-width: 1080px;
    height: 1px;
    margin: {{ section.settings.divider_spacing }}px auto 0;
    border: 0;
    background: var(--pf-rule);
  }

  @media (prefers-reduced-motion: reduce) {
    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__icon-wrap,
    .m-pixi-farmers--{{ section.id }} .m-pixi-farmers__item {
      transition: none;
    }
  }
{% endstyle %}

<section class="m-section m-pixi-farmers m-pixi-farmers--{{ section.id }} m-pixi-farmers--{{ style }}">
  {%- if has_bg -%}
    <div class="m-pixi-farmers__bg" aria-hidden="true">
      {{
        bg_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="m-page-width m-pixi-farmers__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="m-pixi-farmers__header{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="m-pixi-farmers__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag | default: 'h2' }} class="m-pixi-farmers__heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag | default: 'h2' }}>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="m-pixi-farmers__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="m-pixi-farmers__grid" role="list">
        {%- for block in section.blocks -%}
          <li
            class="m-pixi-farmers__item{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
            {{ block.shopify_attributes }}
            {% if animated %}
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="m-pixi-farmers__icon-wrap">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    class: 'm-pixi-farmers__icon-img',
                    widths: '120, 180, 240, 320, 400',
                    sizes: '120px',
                    alt: block.settings.text | escape
                }}
              {%- else -%}
                {%- case block.settings.icon_style -%}
                  {%- when 'non_gmo' -%}
                    {%- comment -%} Sprout: two leaves rising from a single stem {%- endcomment -%}
                    <svg class="m-pixi-farmers__icon-svg" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M32 54V26" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                      <path d="M32 30C32 22 26 15 17 14C17 23 23 30 32 30Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                      <path d="M32 34C32 26 38 19 47 18C47 27 41 34 32 34Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                      <path d="M22 54H42" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity="0.45"/>
                    </svg>
                  {%- when 'non_neonic' -%}
                    {%- comment -%} Guidance: seedling under a watchful arc {%- endcomment -%}
                    <svg class="m-pixi-farmers__icon-svg" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M12 34C12 22.9543 20.9543 14 32 14C43.0457 14 52 22.9543 52 34" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                      <path d="M32 52V36" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                      <path d="M32 40C32 34.4772 27.5228 30 22 30C22 35.5228 26.4772 40 32 40Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                      <path d="M32 38C32 33.5817 35.5817 30 40 30C40 34.4183 36.4183 38 32 38Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                      <circle cx="32" cy="9" r="1.5" fill="currentColor"/>
                    </svg>
                  {%- when 'seed_care' -%}
                    {%- comment -%} Care: a seed cradled in an open hand {%- endcomment -%}
                    <svg class="m-pixi-farmers__icon-svg" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M10 38C10 38 18 50 32 50C46 50 54 38 54 38" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                      <ellipse cx="32" cy="30" rx="7" ry="10" stroke="currentColor" stroke-width="1.25"/>
                      <path d="M32 34V22" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity="0.5"/>
                      <path d="M26 15L32 10L38 15" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
                    </svg>
                  {%- else -%}
                    <svg class="m-pixi-farmers__icon-svg" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="32" cy="32" r="21" stroke="currentColor" stroke-width="1.25"/>
                      <path d="M22 32H42M32 22V42" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <p class="m-pixi-farmers__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="m-pixi-farmers__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_divider -%}
      <hr class="m-pixi-farmers__divider" aria-hidden="true">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pixi Farmers promise",
  "tag": "section",
  "class": "m-pixi-farmers-section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We are Pixi Farmers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Seeds chosen, tested and packed by people who grow them."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        { "value": "minimal", "label": "Minimal (hairline dividers)" },
        { "value": "card", "label": "Cards" }
      ],
      "default": "minimal"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. A soft overlay keeps text readable."
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay tint",
      "default": "#faf8f5"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3a1705"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#7a6455"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / icon color",
      "default": "#a03f0b"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Used with the Cards layout only.",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon badge fill",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon badge border",
      "default": "#a03f0b"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Rule / divider color",
      "default": "#3a1705"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_weight",
      "min": 400,
      "max": 800,
      "step": 100,
      "label": "Heading weight",
      "default": 500
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body size (desktop)",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "label": "Body weight",
      "default": 400
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 64
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Column gap (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show bottom divider line",
      "default": false
    },
    {
      "type": "range",
      "id": "divider_spacing",
