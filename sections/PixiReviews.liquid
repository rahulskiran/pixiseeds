{%- liquid
  assign section_animation = section.settings.animations | default: 'inherit'
  assign animation_effect = settings.animations
  if section_animation != 'inherit'
    assign animation_effect = section_animation
  endif
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif
  if request.design_mode
    assign animated = false
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign columns = section.settings.columns | default: 3
-%}

{% style %}
  .m-rev--{{ section.id }} {
    --rev-bg: {{ section.settings.background_color }};
    --rev-ink: {{ section.settings.text_color }};
    --rev-muted: {{ section.settings.muted_color }};
    --rev-line: {{ section.settings.line_color }};
    --rev-accent: {{ section.settings.accent_color }};
    --rev-star: {{ section.settings.star_color }};
    --rev-radius: {{ section.settings.card_radius }}px;
    --rev-title-m: {{ section.settings.title_size_mobile }}px;
    --rev-title-d: {{ section.settings.title_size_desktop }}px;
    --rev-quote-m: {{ section.settings.quote_size_mobile }}px;
    --rev-quote-d: {{ section.settings.quote_size_desktop }}px;
    --rev-gap: {{ section.settings.card_gap }}px;
    --rev-cols: {{ columns }};
    background: var(--rev-bg);
    color: var(--rev-ink);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .m-rev--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .m-rev { position: relative; overflow: hidden; }
  .m-rev__inner { max-width: {{ section.settings.content_max_width }}px; margin: 0 auto; }

  /* ---------- header ---------- */
  .m-rev__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 40px;
  }
  .m-rev__eyebrow {
    margin: 0;
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--rev-muted);
    font-weight: 500;
  }
  .m-rev__heading {
    margin: 0;
    font-size: var(--rev-title-m);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: {{ section.settings.heading_weight }};
    max-width: 18ch;
  }
  .m-rev__intro {
    margin: 0;
    color: var(--rev-muted);
    font-size: 15px;
    line-height: 1.6;
    max-width: 46ch;
  }
  .m-rev__score {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--rev-muted);
    font-size: 13px;
    letter-spacing: .01em;
  }
  .m-rev__score b { color: var(--rev-ink); font-weight: 600; }
  .m-rev__score-sep { width: 1px; height: 12px; background: var(--rev-line); display: inline-block; }

  @media screen and (min-width: 990px) {
    .m-rev__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 48px;
      padding-bottom: 56px;
    }
    .m-rev__head-left { display: flex; flex-direction: column; gap: 16px; }
    .m-rev__head-right { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; padding-bottom: 4px; }
    .m-rev__heading { font-size: var(--rev-title-d); }
  }
  .m-rev--center .m-rev__head { align-items: center; text-align: center; flex-direction: column; }
  .m-rev--center .m-rev__heading,
  .m-rev--center .m-rev__intro { max-width: 24ch; margin-inline: auto; }
  .m-rev--center .m-rev__intro { max-width: 52ch; }
  .m-rev--center .m-rev__head-left,
  .m-rev--center .m-rev__head-right { align-items: center; }
  .m-rev--center .m-rev__score { justify-content: center; }

  /* ---------- track ---------- */
  .m-rev__viewport { margin-inline: calc(var(--rev-edge, 0px) * -1); }
  .m-rev__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(78%, 1fr);
    gap: var(--rev-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-inline: var(--rev-edge, 0px);
    padding-bottom: 2px;
  }
  .m-rev__track::-webkit-scrollbar { display: none; }
  .m-rev__item { scroll-snap-align: start; }

  @media screen and (min-width: 750px) {
    .m-rev__track { grid-auto-columns: minmax(46%, 1fr); }
  }
  @media screen and (min-width: 990px) {
    .m-rev__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--rev-cols), minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      padding-inline: 0;
    }
  }

  /* ---------- card ---------- */
  .m-rev__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: {{ section.settings.card_padding }}px;
    border: 1px solid var(--rev-line);
    border-radius: var(--rev-radius);
    background: {{ section.settings.card_background }};
    transition: border-color .35s ease, transform .35s ease, box-shadow .35s ease;
  }
  {% if section.settings.card_style == 'bare' %}
  .m-rev__card { border-color: transparent; background: transparent; padding-inline: 0; }
  .m-rev__card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: var(--rev-line);
  }
  @media screen and (min-width: 990px) {
    .m-rev__card { padding-right: var(--rev-gap); }
  }
  {% endif %}
  @media (hover: hover) {
    .m-rev__card:hover {
      border-color: {% if section.settings.card_style == 'bare' %}transparent{% else %}var(--rev-accent){% endif %};
      {% if section.settings.card_style != 'bare' %}transform: translateY(-2px);{% endif %}
    }
  }

  .m-rev__stars { display: inline-flex; gap: 3px; margin-bottom: 22px; }
  .m-rev__stars svg { width: 13px; height: 13px; display: block; }
  .m-rev__stars svg path { fill: var(--rev-star); }
  .m-rev__stars svg.is-off path { fill: var(--rev-line); }

  .m-rev__quote {
    margin: 0 0 auto;
    font-size: var(--rev-quote-m);
    line-height: 1.55;
    letter-spacing: -0.005em;
    font-weight: 400;
    color: var(--rev-ink);
    text-wrap: pretty;
  }
  .m-rev__quote p { margin: 0 0 .7em; }
  .m-rev__quote p:last-child { margin-bottom: 0; }
  @media screen and (min-width: 990px) {
    .m-rev__quote { font-size: var(--rev-quote-d); }
  }

  .m-rev__by {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--rev-line);
  }
  .m-rev__avatar {
    flex: 0 0 auto;
    width: 34px; height: 34px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--rev-bg);
    border: 1px solid var(--rev-line);
    font-size: 11px;
    letter-spacing: .06em;
    font-weight: 600;
    color: var(--rev-muted);
    text-transform: uppercase;
  }
  .m-rev__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .m-rev__name { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  .m-rev__role { margin: 2px 0 0; font-size: 12px; color: var(--rev-muted); line-height: 1.3; }
  .m-rev__verified {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    letter-spacing: .04em;
    color: var(--rev-muted);
    white-space: nowrap;
  }
  .m-rev__verified svg { width: 12px; height: 12px; }
  .m-rev__verified svg path { fill: var(--rev-accent); }

  /* ---------- controls ---------- */
  .m-rev__nav { display: flex; gap: 8px; }
  .m-rev__btn {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid var(--rev-line);
    background: transparent;
    color: var(--rev-ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
    transition: border-color .25s ease, background-color .25s ease, opacity .25s ease, color .25s ease;
  }
  .m-rev__btn svg { width: 14px; height: 14px; }
  .m-rev__btn svg path { stroke: currentColor; }
  .m-rev__btn:hover { border-color: var(--rev-accent); }
  .m-rev__btn[disabled] { opacity: .3; cursor: default; }
  .m-rev__btn[disabled]:hover { border-color: var(--rev-line); }
  @media screen and (min-width: 990px) {
    .m-rev--has-grid .m-rev__nav { display: none; }
  }

  .m-rev__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 32px;
  }
  .m-rev__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    letter-spacing: .02em;
    color: var(--rev-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rev-line);
    padding-bottom: 4px;
    transition: border-color .25s ease;
  }
  .m-rev__cta:hover { border-color: var(--rev-accent); }
  .m-rev__foot:only-child { justify-content: flex-end; }

  /* ---------- motion ---------- */
  .m-rev__reveal { opacity: 0; transform: translateY(14px); }
  .m-rev.is-visible .m-rev__reveal {
    opacity: 1;
    transform: none;
    transition: opacity .7s cubic-bezier(.22,.61,.36,1), transform .7s cubic-bezier(.22,.61,.36,1);
  }
  .m-rev.is-visible .m-rev__item:nth-child(2) .m-rev__reveal { transition-delay: .08s; }
  .m-rev.is-visible .m-rev__item:nth-child(3) .m-rev__reveal { transition-delay: .16s; }
  .m-rev.is-visible .m-rev__item:nth-child(4) .m-rev__reveal { transition-delay: .24s; }
  .m-rev.is-visible .m-rev__item:nth-child(5) .m-rev__reveal { transition-delay: .32s; }
  .m-rev.is-visible .m-rev__item:nth-child(6) .m-rev__reveal { transition-delay: .4s; }
  @media (prefers-reduced-motion: reduce) {
    .m-rev__reveal { opacity: 1; transform: none; }
    .m-rev__track { scroll-behavior: auto; }
  }
{% endstyle %}

{%- capture star_full -%}
<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 .8l2.1 4.6 5 .5-3.7 3.4 1 4.9L8 11.7 3.6 14.2l1-4.9L.9 5.9l5-.5z"/></svg>
{%- endcapture -%}
{%- capture star_off -%}
<svg class="is-off" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 .8l2.1 4.6 5 .5-3.7 3.4 1 4.9L8 11.7 3.6 14.2l1-4.9L.9 5.9l5-.5z"/></svg>
{%- endcapture -%}

<section
  class="m-section m-rev m-rev--{{ section.id }} m-rev--{{ section.settings.header_alignment }}{% if section.blocks.size <= columns %} m-rev--has-grid{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="pixi-reviews"
>
  <div class="m-page-width">
    <div class="m-rev__inner">
      <div class="m-rev__head">
        <div class="m-rev__head-left m-rev__reveal">
          {%- if section.settings.eyebrow != blank -%}
            <p class="m-rev__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} class="m-rev__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="m-rev__intro">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>

        <div class="m-rev__head-right m-rev__reveal">
          {%- if section.settings.show_score -%}
            <div class="m-rev__score">
              <span class="m-rev__stars" aria-hidden="true">
                {%- for i in (1..5) -%}{{ star_full }}{%- endfor -%}
              </span>
              <b>{{ section.settings.score_value | escape }}</b>
              <span class="m-rev__score-sep" aria-hidden="true"></span>
              <span>{{ section.settings.score_label | escape }}</span>
            </div>
          {%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <div class="m-rev__nav" data-rev-nav>
              <button class="m-rev__btn" type="button" data-rev-prev aria-label="{{ 'general.slider.previous' | t | default: 'Previous' }}">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 2L4 8l6 6" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="m-rev__btn" type="button" data-rev-next aria-label="{{ 'general.slider.next' | t | default: 'Next' }}">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 2l6 6-6 6" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="m-rev__viewport">
        <div class="m-rev__track" data-rev-track>
          {%- for block in section.blocks -%}
            <div class="m-rev__item" {{ block.shopify_attributes }}>
              <article class="m-rev__card m-rev__reveal">
                {%- if block.settings.rating > 0 -%}
                  <div class="m-rev__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.rating -%}{{ star_full }}{%- else -%}{{ star_off }}{%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.quote != blank -%}
                  <blockquote class="m-rev__quote">{{ block.settings.quote }}</blockquote>
                {%- endif -%}

                {%- if block.settings.name != blank or block.settings.role != blank -%}
                  <footer class="m-rev__by">
                    {%- if section.settings.show_avatar -%}
                      <span class="m-rev__avatar" aria-hidden="true">
                        {%- if block.settings.avatar != blank -%}
                          {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
                        {%- else -%}
                          {{ block.settings.name | strip | split: ' ' | first | slice: 0 }}{% assign parts = block.settings.name | strip | split: ' ' %}{% if parts.size > 1 %}{{ parts | last | slice: 0 }}{% endif %}
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                    <div>
                      {%- if block.settings.name != blank -%}
                        <p class="m-rev__name">{{ block.settings.name | escape }}</p>
                      {%- endif -%}
                      {%- if block.settings.role != blank -%}
                        <p class="m-rev__role">{{ block.settings.role | escape }}</p>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.verified -%}
                      <span class="m-rev__verified">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0l1.9 1.2L12.1 1l.9 2.1 2 1-.4 2.2 1.4 1.7-1.4 1.7.4 2.2-2 1-.9 2.1-2.2-.2L8 16l-1.9-1.2-2.2.2-.9-2.1-2-1 .4-2.2L0 8l1.4-1.7-.4-2.2 2-1L3.9 1l2.2.2zM7 10.9l4.2-4.2-1.1-1.1L7 8.7 5.6 7.3 4.5 8.4z"/></svg>
                        {{ section.settings.verified_label | escape }}
                      </span>
                    {%- endif -%}
                  </footer>
                {%- endif -%}
              </article>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.cta_label != blank -%}
        <div class="m-rev__foot m-rev__reveal">
          <a class="m-rev__cta" href="{{ section.settings.cta_link | default: '#' }}">
            {{ section.settings.cta_label | escape }}
            <svg viewBox="0 0 16 16" fill="none" width="12" height="12" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('.m-rev--{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('[data-rev-track]');
    var prev = root.querySelector('[data-rev-prev]');
    var next = root.querySelector('[data-rev-next]');

    function step() {
      var first = track.querySelector('.m-rev__item');
      if (!first) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.getBoundingClientRect().width + gap;
    }

    function sync() {
      if (!prev || !next) return;
      var max = track.scrollWidth - track.clientWidth - 1;
      var scrollable = max > 1;
      prev.disabled = !scrollable || track.scrollLeft <= 1;
      next.disabled = !scrollable || track.scrollLeft >= max;
    }

    if (prev && next) {
      prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            root.classList.add('is-visible');
            io.disconnect();
          }
        });
      }, { threshold: 0.15 });
      io.observe(root);
    } else {
      root.classList.add('is-visible');
    }
  })();
</script>

{% schema %}
{
  "name": "Premium reviews",
  "tag": "section",
  "class": "m-section-pixi-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by growers everywhere"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Real notes from the people growing with our seeds."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "split", "label": "Split (left + right)" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Read all reviews"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Rating summary"
    },
    {
      "type": "checkbox",
      "id": "show_score",
      "label": "Show rating summary",
      "default": true
    },
    {
      "type": "text",
      "id": "score_value",
      "label": "Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "score_label",
      "label": "Score caption",
      "default": "Based on 1,200+ verified orders"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified badge label",
      "default": "Verified"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "outlined", "label": "Outlined card" },
        { "value": "bare", "label": "Hairline (no box)" }
      ],
      "default": "outlined"
    },
    {
      "type": "checkbox",
      "id": "show_avatar",
      "label": "Show avatar",
      "default": true
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Heading size (mobile)",
      "min": 24,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Heading size (desktop)",
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading weight",
      "min": 300,
      "max": 800,
      "step": 100,
      "default": 500
    },
    {
      "type": "range",
      "id": "quote_size_mobile",
      "label": "Quote size (mobile)",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "quote_size_desktop",
      "label": "Quote size (desktop)",
