{{ 'section-product-tabs.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{% liquid
  assign items_per_row = section.settings.items_per_row
  assign product_to_show = section.settings.product_to_show | default: 8
  assign enable_slider = section.settings.enable_slider
  assign mobile_layout = section.settings.mobile_layout
  if enable_slider and mobile_layout == 'inherit'
    assign mobile_layout = 'slider'
  endif

  assign show_pagination = section.settings.show_pagination
  assign show_navigation = section.settings.show_navigation
  assign navigation_position = section.settings.navigation_position
  assign pagination_type = 'fraction'

  assign card_style = section.settings.pcard_layout
  assign image_ratio = section.settings.pcard_image_ratio
  assign show_vendor = section.settings.show_vendor

  assign enable_swipe_mobile = section.settings.enable_swipe_mobile

  assign card_bordered = false
  if section.settings.boxed_layout and section.settings.grid_bordered
    assign card_bordered = true
  endif

  assign tablet_items = items_per_row | at_most: 3
  assign laptop_items = items_per_row | at_most: 4

  assign card_style = section.settings.pcard_layout
  if card_style == null or card_style == blank
    assign card_style = settings.pcard_layout
  endif

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign tab_header_style = section.settings.tab_header_style

  assign image_card = section.blocks | where: 'type', 'image_card'

  if image_card.size > 0
    assign tablet_items = tablet_items | minus: 1 | at_least: 2
    assign laptop_items = laptop_items | minus: 1 | at_least: 2
  endif

  assign pc_scheme = settings.pcard_color_scheme
  if section.settings.pt_use_pcard_scheme
    assign pc_scheme = section.settings.pt_pcard_color_scheme
  endif

  assign pc_align = settings.pcard_alignment
  if section.settings.pt_pcard_text_align != 'inherit'
    assign pc_align = section.settings.pt_pcard_text_align
  endif

  assign pt_card_border_setting = section.settings.pt_card_border | default: 'inherit'
%}
<section
  class="m-section m-section--padding{% if image_card.size > 0 %} m-product-tabs--has-banner{% endif %}{% if section.settings.boxed_layout %} m-section--boxed{% if section.settings.grid_bordered %} m-section--grid-bordered{% endif %}{% endif %}{% if section.settings.header_divider %} m-section--header-separated{% endif %} m-gradient m-color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}"
  data-product-card-style="{{ card_style }}"
  style="
    --column-gap: {{ section.settings.column_gap }}px;
    --column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --row-gap: {{ section.settings.row_gap }}px;
    --row-gap-mobile: {{ section.settings.row_gap_mobile }}px;
    --items: {{ items_per_row }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="m-page-width">
    <product-tabs
      class="m-product-tabs m-section__wrapper{% if section.settings.boxed_layout %} m-gradient m-color-{{ section.settings.boxed_color_scheme }}{% endif %}"
      data-url="{{ routes.search_url }}?section_id={{ section.id }}&type=product&q="
      data-product-to-show="{{ product_to_show }}"
      data-items="{{ items_per_row }}"
      data-laptop-items="{{ laptop_items }}"
      data-tablet-items="{{ tablet_items }}"
      data-mobile-items="2"
      data-show-pagination="{{ show_pagination }}"
      data-show-navigation="{{ show_navigation }}"
      data-pagination-type="{{ pagination_type }}"
      data-mobile-layout="{{ mobile_layout }}"
      data-section-id="{{ section.id }}"
    >
      <div class="m-section__header m-section__header--style-{{ tab_header_style }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="m-section__heading {{ section.settings.heading_size }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        <div class="m-product-tabs__buttons m:display-flex{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
          <div class="m-product-tabs__buttons-inner m-product-tabs__buttons--style-{{ tab_header_style }}">
            {%- for block in section.blocks -%}
              {% liquid 
                assign current_collection = collections[block.settings.collection]
                assign image_alt = block.settings.icon.alt | default: current_collection.title | escape
              %}
              {%- if block.type == 'tab' and block.settings.heading != blank -%}
                <button
                  data-tab-index="{{ forloop.index0 }}"
                  class="m-product-tabs__button{% if block.settings.icon_svg != blank or block.settings.icon != blank %} m-product-tabs__button-has-icon{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.icon_svg != blank or block.settings.icon != blank -%}
                    <span
                      class="m-product-tabs__button-icon"
                      style="--icon-width: {{ block.settings.icon_image_width }}px;"
                    >
                      {%- if block.settings.icon_svg != blank -%}
                        {{ block.settings.icon_svg }}
                      {%- else -%}
                        {%- assign image_width = block.settings.icon_image_width -%}
                        {%- assign image_height = image_width | divided_by: block.settings.icon.aspect_ratio -%}
                        {% capture sizes %}(max-width: {{ image_width | times: 2 }}px) 50vw, {{ image_width }}px{% endcapture %}
                        {% capture widths %}{{ image_width }}, {{ image_width | times: 1.5 | round }}, {{ image_width | times: 2 }}{% endcapture %}
                        {{
                          block.settings.icon
                          | image_url: width: 600
                          | image_tag:
                            class: 'header__heading-logo',
                            widths: widths,
                            height: image_height,
                            width: settings.logo_width,
                            alt: image_alt,
                            sizes: sizes,
                            preload: true
                        }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <span class="m-product-tabs__button-text">{{ block.settings.heading }}</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="m-product-tabs__contents m-section__content">
        {% if image_card.size > 0 %}
          {{ 'component-image-card.css' | asset_url | stylesheet_tag }}
          {% render 'image-card', block: image_card[0], animated: animated, animation_effect: animation_effect %}
        {% endif %}
      </div>
      <template>
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            {%- liquid
              assign current_collection = collections[block.settings.collection]
              assign enable_slider = section.settings.enable_slider

              if current_collection != blank
                if product_to_show <= items_per_row or current_collection.products.size <= items_per_row
                  assign enable_slider = false
                endif
              else
                if product_to_show <= items_per_row
                  assign enable_slider = false
                endif
              endif
            -%}
            <div
              class="m-product-tabs__content m-product-tabs__inner m-mixed-layout{% if mobile_layout != 'slider' %} m-mixed-layout--mobile-grid{% if enable_swipe_mobile %} m-mixed-layout--mobile-scroll{% endif %}{% endif %}"
              data-tab-index="{{ forloop.index0 }}"
              data-enable-slider="{{ enable_slider }}"
              {{ block.shopify_attributes }}
            >
              <div class="m-mixed-layout__wrapper{% if enable_slider %} swiper swiper--equal-height{% endif %}">
                <div
                  class="m-mixed-layout__inner m:grid md:m:grid-{{ tablet_items }}-cols lg:m:grid-{{ laptop_items }}-cols xl:m:grid-{{ items_per_row }}-cols{% if enable_slider %} swiper-wrapper{% endif %}"
                  {% if section.settings.mobile_layout != 'inherit' %}
                    style="
                      --grid-columns-mobile: {{ section.settings.mobile_layout | replace: 'col-1', '1' | replace: 'col-2', '2' }};
                      --mobile-column-width: {{ section.settings.mobile_layout | replace: 'col-1', '66.66vw' | replace: 'col-2', '40vw' }};
                    "
                  {% endif %}
                >
                  {%- if current_collection != blank and current_collection.products.size > 0 -%}
                    {% for product in current_collection.products limit: product_to_show %}
                      <div class="m:column{% if enable_slider %} swiper-slide{% endif %}">
                        {% render 'product-tabs-card',
                          card_style: card_style,
                          product: product,
                          image_ratio: image_ratio,
                          card_bordered: card_bordered,
                          card_border_setting: pt_card_border_setting,
                          show_vendor: show_vendor,
                          index: forloop.index,
                          animated: animated,
                          animation_effect: animation_effect,
                          color_scheme: pc_scheme,
                          pcard_alignment: pc_align
                        %}
                      </div>
                    {% endfor %}
                  {%- else -%}
                    {% for i in (1..product_to_show) %}
                      <div class="m:column{% if enable_slider %} swiper-slide{% endif %}">
                        {% render 'product-tabs-placeholder',
                          card_bordered: card_bordered,
                          card_border_setting: pt_card_border_setting,
                          index: forloop.index,
                          animated: animated,
                          animation_effect: animation_effect,
                          color_scheme: pc_scheme,
                          pcard_alignment: pc_align
                        %}
                      </div>
                    {% endfor %}
                  {%- endif -%}
                </div>
              </div>
              {% if enable_slider and show_pagination or show_navigation %}
                {%
                  render 'slider-controls',
                  container: 'm-page-width',
                  show_nav: show_navigation,
                  show_pagination: show_pagination,
                  navigation_position: navigation_position,
                  pagination_type: pagination_type,
                  nav_class: 'm:opacity-0'
                %}
              {% endif %}
              {% if section.settings.button_label != blank %}
                <div class="m-product-tabs__button-more m:text-center{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
                  {% capture arrow  %}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="CurrentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>{% endcapture %}
                  {% capture triangle %}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.51531 5.73474L4.76531 1.98474C4.71287 1.93223 4.64602 1.89647 4.57324 1.88198C4.50046 1.86748 4.42501 1.87491 4.35645 1.90332C4.28789 1.93172 4.22931 1.97984 4.1881 2.04156C4.1469 2.10328 4.12494 2.17584 4.125 2.25005V9.75005C4.12494 9.82426 4.1469 9.89682 4.1881 9.95855C4.22931 10.0203 4.28789 10.0684 4.35645 10.0968C4.42501 10.1252 4.50046 10.1326 4.57324 10.1181C4.64602 10.1036 4.71287 10.0679 4.76531 10.0154L8.51531 6.26536C8.55018 6.23054 8.57784 6.18918 8.59671 6.14365C8.61558 6.09813 8.62529 6.04933 8.62529 6.00005C8.62529 5.95077 8.61558 5.90197 8.59671 5.85645C8.57784 5.81092 8.55018 5.76957 8.51531 5.73474Z" fill="currentColor"/></svg>{% endcapture %}
                  {% liquid 
                    assign is_button_icon = false
                    if section.settings.button_label contains '[arrow]' or section.settings.button_label contains '[triangle]'
                      assign is_button_icon = true
                    endif
                  %}
                  <a
                    href="{{ current_collection.url }}"
                    class="m-button {{ section.settings.button_style }}{% if is_button_icon %} m-button--with-icon{% endif %}"
                  >
                    {{- section.settings.button_label | replace: '[arrow]', arrow | replace: '[triangle]', triangle -}}
                  </a>
                </div>
              {% endif %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </template>
    </product-tabs>
  </div>
</section>
{% style %}
  {% if section.settings.pt_custom_card_surfaces %}
    #shopify-section-{{ section.id }} .m-product-card__media {
      background-color: {{ section.settings.pt_media_bg }} !important;
    }
    #shopify-section-{{ section.id }} .m-product-card__content {
      background-color: {{ section.settings.pt_content_bg }} !important;
    }
  {% endif %}
  {% if section.settings.pt_card_radius > 0 %}
    #shopify-section-{{ section.id }} .m-product-card,
    #shopify-section-{{ section.id }} .m-product-card__media {
      --product-card-corner-radius: {{ section.settings.pt_card_radius }}px;
    }
  {% endif %}
  {% if section.settings.pt_tab_custom_colors %}
    #shopify-section-{{ section.id }} .m-product-tabs__buttons--style-2 .m-product-tabs__button {
      background-color: {{ section.settings.pt_tab_bg }} !important;
      border-color: {{ section.settings.pt_tab_border }} !important;
      color: {{ section.settings.pt_tab_text }} !important;
    }
    #shopify-section-{{ section.id }} .m-product-tabs__buttons--style-2 .m-product-tabs__button.m-tab-active,
    #shopify-section-{{ section.id }} .m-product-tabs__buttons--style-2 .m-product-tabs__button:hover {
      background-color: {{ section.settings.pt_tab_active_bg }} !important;
      border-color: {{ section.settings.pt_tab_active_border }} !important;
      color: {{ section.settings.pt_tab_active_text }} !important;
    }
  {% endif %}
  #shopify-section-{{ section.id }} .m-add-to-cart {
    background-color: {{ section.settings.atc_bg_color }} !important;
    color: {{ section.settings.atc_text_color }} !important;
    border-color: {{ section.settings.atc_bg_color }} !important;
  }
  #shopify-section-{{ section.id }} .m-add-to-cart:hover {
    background-color: {{ section.settings.atc_hover_bg_color }} !important;
    color: {{ section.settings.atc_hover_text_color }} !important;
    border-color: {{ section.settings.atc_hover_bg_color }} !important;
  }
  /* Select options (multi-variant): quick-view button or product link, not .m-add-to-cart */
  #shopify-section-{{ section.id }} .m-product-card__quick-add .m-button.m-button--secondary:not(.m-add-to-cart),
  #shopify-section-{{ section.id }} .m-product-card__quick-add a.m-button.m-button--secondary {
    background-color: {{ section.settings.pt_select_options_bg }} !important;
    color: {{ section.settings.pt_select_options_text }} !important;
    border-color: {{ section.settings.pt_select_options_border }} !important;
  }
  #shopify-section-{{ section.id }} .m-product-card__quick-add .m-button.m-button--secondary:not(.m-add-to-cart):hover,
  #shopify-section-{{ section.id }} .m-product-card__quick-add a.m-button.m-button--secondary:hover {
    background-color: {{ section.settings.pt_select_options_hover_bg }} !important;
    color: {{ section.settings.pt_select_options_hover_text }} !important;
    border-color: {{ section.settings.pt_select_options_hover_border }} !important;
  }
  {% if settings.show_cart_button %}
    #shopify-section-{{ section.id }} .m-product-card--style-1 .m-product-card__media .m-product-card__quick-add-icon {
      display: none !important;
    }
    #shopify-section-{{ section.id }} .m-product-card--style-1 .m-product-card__content .m-product-card__quick-add {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      padding: 0 !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      margin-top: 15px !important;
      z-index: 1 !important;
      border: none !important;
      display: block !important;
    }
    #shopify-section-{{ section.id }} .m-product-card--style-1:after {
      display: none !important;
    }
  {% endif %}
{% endstyle %}
{% schema %}
{
  "name": "Product tabs",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "boxed_layout",
      "label": "Enable boxed layout",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "grid_bordered",
      "label": "Grid bordered",
      "default": false,
      "info": "Only works if Boxed layout is enabled."
    },
    {
      "type": "color_scheme",
      "id": "boxed_color_scheme",
      "default": "scheme_1",
      "label": "Color scheme",
      "info": "Only works if Boxed layout is enabled."
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Product tabs"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        }
      ]
    },
    {
      "type": "select",
      "id": "tab_header_style",
      "label": "Tab header style",
      "options": [
        {
          "value": "1",
          "label": "Style 1"
        },
        {
          "value": "2",
          "label": "Style 2"
        },
        {
          "value": "3",
          "label": "Style 3"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "header_divider",
      "label": "Show header divider",
      "default": false
    },
    {
      "type": "header",
      "content": "Product card settings"
    },
    {
      "type": "select",
      "id": "pcard_layout",
      "label": "Design layout",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Use global settings"
        },
        {
          "value": "1",
          "label": "Style 1"
        },
        {
          "value": "2",
          "label": "Style 2"
        },
        {
          "value": "3",
          "label": "Style 3"
        }
      ]
    },
    {
      "type": "select",
      "id": "pcard_image_ratio",
      "label": "Image aspect ratio",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Use global settings"
        },
        {
          "value": "original",
          "label": "Original aspect ratio"
        },
        {
          "value": "1/1",
          "label": "1:1"
        },
        {
          "value": "3/4",
          "label": "3:4"
        },
        {
          "value": "4/3",
          "label": "4:3"
        },
        {
          "value": "16/9",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendors",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Add to cart follows Theme settings → Product cards → Show add to cart. In this section, cards use a normal always-visible button (no hover-only reveal)."
    },
    {
      "type": "header",
      "content": "Add to cart button colors"
    },
    {
      "type": "color",
      "id": "atc_bg_color",
      "label": "Button background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "atc_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "atc_hover_bg_color",
      "label": "Button hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "atc_hover_text_color",
      "label": "Button hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Select options button colors"
    },
    {
      "type": "paragraph",
      "content": "For products with variants (opens quick view, goes to product, or links to the product page depending on Theme settings → Product cards → Select option button action)."
    },
    {
      "type": "color",
      "id": "pt_select_options_bg",
      "label": "Background",
      "default": "#ebebeb"
    },
    {
      "type": "color",
      "id": "pt_select_options_text",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "pt_select_options_border",
      "label": "Border",
      "default": "#ebebeb",
      "info": "Usually match background for a solid pill, or choose a contrasting outline."
    },
    {
      "type": "color",
      "id": "pt_select_options_hover_bg",
      "label": "Hover background",
      "default": "#dedede"
    },
    {
      "type": "color",
      "id": "pt_select_options_hover_text",
      "label": "Hover text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "pt_select_options_hover_border",
      "label": "Hover border",
      "default": "#dedede"
    },
    {
      "type": "header",
      "content": "Product card appearance"
    },
    {
      "type": "select",
      "id": "pt_card_border",
      "label": "Card border",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "on", "label": "Always show" },
        { "value": "off", "label": "Hide (no outline)" }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "pt_use_pcard_scheme",
      "label": "Use section color scheme on cards",
      "default": false,
      "info": "Overrides Theme settings → Product cards color scheme for this section only."
    },
    {
      "type": "color_scheme",
      "id": "pt_pcard_color_scheme",
      "label": "Product card color scheme",
      "default": "background-1",
      "visible_if": "{{ section.settings.pt_use_pcard_scheme }}"
    },
    {
      "type": "checkbox",
      "id": "pt_custom_card_surfaces",
      "label": "Custom card backgrounds",
      "default": false,
      "info": "Image area and text area only; does not recolor product photos."
    },
    {
      "type": "color",
      "id": "pt_media_bg",
      "label": "Image / placeholder area",
      "default": "#f4f1eb",
      "visible_if": "{{ section.settings.pt_custom_card_surfaces }}"
    },
    {
      "type": "color",
      "id": "pt_content_bg",
      "label": "Title and price area",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.pt_custom_card_surfaces }}"
    },
    {
      "type": "range",
      "id": "pt_card_radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 0,
      "info": "0 uses the theme default."
    },
    {
      "type": "select",
      "id": "pt_pcard_text_align",
      "label": "Title and price alignment",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "Tab buttons (style 2)"
    },
    {
      "type": "checkbox",
      "id": "pt_tab_custom_colors",
      "label": "Custom pill tab colors",
      "default": false,
      "info": "Applies when Tab header style is Style 2 (outlined pills)."
    },
    {
      "type": "color",
      "id": "pt_tab_bg",
      "label": "Inactive background",
