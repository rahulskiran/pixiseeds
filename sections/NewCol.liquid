{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign gap = section.settings.grid_gap
  assign gap_mobile = section.settings.grid_gap_mobile
-%}

{% style %}
  .m-newcol--{{ section.id }} {
    --m-newcol-gap: {{ gap_mobile }}px;
    --m-newcol-card-pad: {{ section.settings.card_padding }}px;
    --m-newcol-heading-gap: {{ section.settings.heading_spacing }}px;
  }
  @media screen and (min-width: 1024px) {
    .m-newcol--{{ section.id }} {
      --m-newcol-gap: {{ gap }}px;
    }
  }
{% endstyle %}

<section
  class="m-section m-newcol m-newcol--{{ section.id }} m-section--padding m-color-{{ section.settings.color_scheme }} m-gradient"
  style="--section-padding-top: {{ pt }}px; --section-padding-bottom: {{ pb }}px;"
>
  <div class="m-page-width">
    {% if section.settings.heading != blank %}
      <h2 class="m-newcol__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="m-newcol__grid">
      {% for block in section.blocks %}
        <div
          class="m-newcol__card{% if block.settings.link != blank %} m-newcol__card--link{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="m-newcol__card-inner"
              {% if block.settings.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {% else %}
            <div class="m-newcol__card-inner">
          {% endif %}

          <div class="m-newcol__icon-wrap">
            {% if block.settings.image != blank %}
              {%- assign card_alt = block.settings.image.alt | default: block.settings.title | escape -%}
              {{
                block.settings.image
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  class: 'm-newcol__icon-img',
                  widths: '60, 80, 120',
                  sizes: '(min-width: 1024px) 80px, 64px',
                  alt: card_alt
              }}
            {% else %}
              <span class="m-newcol__icon-placeholder">{{ 'image' | placeholder_svg_tag: 'm-placeholder-svg' }}</span>
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <p class="m-newcol__label">{{ block.settings.title | escape }}</p>
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .m-newcol__heading {
    text-align: center;
    margin: 0 0 var(--m-newcol-heading-gap, 32px);
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
  }
  .m-newcol__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--m-newcol-gap, 12px);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media screen and (min-width: 1024px) {
    .m-newcol__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .m-newcol__card {
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-border), 0.45);
    border-radius: var(--corner-radius, 6px);
    box-shadow: 0 1px 3px rgba(var(--color-foreground), 0.06);
    overflow: hidden;
    min-width: 0;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .m-newcol__card--link:hover {
    box-shadow: 0 4px 12px rgba(var(--color-foreground), 0.1);
  }
  .m-newcol__card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--m-newcol-card-pad, 24px) 16px;
    min-height: 140px;
    height: 100%;
    color: inherit;
    text-decoration: none;
    gap: 14px;
  }
  .m-newcol__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .m-newcol__icon-img {
    width: 48px;
    height: auto;
    max-height: 48px;
    object-fit: contain;
    display: block;
  }
  @media screen and (min-width: 1024px) {
    .m-newcol__icon-img {
      width: 56px;
      max-height: 56px;
    }
  }
  .m-newcol__icon-placeholder {
    display: flex;
    width: 48px;
    height: 48px;
    opacity: 0.35;
  }
  .m-newcol__icon-placeholder .m-placeholder-svg {
    width: 100%;
    height: 100%;
  }
  .m-newcol__label {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
  }
{% endstyle %}

{% schema %}
{
  "name": "Shop by condition",
  "tag": "section",
  "class": "m-newcol-section",
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Growing Condition"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 32
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Grid gap (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Grid gap (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Full sun"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop by condition",
      "blocks": [
        {
          "type": "card",
          "settings": { "title": "Full sun" }
        },
        {
          "type": "card",
          "settings": { "title": "Shade tolerant" }
        },
        {
          "type": "card",
          "settings": { "title": "Balcony containers" }
        },
        {
          "type": "card",
          "settings": { "title": "Pollinator friendly" }
        },
        {
          "type": "card",
          "settings": { "title": "Deer resistant" }
        },
        {
          "type": "card",
          "settings": { "title": "Drought hardy" }
        }
      ]
    }
  ]
}
{% endschema %}
