  #pcol-{{ sid }} .pcol__sizes,
  #pcol-{{ sid }} .pcol__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }

  #pcol-{{ sid }} .pcol__size {
    font-size: var(--pcol-size-fs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: var(--pcol-size-pv) var(--pcol-size-ph);
    border: 1px solid var(--pcol-size-border);
    border-radius: var(--pcol-size-radius);
    color: var(--pcol-size-fg);
    background: var(--pcol-size-bg);
    line-height: 1;
  }

  #pcol-{{ sid }} .pcol__size.is-out {
    color: var(--pcol-size-out-fg);
    text-decoration: line-through;
  }

  #pcol-{{ sid }} .pcol__size--more {
    background: transparent;
    color: var(--pcol-size-out-fg);
    border-style: dashed;
  }

  #pcol-{{ sid }} .pcol__swatch {
    width: var(--pcol-swatch-size);
    height: var(--pcol-swatch-size);
    border-radius: 999px;
    border: 1px solid var(--pcol-swatch-border);
    box-shadow: inset 0 0 0 2px var(--pcol-card-bg);
  }

  #pcol-{{ sid }} .pcol__swatch--more {
    width: auto;
    padding: 0 8px;
    background: transparent;
    box-shadow: none;
    color: var(--pcol-vendor-fg);
    font-size: var(--pcol-size-fs);
    line-height: var(--pcol-swatch-size);
  }

  #pcol-{{ sid }} .pcol__urgency {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--pcol-urgency-fg);
    margin-top: 2px;
  }

  #pcol-{{ sid }} .pcol__urgency-dot {
    width: 6px; height: 6px; border-radius: 999px;
    background: var(--pcol-urgency-dot);
    box-shadow: 0 0 0 0 var(--pcol-urgency-dot);
    animation: pcolPulse 1.5s infinite;
  }

  @keyframes pcolPulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--pcol-urgency-dot) 70%, transparent); }
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  #pcol-{{ sid }} .pcol__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 0.75rem;
    color: var(--pcol-chip-fg);
  }

  #pcol-{{ sid }} .pcol__atc {
    margin-top: auto;
    appearance: none;
    border: 1px solid var(--pcol-atc-border);
    background: var(--pcol-atc-bg);
    color: var(--pcol-atc-fg);
    padding: var(--pcol-atc-pv) var(--pcol-atc-ph);
    font: inherit;
    font-size: var(--pcol-atc-fs);
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: var(--pcol-atc-radius);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    transition: background 220ms ease, color 220ms ease, border-color 220ms ease;
  }

  #pcol-{{ sid }} .pcol__atc:hover,
  #pcol-{{ sid }} .pcol__atc:focus-visible {
    background: var(--pcol-atc-hover-bg);
    color: var(--pcol-atc-hover-fg);
    border-color: var(--pcol-atc-hover-bg);
    outline: none;
  }

  #pcol-{{ sid }} .pcol__atc--out {
    border-color: var(--pcol-card-border);
    background: transparent;
    color: var(--pcol-vendor-fg);
    cursor: not-allowed;
  }

  #pcol-{{ sid }} .pcol__atc--out:hover { background: transparent; color: var(--pcol-vendor-fg); border-color: var(--pcol-card-border); }

  #pcol-{{ sid }} .pcol__atc.is-loading { opacity: 0.7; pointer-events: none; }
  #pcol-{{ sid }} .pcol__atc.is-success {
    background: var(--pcol-atc-success-bg);
    border-color: var(--pcol-atc-success-bg);
    color: var(--pcol-atc-success-fg);
  }

  #pcol-{{ sid }} .pcol__pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 36px;
    margin-top: 32px;
    border-top: 1px solid var(--pcol-tb-border);
  }

  #pcol-{{ sid }} .pcol__pg,
  #pcol-{{ sid }} .pcol__pg-num {
    font-size: 0.8125rem;
    color: var(--pcol-pg-fg);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 6px;
  }

  #pcol-{{ sid }} .pcol__pg-nums { display: flex; gap: 2px; }

  #pcol-{{ sid }} .pcol__pg-num.is-current {
    background: var(--pcol-pg-cur-bg);
    color: var(--pcol-pg-cur-fg);
  }

  #pcol-{{ sid }} .pcol__pg.is-disabled {
    color: var(--pcol-pg-disabled);
    cursor: not-allowed;
  }

  #pcol-{{ sid }} .pcol__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: var(--pcol-vendor-fg);
  }

  #pcol-{{ sid }} .pcol__empty-link {
    color: var(--pcol-empty-link);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 750px) {
    #pcol-{{ sid }} .pcol__grid { grid-template-columns: repeat(var(--pcol-cols-t), minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    #pcol-{{ sid }} { padding-top: var(--pcol-pt-d); padding-bottom: var(--pcol-pb-d); }
    #pcol-{{ sid }} .pcol__grid { grid-template-columns: repeat(var(--pcol-cols-d), minmax(0, 1fr)); }
  }

  @media (max-width: 749px) {
    #pcol-{{ sid }} .pcol__body { padding: 14px 14px 16px; gap: 6px; }
    #pcol-{{ sid }} .pcol__title { font-size: 0.875rem; }
    #pcol-{{ sid }} .pcol__quick { display: none; }
    #pcol-{{ sid }} .pcol__atc { padding: 10px 12px; font-size: 0.75rem; }

    #pcol-{{ sid }} .pcol__bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 10px 0;
      gap: 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      width: 100%;
    }
    #pcol-{{ sid }} .pcol__bar::-webkit-scrollbar { display: none; }
    #pcol-{{ sid }} .pcol__bar-left { flex: 0 0 auto; }
    #pcol-{{ sid }} .pcol__bar-right { flex: 0 0 auto; margin-left: auto; }
    #pcol-{{ sid }} .pcol__chips { display: none; }
    #pcol-{{ sid }} .pcol__count { display: none; }
    #pcol-{{ sid }} .pcol__sort-lbl { display: none; }
    #pcol-{{ sid }} .pcol__sort { min-width: 130px; }
  }

  #pcol-{{ sid }} .pcol__search-hero {
    margin-bottom: 1.75rem;
    padding-top: 0.25rem;
    text-align: center;
  }

  #pcol-{{ sid }} .pcol__search-hero--left {
    text-align: left;
  }

  #pcol-{{ sid }} .pcol__search-hero--left .pcol__search-form-wrap {
    margin-inline: 0;
  }

  #pcol-{{ sid }} .pcol__search-title {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 4vw, 2rem);
    font-weight: 600;
    color: var(--pcol-title-fg);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  #pcol-{{ sid }} .pcol__search-form-wrap {
    width: 100%;
    max-width: min(640px, 100%);
    margin-inline: auto;
    display: flex;
    justify-content: center;
  }

  #pcol-{{ sid }} .pcol__search-form-wrap .m-search-form {
    width: 100%;
  }

  #pcol-{{ sid }} .pcol__card--content .pcol__content-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pcol-vendor-fg);
    margin-bottom: 0.35rem;
  }

  #pcol-{{ sid }} .pcol__card--content .pcol__title a {
    color: inherit;
    text-decoration: none;
  }

  #pcol-{{ sid }} .pcol__card--content .pcol__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  #pcol-{{ sid }} .pcol__card--page-only {
    min-height: 160px;
    justify-content: center;
  }

  #pcol-{{ sid }} .pcol__body--page-only {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
