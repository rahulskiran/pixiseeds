{%- comment -%}
  Depth-first: outputs the first collection handle found in a menu (nested OK).
  Uses collection_link or /collections/{handle} in link.url.
{%- endcomment -%}
{%- for link in links -%}
  {%- liquid
    assign h = ''
    if link.type == 'collection_link' and link.object != blank
      assign h = link.object.handle
    elsif link.url != blank and link.url contains '/collections/'
      assign segs = link.url | split: '/collections/'
      if segs.size > 1
        assign tail = segs.last | split: '?' | first | split: '/' | first
        if tail != blank
          assign h = tail
        endif
      endif
    endif
  -%}
  {%- if h != blank -%}
    {{- h -}}
    {%- break -%}
  {%- endif -%}
  {%- if link.links != blank -%}
    {%- capture nested -%}
      {%- render 'header-search-category-first', links: link.links -%}
    {%- endcapture -%}
    {%- assign nested = nested | strip -%}
    {%- if nested != blank -%}
      {{- nested -}}
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
