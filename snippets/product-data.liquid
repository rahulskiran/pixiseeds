{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- if first_3d_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- endif -%}

{%- assign selected_variant = product.selected_variant -%}
{%- unless section.settings.show_featured_media -%}
  {%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- endunless -%}
<script>
  window._themeProducts = window._themeProducts || {}
  window._themeProducts[{{ product.id }}] = {
    has_3d_model: {%- if first_3d_model -%}true{%- else -%}false{%- endif -%},
    id: {{ product.id }},
    title: {{ product.title | json }},
    available: {{ product.available | json }},
    handle: {{ product.handle | json }},
    variants: {{ product.variants | json }},
    options: {{ product.options_with_values | json }},
    selected_or_first_available_variant: {{ product.selected_or_first_available_variant | json }},
    selected_variant: {{ selected_variant | json }},
    media: {{ product.media | json }},
    featured_image: {{ product.featured_image | json }},
    aspect_ratio: {{ product.featured_image.aspect_ratio | json }},
    images: {{ product.images | json }},
    price: {{ product.price | json }},
  };
  {%- for variant in product.variants -%}
    window._themeProducts[{{ product.id }}].variants[{{ forloop.index0 }}].inventory_quantity = {{ variant.inventory_quantity }};
  {%- endfor -%}
</script>
{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

{%- liquid
  comment
    Google Merchant Center cross-checks this markup against the product feed.
    priceValidUntil is required for rich results; a rolling one-year window keeps
    it from going stale. Return window mirrors the published returns policy.
  endcomment
  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  assign return_days = 14
  assign return_country = shop.address.country_code | default: 'IN'
-%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    {%- capture _pname -%}{% render 'scrub-lormur', text: product.title %}{%- endcapture -%}
    "name": {{ _pname | strip | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif -%}
    {%- assign _desc_src = product.description | strip_html -%}
    {%- capture _desc -%}{% render 'scrub-lormur', text: _desc_src %}{%- endcapture -%}
    "description": {{ _desc | strip | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      {%- capture brand_name -%}{% render 'brand-name' %}{%- endcapture -%}
      "name": {{ brand_name | strip | json }}
    },
    {%- if product.metafields.loox.num_reviews != blank and product.metafields.loox.num_reviews > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ product.metafields.loox.avg_rating | json }},
        "reviewCount": {{ product.metafields.loox.num_reviews | json }}
      },
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode | json }},
          {%- elsif variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode | json }},
          {%- elsif variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode | json }},
          {%- elsif variant.sku != blank -%}
            "mpn": {{ variant.sku | json }},
          {%- else -%}
            "identifier_exists": false,
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition" : "https://schema.org/NewCondition",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "priceValidUntil" : {{ price_valid_until | json }},
          "hasMerchantReturnPolicy" : {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": {{ return_country | json }},
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ return_days }},
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/FreeReturn"
          },
          {%- comment -%}
            shippingDetails is intentionally omitted: Google compares it against the
            real rates in your Merchant Center feed, and a guessed value causes item
            disapprovals. Add it here once the shipping zones and rates are settled.
          {%- endcomment -%}
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
