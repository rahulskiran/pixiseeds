{%- liquid
  assign product_type_search_enabled = settings.product_type_search_enabled
  assign product_type_custom = settings.product_type_search_custom

  capture all_product_type
    for type in shop.types
      if type != blank
        echo type | strip | append: ','
      endif
    endfor
  endcapture
  assign all_product_type_custom = product_type_custom | split: ','
  assign all_product_type = all_product_type | split: ',' | uniq | join: ',' | split: ','

  if all_product_type_custom.size > 0
    capture product_types_custom
      for type in all_product_type_custom
        assign type_item = type | strip
        if all_product_type contains type_item
          echo type | append: ','
        endif
      endfor
    endcapture
    assign product_types = product_types_custom | split: ','
  else 
    assign product_types = all_product_type
  endif

  assign has_search_product_type = false
  if all_product_type.size > 0
    assign has_search_product_type = true
  endif
  assign input_id = input_id | default: 'Search-In-Header'

  assign has_type_filter = false
  if has_search_product_type and product_type_search_enabled and settings.predictive_search_enabled
    assign has_type_filter = true
  endif
  assign header_second_control = section.settings.header_search_second_control | default: 'sort'
  assign show_header_sort = false
  assign show_header_category = false
  if header_second_control == 'sort'
    assign show_header_sort = true
  elsif header_second_control == 'category'
    assign show_header_category = true
  endif
  assign has_left_cluster = false
  if has_type_filter or show_header_sort or show_header_category
    assign has_left_cluster = true
  endif
  assign header_sort_current = search.sort_by | default: search.default_sort_by | default: 'relevance'
  assign collections_base = routes.root_url | append: 'collections/'
  assign header_search_cols = section.settings.header_search_collections
  assign header_category_current_handle = ''
  if template.name == 'collection' and collection.handle != blank
    assign header_category_current_handle = collection.handle
  endif
  assign category_selected_handle = ''
  if header_category_current_handle != blank and header_search_cols != blank
    for col in header_search_cols
      if col != blank and col.handle == header_category_current_handle
        assign category_selected_handle = header_category_current_handle
      endif
    endfor
  endif
  assign category_selected_label = 'sections.header.search_category.all' | t
  if category_selected_handle != blank and header_search_cols != blank
    for col in header_search_cols
      if col != blank and col.handle == category_selected_handle
        assign category_selected_label = col.title
      endif
    endfor
  endif
  assign header_category_select_works = false
  if show_header_category
    assign header_category_select_works = true
  endif
  assign header_tw_enable = section.settings.header_search_placeholder_typewriter
  if header_tw_enable == nil
    assign header_tw_enable = true
  endif
  assign header_tw_fallback = section.settings.header_search_placeholder_fallback | strip
  if header_tw_fallback == blank
    assign header_tw_fallback = 'general.search.search_field_placeholder' | t
  endif
  assign tw_phrases_raw = section.settings.header_search_placeholder_phrases | default: 'Search for seeds, What are you looking for?'
  capture header_tw_json
    echo '['
    assign tw_sep = ''
    assign tw_parts = tw_phrases_raw | split: ','
    for tw_part in tw_parts
      assign tw_p = tw_part | strip
      if tw_p != blank
        echo tw_sep
        echo tw_p | json
        assign tw_sep = ','
      endif
    endfor
    echo ']'
  endcapture
  assign header_tw_active = false
  if header_tw_enable and header_tw_json != '[]'
    assign header_tw_active = true
  endif
-%}
{%- if show_header_category -%}
  {%- liquid
    {% comment %} assign hsc_bg = section.settings.header_search_category_bg | default: '#E8E8E8' {% endcomment %}
    assign hsc_w_d = section.settings.header_search_category_width_desktop | default: 104
    assign hsc_w_m = section.settings.header_search_category_width_mobile | default: 64
    assign hsc_pxd = section.settings.header_search_category_padding_x_desktop | default: 10
    assign hsc_pyd = section.settings.header_search_category_padding_y_desktop | default: 0
    assign hsc_pxm = section.settings.header_search_category_padding_x_mobile | default: 6
    assign hsc_pym = section.settings.header_search_category_padding_y_mobile | default: 0
  -%}
{%- endif -%}
{%- if settings.predictive_search_enabled -%}
  <predictive-search class="m-search {{ classes }}" data-loading-text="{{ 'accessibility.loading' | t }}">
{%- else -%}
  <search-form class="m-search {{ classes }}">
{%- endif -%}
<form
  action="{{ routes.search_url }}"
  method="get"
  role="search"
  class="m-search-form"
  {% if header_category_select_works %}
    data-category-search="true"
    data-collections-base="{{ collections_base | escape }}"
    {% if template.name == 'collection' and collection.handle != blank %}
      data-default-collection="{{ collection.handle | escape }}"
    {% endif %}
  {% endif %}
>
  <div class="m-search-form__wrapper{% if has_type_filter %} m-search-form__has-filter{% endif %}{% if show_header_sort %} m-search-form__has-sort{% endif %}{% if show_header_category %} m-search-form__has-category{% endif %}">
    {% if has_left_cluster %}
      <div class="m-search-form__left-cluster">
        {% if has_type_filter %}
          <div class="m-search-form__select">
            <label for="search-product-type-{{ input_id }}" class="m:hidden">{{ 'sections.header.search_filter.option_1' | t }}</label>
            <select data-predictive-search-filter id="search-product-type-{{ input_id }}">
              <option disabled>{{ 'sections.header.search_filter.option_1' | t }}</option>
              <option data-index="0" value selected>{{ 'sections.header.search_filter.option_2' | t }}</option>
              {% for product_type in product_types %}
                <option data-index="{{ forloop.index }}" value="{{ product_type | strip }}">{{ product_type }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
        {% if show_header_sort %}
          <div class="m-search-form__select m-search-form__select--sort">
            <label for="search-sort-by-{{ input_id }}" class="m:hidden">{{ 'sections.header.search_sort.label' | t }}</label>
            <select name="sort_by" id="search-sort-by-{{ input_id }}">
              {% if search.sort_options.size > 0 %}
                {% for option in search.sort_options %}
                  <option
                    value="{{ option.value | escape }}"
                    {% if option.value == header_sort_current %}selected="selected"{% endif %}
                  >
                    {{ option.name | escape }}
                  </option>
                {% endfor %}
              {% else %}
                <option value="relevance" {% if header_sort_current == 'relevance' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_relevance' | t }}
                </option>
                <option value="price-ascending" {% if header_sort_current == 'price-ascending' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_price_asc' | t }}
                </option>
                <option value="price-descending" {% if header_sort_current == 'price-descending' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_price_desc' | t }}
                </option>
                <option value="created-descending" {% if header_sort_current == 'created-descending' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_created_desc' | t }}
                </option>
                <option value="created-ascending" {% if header_sort_current == 'created-ascending' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_created_asc' | t }}
                </option>
                <option value="title-ascending" {% if header_sort_current == 'title-ascending' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_title_asc' | t }}
                </option>
                <option value="title-descending" {% if header_sort_current == 'title-descending' %}selected="selected"{% endif %}>
                  {{ 'sections.header.search_sort.option_title_desc' | t }}
                </option>
              {% endif %}
            </select>
          </div>
        {% endif %}
        {% if show_header_category %}
          <div class="m-search-form__select m-search-form__select--category">
            <span class="m:hidden" id="search-category-label-{{ input_id }}">{{ 'sections.header.search_category.label' | t }}</span>
            <div class="m-search-category-dd" data-search-category-dropdown>
              <input
                type="hidden"
                value="{{ category_selected_handle | escape }}"
                data-header-search-category-value
                autocomplete="off"
              >
              <button
                type="button"
                class="m-search-category-dd__toggle"
                aria-expanded="false"
                aria-haspopup="listbox"
                aria-controls="search-category-panel-{{ input_id }}"
                aria-labelledby="search-category-label-{{ input_id }} search-category-btn-{{ input_id }}"
                id="search-category-btn-{{ input_id }}"
              >
                <span
                  class="m-search-category-dd__label"
                  data-search-category-current
                  id="search-category-current-{{ input_id }}"
                >
                  {{- category_selected_label | escape -}}
                </span>
                <span class="m-search-category-dd__chevron" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
              <div
                class="m-search-category-dd__panel"
                id="search-category-panel-{{ input_id }}"
                hidden
              >
                <ul class="m-search-category-dd__list" role="listbox" aria-labelledby="search-category-label-{{ input_id }}">
                  <li role="presentation">
                    <button
                      type="button"
                      role="option"
                      class="m-search-category-dd__option{% if category_selected_handle == blank %} is-selected{% endif %}"
                      data-search-category-option
                      data-value=""
                      data-label="{{ 'sections.header.search_category.all' | t | escape }}"
                      aria-selected="{% if category_selected_handle == blank %}true{% else %}false{% endif %}"
                    >
                      {{ 'sections.header.search_category.all' | t }}
                    </button>
                  </li>
                  {% if header_search_cols != blank %}
                    {% for col in header_search_cols %}
                      {% if col != blank %}
                        <li role="presentation">
                          <button
                            type="button"
                            role="option"
                            class="m-search-category-dd__option{% if category_selected_handle == col.handle %} is-selected{% endif %}"
                            data-search-category-option
                            data-value="{{ col.handle | escape }}"
                            data-label="{{ col.title | escape }}"
                            aria-selected="{% if category_selected_handle == col.handle %}true{% else %}false{% endif %}"
                          >
                            {{ col.title | escape }}
                          </button>
                        </li>
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                </ul>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
    <div class="m-search-form__main">
      <input
        class="search__input field__input form-field form-field--input m-search__input{% if header_tw_active %} m-search__input--typewriter{% endif %}"
        id="{{ input_id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ header_tw_fallback | escape }}"
        {% if header_tw_active %}
          data-search-typewriter="true"
          data-typewriter-static="{{ header_tw_fallback | escape }}"
        {% endif %}
        {%- if settings.predictive_search_enabled -%}
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results"
          aria-controls="predictive-search-results"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        {%- endif -%}
      >
      {% if header_tw_active %}
        <script type="application/json" data-search-typewriter data-input-id="{{ input_id | escape }}">
          {{- header_tw_json -}}
        </script>
      {% endif %}
      <input type="hidden" name="options[prefix]" value="last">
      <input type="hidden" id="product_type_input" name="filter.p.product_type">
      <div class="m-search-form__buttons">
      <button
        type="reset"
        class="reset__button m-search-form__reset--button {% if search.terms == blank %} m:hidden{% endif %}"
        aria-label="{{ 'general.search.reset' | t }}"
      >
        <svg class="m-svg-icon--large" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18.75 5.25L5.25 18.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M18.75 18.75L5.25 5.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="search__button m-search-form__search--button m-spinner-button search__button--{{ section.settings.search_button }}" aria-label="{{ 'general.search.search' | t }}">
        {% if section.settings.search_button == 'icon' or section.settings.search_button == 'icon-plain' %}
          <svg class="m-svg-icon--large" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M15.8032 15.8035L20.9998 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {% else %}
          <span>{{ 'general.search.search_button_label' | t }}</span>
        {% endif %}
        <span class="m-spinner-icon">
          <svg
            class="animate-spin m-svg-icon--medium"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
          >
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
            <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
      </button>
      </div>
    </div>
  </div>
  {%- if settings.predictive_search_enabled -%}
    <div class="m-predictive-search m-gradient m-color-{{ settings.popups_drawer_color_scheme }}" tabindex="-1" data-predictive-search>
    </div>
    <span class="m-predictive-search-status m:visually-hidden" role="status" aria-hidden="true"></span>
  {%- endif -%}
</form>
{%- if settings.predictive_search_enabled -%}
  </predictive-search>
{%- else -%}
  </search-form>
{%- endif -%}
