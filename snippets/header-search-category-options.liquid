{%- comment -%}
  Outputs <option> tags for collection links from a menu, including nested levels.
  collection_link or URL path containing /collections/{handle}
  @param {linklist.links} links
  @param {string} [prefix] - visual indent for nested labels
  @param {string} [selected_handle] - selects this collection when it matches
{%- endcomment -%}
{%- liquid
  assign opt_prefix = prefix | default: ''
  assign sel = selected_handle | default: ''
-%}
{%- for link in links -%}
  {%- liquid
    assign opt_handle = ''
    if link.type == 'collection_link' and link.object != blank
      assign opt_handle = link.object.handle
    elsif link.url != blank and link.url contains '/collections/'
      assign segs = link.url | split: '/collections/'
      if segs.size > 1
        assign tail = segs.last | split: '?' | first | split: '/' | first
        if tail != blank
          assign opt_handle = tail
        endif
      endif
    endif
  -%}
  {%- if opt_handle != blank -%}
    <option
      value="{{ opt_handle | escape }}"
      {% if sel != blank and opt_handle == sel %}selected="selected"{% endif %}
    >
      {{ opt_prefix }}{{ link.title | escape }}
    </option>
  {%- endif -%}
  {%- if link.links != blank -%}
    {%- assign deeper = opt_prefix | append: '— ' -%}
    {%- render 'header-search-category-options',
      links: link.links,
      prefix: deeper,
      selected_handle: sel
    -%}
  {%- endif -%}
{%- endfor -%}
