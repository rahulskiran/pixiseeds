{% liquid 
  assign is_size = false
  assign size_title_downcase = size_title | downcase
  assign picker_type = settings.variant_picker_type
  assign picker_types = ''
  assign option_labels = ''

  for option in product.options_with_values
    assign found_option = false
    assign option_design = ''
    assign option_label = option.name

    for i in (1..5)
      unless found_option == true
        assign option_name_key = 'variant_option_title' | append: i
        assign option_design_key = 'variant_option_design' | append: i
        assign option_label_key = 'variant_option_display_name' | append: i

        assign option_name = settings[option_name_key]
        if option_name == option.name
            assign found_option = true
            assign option_design = settings[option_design_key]
            assign option_label = settings[option_label_key] | default: option.name
        endif
      endunless
    endfor

    assign design = option_design | prepend: ','
    assign option_label = option_label | prepend: ','
    if found_option == false or option_design == ''
        assign design = settings['variant_option_design_default'] | prepend: ','
    endif

    assign picker_types = picker_types | append: design
    assign option_labels = option_labels | append: option_label
  endfor
  assign picker_types = picker_types | remove_first: ',' | split: ','
  assign option_labels = option_labels | remove_first: ',' | split: ','

  assign enableVariantGroupImg = false
  if section.settings.enable_variant_group_images and product.metafields.foxecom-bs-kit.variant-images.value.enable
    assign enableVariantGroupImg = true
  endif

  assign variant_card_layout = false
  if block != blank and block.settings.variant_card_enable
    assign variant_card_layout = true
  endif

  assign variant_loading_shimmer = false
  if block != blank and block.settings.variant_picker_loading_shimmer
    assign variant_loading_shimmer = true
  endif
%}

<div data-variant-picker data-product-id="{{ product.id }}" data-enable-variant-group-images="{{ enableVariantGroupImg }}" data-section="{{ section.id }}" data-product-handle="{{ product.handle }}" data-product-url="{{ product.url }}" data-max-options="{{ product.options_with_values.size }}"{% if variant_card_layout and block != blank %} data-variant-card-save-prefix="{{ block.settings.variant_card_save_prefix | default: 'Save' | escape }}"{% endif %}>
  <variant-picker data-update-url="{{ update_browser_history }}" data-show-featured-media="{{ section.settings.show_featured_media }}">
    {%- unless product.has_only_default_variant -%}
    {%- for option in product.options_with_values -%}
      {% liquid
        assign picker_type = picker_types[forloop.index0]
        assign option_label = option_labels[forloop.index0]
        assign option_name_downcase = option.name | downcase
        if size_title_downcase contains option_name_downcase
            assign is_size = true
        else
            assign is_size = false
        endif
      %}
      {%- if variant_card_layout and block != blank -%}
        <div
          class="m-product-option m-product-option--card m-variant-card-picker{% if block.settings.variant_card_mobile_layout == 'scroll' %} m-variant-card-picker--mobile-scroll{% else %} m-variant-card-picker--mobile-wrap{% endif %}{% if block.settings.variant_card_uppercase_labels %} m-variant-card-picker--uppercase{% endif %}"
          style="
            --m-vcard-radius: {{ block.settings.variant_card_radius }}px;
            --m-vcard-min: {{ block.settings.variant_card_min_width }}px;
            --m-vcard-gap: {{ block.settings.variant_card_gap }}px;
            --m-vcard-bd-w: {{ block.settings.variant_card_border_width }}px;
            --m-vcard-bd-sel-w: {{ block.settings.variant_card_selected_border_width }}px;
            --m-vcard-bd: {{ block.settings.variant_card_border_color }};
            --m-vcard-bd-sel: {{ block.settings.variant_card_selected_border_color }};
            --m-vcard-price: {{ block.settings.variant_card_price_color }};
          "
        >
          <variant-button data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}">
            <div class="m-product-option--label">
              <label class="option-label">
                <span class="option-label--title">{{ option_label }}:</span>
                <span class="option-label--selected">{{ option.selected_value }}</span>
              </label>
              {% if is_size %}
                <button type="button" data-open-sizeguide class="foxkit-sizechart-button m:inline-flex m:items-center m:hidden">
                  <svg class="m-svg-icon--large" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm0 224H32V160h80v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h80v192z"/></svg>
                  <span class="foxkit-sizechart-button--label">{{ 'products.product.size_guide' | t }}</span>
                </button>
              {% endif %}
            </div>
            <div class="m-variant-card-picker__track">
              {%- for value in option.values -%}
                {%- liquid
                  assign swatch_variant = nil
                  for v in product.variants
                    assign variant_matches = true
                    for opt in product.options_with_values
                      if opt.position <= option.position
                        assign opi = opt.position | minus: 1
                        if opt.position < option.position
                          assign expected = opt.selected_value
                        else
                          assign expected = value
                        endif
                        if v.options[opi] != expected
                          assign variant_matches = false
                        endif
                      endif
                    endfor
                    if variant_matches
                      assign swatch_variant = v
                      break
                    endif
                  endfor
                  assign card_aspect = product.featured_image.aspect_ratio | default: 1
                  if swatch_variant.featured_image
                    assign card_aspect = swatch_variant.featured_image.aspect_ratio
                  elsif product.featured_image
                    assign card_aspect = product.featured_image.aspect_ratio
                  endif
                  assign card_save_amount = 0
                  if swatch_variant.compare_at_price > swatch_variant.price
                    assign card_save_amount = swatch_variant.compare_at_price | minus: swatch_variant.price
                  endif
                -%}
                <div
                  class="m-product-option--node m-variant-card{% if swatch_variant.available == false %} m-variant-card--soldout{% endif %}"
                  data-option-position="{{ option.position }}"
                  data-option-type="card"
                  data-value="{{ value | escape }}"
                  style="--option-aspect-ratio: {{ card_aspect }}"
                >
                  <input
                    type="radio"
                    id="{{ section.id }}-vcard-{{ option.position }}-{{ forloop.index0 }}"
                    name="{{ option.name }}"
                    value="{{ value | escape }}"
                    form="{{ product_form_id }}"
                    {% if option.selected_value == value %}checked{% endif %}
                    {% if swatch_variant.available == false %}disabled{% endif %}
                  >
                  <label
                    class="m-variant-card__label{% if variant_loading_shimmer %} option-loading{% endif %}{% if block.settings.variant_card_show_image %} m-variant-card__label--has-media{% endif %}"
                    for="{{ section.id }}-vcard-{{ option.position }}-{{ forloop.index0 }}"
                    data-option-type="card"
                  >
                    {% if block.settings.variant_card_show_image %}
                      <span class="m-variant-card__media">
                        {%- if swatch_variant.featured_image -%}
                          {{
                            swatch_variant.featured_image
                            | image_url: width: 400
                            | image_tag:
                              class: 'm-variant-picker__swatch-img',
                              loading: 'lazy',
                              alt: value,
                              widths: '100, 200, 300, 400'
                          }}
                        {%- elsif product.featured_image -%}
                          {{
                            product.featured_image
                            | image_url: width: 400
                            | image_tag:
                              class: 'm-variant-picker__swatch-img',
                              loading: 'lazy',
                              alt: value,
                              widths: '100, 200, 300, 400'
                          }}
                        {%- endif -%}
                      </span>
                    {% endif %}
                    <span class="m-variant-card__title">{{ value }}</span>
                    <span class="m-variant-card__price-stack">
                      {% if block.settings.variant_card_show_compare_price %}
                        <s
                          class="m-variant-card__compare{% unless swatch_variant.compare_at_price > swatch_variant.price %} m:hidden{% endunless %}"
                          data-variant-card-compare
                        >
                          {%- if swatch_variant.compare_at_price > swatch_variant.price -%}
                            {{- swatch_variant.compare_at_price | money -}}
                          {%- endif -%}
                        </s>
                      {% endif %}
                      <span class="m-variant-card__price" data-variant-card-price>{{ swatch_variant.price | money }}</span>
                    </span>
                    {% if block.settings.variant_card_show_save and card_save_amount > 0 %}
                      <span
                        class="m-variant-card__save m-variant-card__save--active"
                        data-variant-card-save
                      >
                        {{ block.settings.variant_card_save_prefix | default: 'Save' }}
                        {{ card_save_amount | money }}
                      </span>
                    {% elsif block.settings.variant_card_show_save %}
                      <span class="m-variant-card__save" data-variant-card-save></span>
                    {% endif %}
                  </label>
                </div>
              {%- endfor -%}
            </div>
          </variant-button>
        </div>
      {%- else -%}
      <div class="m-product-option m-product-option--{{ picker_type }}">
        {%- case picker_type -%}
          {% when 'dropdown' %}
            <variant-select data-picker-field="select" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}">
              <div class="m-product-option--label">
                <label class="option-label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                  <span class="option-label--title">{{ option_label }}:</span>
                  <span class="option-label--selected">{{ option.selected_value }}</span>
                </label>
                {% if is_size %}
                  <button data-open-sizeguide class="foxkit-sizechart-button m:inline-flex m:items-center m:hidden">
                    <svg class="m-svg-icon--large" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm0 224H32V160h80v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h80v192z"/></svg>
                    <span class="foxkit-sizechart-button--label">{{ 'products.product.size_guide' | t }}</span>
                  </button>
                {% endif %}
              </div>
              <div class="m-product-option--content">
                <div class="m:inline-flex m:flex-wrap">
                  <select id="Option-{{ section.id }}-{{ forloop.index0 }}"
                    name="options[{{ option.name | escape }}]"
                    form="{{ product_form_id }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" class="m-product-option--node" data-value="{{- value | escape -}}" data-option-position="{{ option.position }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                          {{- value -}}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              </div>
            </variant-select>
          {% when 'color' %}
            <variant-color data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}">
              <div class="m-product-option--label">
                <label class="option-label">
                  <span class="option-label--title">{{ option_label }}:</span>
                  <span class="option-label--selected">{{ option.selected_value }}</span>
                </label>
                {% if is_size %}
                  <button data-open-sizeguide class="foxkit-sizechart-button m:inline-flex m:items-center m:hidden">
                    <svg class="m-svg-icon--large" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm0 224H32V160h80v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h80v192z"/></svg>
                    <span class="foxkit-sizechart-button--label">{{ 'products.product.size_guide' | t }}</span>
                  </button>
                {% endif %}
              </div>
              <div class="m-product-option--content m:inline-flex m:flex-wrap">
                {%- for value in option.values -%}
                    <div
                        class="m-product-option--node"
                        data-option-position="{{ option.position }}"
                        data-option-type="{{ picker_type }}"
                        data-value="{{- value | escape -}}"
                        data-tippy-theme="m-color-{{ color_scheme }}"
                        data-tippy-content="{{- value -}}"
                    >
                      <div class="m-product-option--swatch">
                        <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          class="vissu"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label data-option-type="{{ picker_type }}" data-view="product" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="m-product-option--node__label{% if variant_loading_shimmer %} option-loading{% endif %}">
                            {{- value -}}
                        </label>
                      </div>
                    </div>
                {%- endfor -%}
              </div>
            </variant-color>
          {% when 'image' %}
            <variant-image data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}">
              <div class="m-product-option--label">
                <label class="option-label">
                  <span class="option-label--title">{{ option_label }}:</span>
                  <span class="option-label--selected">{{ option.selected_value }}</span>
                </label>
                {% if is_size %}
                  <button data-open-sizeguide class="foxkit-sizechart-button m:inline-flex m:items-center m:hidden">
                    <svg class="m-svg-icon--large" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm0 224H32V160h80v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h80v192z"/></svg>
                    <span class="foxkit-sizechart-button--label">{{ 'products.product.size_guide' | t }}</span>
                  </button>
                {% endif %}
              </div>
              <div class="m-product-option--content m:inline-flex m:flex-wrap">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_variant = nil
                    for v in product.variants
                      assign variant_matches = true
                      for opt in product.options_with_values
                        if opt.position <= option.position
                          assign opi = opt.position | minus: 1
                          if opt.position < option.position
                            assign expected = opt.selected_value
                          else
                            assign expected = value
                          endif
                          if v.options[opi] != expected
                            assign variant_matches = false
                          endif
                        endif
                      endfor
                      if variant_matches
                        assign swatch_variant = v
                        break
                      endif
                    endfor
                    assign swatch_aspect = product.featured_image.aspect_ratio | default: 1
                    if swatch_variant.featured_image
                      assign swatch_aspect = swatch_variant.featured_image.aspect_ratio
                    endif
                  -%}
                  <div
                    class="m-product-option--node"
                    data-option-position="{{ option.position }}"
                    data-option-type="{{ picker_type }}"
                    data-value="{{- value | escape -}}"
                    style="--option-aspect-ratio: {{ swatch_aspect }}"
                    data-tippy-theme="m-color-{{ color_scheme }}"
                    data-tippy-content="{{- value -}}"
                  >
                    <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                      name="{{ option.name }}"
                      value="{{ value | escape }}"
                      form="{{ product_form_id }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <label
                      data-option-type="{{ picker_type }}"
                      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                      class="m-product-option--node__label{% if variant_loading_shimmer %} option-loading{% endif %}{% if swatch_variant.featured_image %} m-variant-picker__label--has-img{% endif %}"
                      {% unless swatch_variant.featured_image %}
                        style="font-size:0;"
                      {% endunless %}
                    >
                      {%- if swatch_variant.featured_image -%}
                        {{
                          swatch_variant.featured_image
                          | image_url: width: 400
                          | image_tag:
                            class: 'm-variant-picker__swatch-img',
                            loading: 'lazy',
                            alt: value,
                            widths: '100, 200, 300, 400'
                        }}
                        <span class="m:visually-hidden">{{ value }}</span>
                      {%- else -%}
                        <span class="m-variant-picker__swatch-fallback">{{ value }}</span>
                      {%- endif -%}
                    </label>
                  </div>
                {%- endfor -%}
              </div>
            </variant-image>
          {% when 'button' %}
            <variant-button data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}">
              <div class="m-product-option--label">
                <label class="option-label">
                  <span class="option-label--title">{{ option_label }}:</span>
                  <span class="option-label--selected">{{ option.selected_value }}</span>
                </label>
                {% if is_size %}
                  <button data-open-sizeguide class="foxkit-sizechart-button m:inline-flex m:items-center m:hidden">
                    <svg class="m-svg-icon--large" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm0 224H32V160h80v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h80v192z"/></svg>
                    <span class="foxkit-sizechart-button--label">{{ 'products.product.size_guide' | t }}</span>
                  </button>
                {% endif %}
              </div>
              <div class="m-product-option--content m:inline-flex m:flex-wrap">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_variant = nil
                    for v in product.variants
                      assign variant_matches = true
                      for opt in product.options_with_values
                        if opt.position <= option.position
                          assign opi = opt.position | minus: 1
                          if opt.position < option.position
                            assign expected = opt.selected_value
                          else
                            assign expected = value
                          endif
                          if v.options[opi] != expected
                            assign variant_matches = false
                          endif
                        endif
                      endfor
                      if variant_matches
                        assign swatch_variant = v
                        break
                      endif
                    endfor
                  -%}
                  <div
                    class="m-product-option--node"
                    data-option-position="{{ option.position }}"
                    data-option-type="{{ picker_type }}"
                    data-value="{{- value | escape -}}"
                  >
                    <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                        name="{{ option.name }}"
                        value="{{ value | escape }}"
                        form="{{ product_form_id }}"
                        {% if option.selected_value == value %}checked{% endif %}
                    >
                    <label
                      data-option-type="button"
                      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                      class="m-product-option--node__label{% if swatch_variant.featured_image %} m-variant-picker__label--btn-with-img{% if variant_loading_shimmer %} option-loading{% endif %}{% endif %}"
                    >
                      {%- if swatch_variant.featured_image -%}
                        <span class="m-variant-picker__btn-img-wrap">
                          {{
                            swatch_variant.featured_image
                            | image_url: width: 240
                            | image_tag:
                              class: 'm-variant-picker__swatch-img',
                              loading: 'lazy',
                              alt: value,
                              widths: '80, 120, 160, 200, 240'
                          }}
                        </span>
                      {%- endif -%}
                      <span class="m-variant-picker__btn-text">{{ value }}</span>
                    </label>
                  </div>
                {%- endfor -%}
              </div>
            </variant-button>
          {% else %}
            <variant-color data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}">
              <div class="m-product-option--label">
                <label class="option-label">
                  <span class="option-label--title">{{ option_label }}:</span>
                  <span class="option-label--selected">{{ option.selected_value }}</span>
                </label>
                {% if is_size %}
                  <button data-open-sizeguide class="foxkit-sizechart-button m:inline-flex m:items-center m:hidden">
                    <svg class="m-svg-icon--large" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M608 128H32c-17.67 0-32 14.33-32 32v192c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V160c0-17.67-14.33-32-32-32zm0 224H32V160h80v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h64v56c0 4.42 3.58 8 8 8h16c4.42 0 8-3.58 8-8v-56h80v192z"/></svg>
                    <span class="foxkit-sizechart-button--label">{{ 'products.product.size_guide' | t }}</span>
                  </button>
                {% endif %}
              </div>
              <div class="m-product-option--content m:inline-flex m:flex-wrap">
                {%- for value in option.values -%}
                  <div
                      class="m-product-option--node"
                      data-option-position="{{ option.position }}"
                      data-option-type="color"
                      data-value="{{- value | escape -}}"
                      data-tippy-theme="m-color-{{ color_scheme }}"
                      data-tippy-content="{{- value -}}"
                  >
                    <div class="m-product-option--swatch">
                      <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                        name="{{ option.name }}"
                        value="{{ value | escape }}"
                        form="{{ product_form_id }}"
                        class="vissu"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                    <label data-option-type="color" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="m-product-option--node__label">
                        {{- value -}}
                    </label>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </variant-color>
        {%- endcase -%}
      </div>
      {%- endif -%}
    {%- endfor -%}
    {%- endunless -%}
  </variant-picker>
  <script id="productVariants" type="application/json">
    {{ product.variants | json }}
  </script>
  {%- if section.settings.enable_variant_group_images -%}
    <script id="variantGroup" type="application/json">
      {{ product.metafields.foxecom-bs-kit.variant-images.value | json }}
    </script>
  {%- endif -%}
</div>
