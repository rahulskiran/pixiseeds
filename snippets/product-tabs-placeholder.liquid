{% comment %}
  product-card-placeholder with product-tabs border override.
  Accepts: card_bordered, card_border_setting, index, animated, animation_effect, color_scheme, pcard_alignment
{% endcomment %}
{% liquid
  case card_border_setting
    when 'off'
      assign _sb = false
      assign _cb = false
    when 'on'
      assign _sb = true
      assign _cb = true
    else
      assign _sb = 'inherit'
      assign _cb = card_bordered
  endcase
%}
{% if _sb == 'inherit' %}
  {% render 'product-card-placeholder', card_bordered: _cb, index: index, animated: animated, animation_effect: animation_effect, color_scheme: color_scheme, pcard_alignment: pcard_alignment %}
{% else %}
  {% render 'product-card-placeholder', card_bordered: _cb, show_border: _sb, index: index, animated: animated, animation_effect: animation_effect, color_scheme: color_scheme, pcard_alignment: pcard_alignment %}
{% endif %}
